#!/bin/sh
# shellcheck disable=SC3043
# `local` нет в строгом POSIX, но он есть во ВСЕХ оболочках, где этот
# скрипт работает: BusyBox ash (Keenetic Entware, OpenWrt) и dash.
# d2k — служба обхода DPI для Keenetic.
#
# BusyBox ash. Никаких башизмов: на роутере другого шелла нет.
#
# Два процесса, и это намеренно (§7.1 документа): падение планировщика не
# должно ронять разбор пакетов. d2kd видит пакеты, d2kc подбирает, d2kpanel
# независимо показывает состояние.
#
# Правила firewall живут в СВОИХ цепочках. Не в общих с комментарием: уборка
# по комментарию однажды промахнулась мимо правила, поставленного чуть иначе,
# и оно осталось висеть. Своя цепочка снимается целиком и без разбора.
#
# fw_up/fw_down проверены настоящим iptables (не только shellcheck'ом — тот
# в scripts/check.sh, а этот файл в его глоб *.sh не попадает: init-скрипты
# Keenetic называются без расширения): sh scripts/check_firewall.sh гоняет их
# в Linux-контейнере и сверяет вывод `iptables -S` построчно. Требует Docker,
# в обычный гейт не включён — запускать вручную при правке этого файла.

PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# ВРЕМЯ В ЖУРНАЛЕ — МЕСТНОЕ, а не UTC.
#
# Движок печатает время через localtime(), а оно на Keenetic не работает само:
# /etc/localtime — ссылка на /var/TZ, и внутри лежит ПОСИКСНАЯ СТРОКА ("MSK-3"),
# а не двоичный tzfile, которого ждёт libc. Не разобрав файл, libc молча
# отступает к UTC — и человек, читая журнал рядом с выводом `date`, видит
# расхождение в три часа и не понимает, живая служба или встала (проверено
# 13.09.2026: последняя строка 13:54 при системных 16:54).
#
# Переменная TZ ту же посиксную строку принимает напрямую. Берём её у системы,
# а не вписываем: часовой пояс задаёт владелец роутера, и знать его наперёд
# мы не можем. Своё значение, если оно уже есть в окружении, не трогаем.
if [ -z "${TZ:-}" ] && [ -r /etc/TZ ]; then
    TZ=$(cat /etc/TZ 2>/dev/null)
    [ -n "$TZ" ] && export TZ
fi

NAME=d2k
DIR=${D2K_DIR:-/opt/d2k}
RELEASE=$DIR
# Контроллер и панель — независимые процессы на C. Управление панелью
# ограничено локальной loopback-привязкой и командами из фиксированного списка.
BIN=/opt/sbin/d2kc
SHADOWBIN=/opt/sbin/d2kshadow
PANELBIN=/opt/sbin/d2kpanel
PANEL_ASSETS=$RELEASE/panel
DPBIN=/opt/sbin/d2kd
CONF=$DIR/config
RUN=$DIR/run
LOG=$DIR/log

DP_PID=$RUN/d2kd.pid
CT_PID=$RUN/d2k.pid
SH_PID=$RUN/d2kshadow.pid
PN_PID=$RUN/d2k-panel.pid
# Прежний прокси открытого HTTP (d2khttp, до задачи 51): его pid-файл и
# правила снимаются при остановке и запуске — миграция со старой версии.
HU_PID=$RUN/d2k-http.pid
HL_PID=$RUN/d2k-heal.pid
HEAL=$RELEASE/d2k-fw-heal.sh
LM_PID=$RUN/d2k-log-maintenance.pid
LOG_MAINTENANCE=$RELEASE/d2k-log-maintenance.sh
UPDATER=$RELEASE/d2k-update.sh
UPD_PID=$RUN/d2k-update.pid
SOCK=$RUN/d2kd.sock
# Вход опытов новой цепочки (ТЗ §16): только пробный план на свой порт.
# Включается строкой EXP_CONTROL=1 в config; по умолчанию выключен.
EXP_SOCK=$RUN/d2kd-exp.sock

# Собственные цепочки, по одной на направление. Не одна на оба: правило,
# лежащее в цепочке, вызываемой из двух мест, оценивается ДВАЖДЫ для одного
# пакета, и датапат видит его дважды. Здесь каждое направление ловится ровно
# в одном месте, и двойная выдача становится невозможной по построению.
#
# Где именно ловить — измерено на этапе 0, а не выбрано:
#   исходящее  POSTROUTING — видит и транзит, и собственные зонды роутера;
#   ответное   FORWARD     — в PREROUTING обратный NAT ещё не отработал и
#                            адрес клиента там не виден;
#              INPUT       — ответы собственным зондам: они идут не транзитом.
CHAIN_OUT=D2K_OUT
CHAIN_IN=D2K_IN
CHAIN_DNS_FAMILY=D2K_DNS_FAMILY
CHAIN_WCLR=D2K_WCLR
# Свои цепочки d2kd для запасного способа поздней доставки (этап 53): правила
# точного кортежа conntrack в них ставит и снимает сам d2kd, служба только
# создаёт цепочки и переход в них — после исключений, перед очередью.
CHAIN_LATE_OUT=D2K_LATE_OUT
CHAIN_LATE_IN=D2K_LATE_IN

# Значения по умолчанию; конфигурация их перекрывает.
QUEUE_NUM=2000
PANEL_LISTEN=127.0.0.1:8090
STATE_DIR=$DIR/state
MARK=0x2d
# Controller probes must traverse NFQUEUE for exact trial Plans, while raw
# packets emitted by d2kd bypass it using MARK. Keep a distinct observable
# mark so d2kd can parse verifier traffic without rediscovering its own probes.
PROBE_MARK=0x2e
# Контроллерские измерения обходят собственный NFQUEUE. Точные проверки
# кандидата используют PROBE_MARK и специально идут через datapath.
MEASURE_MARK=0x2f
# Метка прежнего прокси открытого HTTP: только чтобы снять его правила при
# обновлении. Открытый HTTP теперь идёт ядром; вставку провайдера в первые
# пакеты HTTP-потока узнаёт и заменяет d2kd (задача 51).
HTTPUP_MARK=0x30
# Fixed contract with d2k_preflight.h; separate from ordinary fake packets.
D2K_PREFLIGHT=1
PF_MARK=0x31
PF_RELEASE_MARK=0x32
PF_TOKEN_MARK=0x33
PF_CONN_BIT=0x08000000
PF_RELEASE_BIT=0x04000000
CHAIN_PFCLR=D2K_PFCLR
# Наблюдаем весь TCP/UDP трафик, а не только привычный HTTPS-порт. Протокол
# определяется разбором первых пакетов в d2kd; ограничение портом 443 теряло
# QUIC/DoT/нестандартные TLS и адресные потоки до того, как ядро могло выбрать
# собственный путь. connbytes ниже ограничивает только начальное окно каждого
# потока, а не охват портов.
PORTS=0:65535
CONNBYTES=0:8
# Opt-in until full field parity. Reserves connmark 0x40000000 and nfmark 0x20000000.
TCP_WATCH=0
# ГОЛОС ДИСКОРДА — порты боевого профиля discord_udp z2k (и эталона bol-van
# 50-discord-media для медиадиапазона 50000–50099). Узнаётся голос по первому
# пакету потока (IP Discovery), и в очередь идут только ПЕРВЫЕ пакеты: профиль
# z2k ставит фальшивку в первые четыре (--out-range=-d4), а медиапоток через
# очередь гнать нельзя вовсе — на MIPS он её захлёбывает.
VOICE_PORTS=50000:50099,1400,3478:3481,5349,19294:19344
VOICE_CONNBYTES=0:4
# ПОЗДНИЕ STUN-ЗАПРОСЫ (этап 13, 28.10.2026, opt-in): за окном VOICE_CONNBYTES
# в очередь идут только датаграммы со STUN magic cookie (0x2112A442 на 4-м
# байте нагрузки) — запросы и ответы, не медиапоток. Нужен xt_u32; без него
# правило не ставится и об этом говорится в журнале (видимость — только окно).
# По умолчанию auto (этап 33): включено, где есть xt_u32 под iptables; ядро
# отвергло правило — выключение с меткой, без шторма reapply.
VOICE_LATE=auto
# ПОЗДНЯЯ ДОСТАВКА (этап 17, 28.10.2026, opt-in): опыт на УЖЕ ИДУЩЕМ потоке.
# Пакеты потока за окном CONNBYTES в очередь не попадают, и повтор клиента под
# пробой контроллера невидим («опыта не было»). При LATE_WATCH=1 d2kd ставит
# через ctnetlink бит 0x40000000 в connmark ЗАПИСИ ТОЧНОГО потока опыта
# (--late-watch-mark) на время опыта и снимает его по снятию/сроку; правило
# ниже ставит в очередь только пакеты записей с этим битом — ни перехвата всего
# трафика, ни отключения ускорителя. Бит тот же, что у TCP_WATCH (xt_connmark,
# xt_CONNMARK уже в D2K_MODULES); нужен nf_conntrack_netlink с меткой записей
# (CONFIG_NF_CONNTRACK_MARK) — иначе d2kd скажет об этом в журнале, опыт пойдёт
# без поздней доставки. Поток, уже уведённый в аппаратный ускоритель (PPE,
# после connskip), меткой не возвращается: d2kd называет это «без пакетов».
LATE_WATCH=auto
# ПО УМОЛЧАНИЮ — auto (этап 33, 29.10.2026). Замер на Linux (lab-udp-raw.sh,
# D2K_LAB_RESIDUE=1, окно 0:8 как на роутере): без поздней доставки опыт на
# продолжении клиента для UDP без протокола подтверждается при повторах раз в
# 1000 и 500 мс и НЕ состоится при повторах раз в 200 мс — повтор под пробой
# уходит за окно очереди. auto включает её там, где она выполнима (iptables,
# MODE=apply, служебные биты свободны, есть xt_connmark), и молча выключает в
# остальных случаях — запуск не срывается; ядро отвергло правило — тоже
# выключение с меткой, без шторма reapply. Метка ставится чтением-записью
# (d2kd: mark | бит), чужие биты записи не трогаются; NDM Keenetic помечает
# свои соединения отдельным полем ndmmark (CONNNDMMARK), не connmark. 0 —
# выключить, 1 — требовать (отказ при невыполнимости, как прежде).
# ОТКРЫТЫЙ HTTP, KEEP-ALIVE (поле 04.10.2026, www.fast-torrent.ru): коробка
# смотрит КАЖДЫЙ запрос соединения, а второй запрос браузера лежит далеко за
# окном CONNBYTES. После окна наблюдаем оба направления целиком: PSH не
# обозначает все сегменты тела. Иначе завершение ответа доказать нельзя.
# d2kd применяет план на известной границе запроса; ACK не запускает подбор.
HTTP_KEEPALIVE_PORTS=80
MODE=apply
FLOWS=2048
# ВОССТАНОВЛЕНИЕ УПАВШЕГО ДЕМОНА (этап 29, 29.10.2026). d2kc выходит, как
# только рвётся связь с датапатом, а d2kd держит планы только в памяти: до
# этого этапа упавший демон не поднимал никто, и обход стоял до ручного
# запуска. Сторож (d2k-fw-heal.sh) зовёт `recover`; тот поднимает движок,
# только если его запустили штатно и штатно не останавливали (метка
# ENGINE_WANT в tmpfs), и не чаще, чем позволяет пауза: первая попытка сразу,
# дальше пауза от RECOVER_BASE_S, удваиваясь до RECOVER_MAX_S; после
# RECOVER_RESET_S спокойной работы счёт попыток обнуляется. Секунды.
RECOVER_BASE_S=30
RECOVER_MAX_S=900
RECOVER_RESET_S=600
# Период сводки датапата в журнал. Ноль выключает; без сводки нечем понять,
# видит ли служба трафик вообще.
STATS_SEC=900

# shellcheck disable=SC1090  # путь к конфигурации задан выше и постоянен
[ -r "$CONF" ] && . "$CONF"

# ПРАВИЛА — nftables НА OpenWrt, iptables НА Keenetic. В OpenWrt 25.12 пакетов
# iptables нет вовсе (07.10.2026: ни iptables-nft, ни -zz-legacy для aarch64,
# arm, mipsel, x86_64), а штатный firewall там — fw4 на nftables. Поэтому на
# OpenWrt правила ставятся своими таблицами nft, и Entware не нужен; прежняя
# установка с iptables из Entware при первом fw_up переходит на них же.
# FW_BACKEND=iptables|nft в конфигурации выбирает явно.
OPENWRT_RELEASE=${D2K_OPENWRT_RELEASE:-/etc/openwrt_release}
case "${FW_BACKEND:-auto}" in
    nft|iptables) ;;
    *)
        if [ -f "$OPENWRT_RELEASE" ] && command -v nft >/dev/null 2>&1; then
            FW_BACKEND=nft
        else
            FW_BACKEND=iptables
        fi ;;
esac
# d2kc ставит правило подавления RST сам (detect/raw.c) — тем же способом.
D2K_FW=$FW_BACKEND
export D2K_FW
# БЛОКИРОВКА XTABLES. Без -w iptables на занятой блокировке сразу отвечает
# кодом 4, как будто правила нет. Поле 15.10.2026 (Keenetic, iptables 1.4.21):
# сразу после запуска с iptables одновременно работают Telegram, разгрузка
# PPE и сторож — проверка правил падала в 18 случаях из 300, сторож принимал
# это за снесённые правила, reapply падал на том же и снимал всё, и роутер
# оставался без единого правила до следующего круга сторожа (55 с). Поэтому
# здесь каждый вызов, в каком бы виде он ни был ("$fw_tool", "$1" или
# напрямую), ждёт блокировку. Голый -w понимают iptables с 1.4.20 (detect/raw.c
# тоже зовёт его так); прошивке без него отвечает код 2, и тогда вызов
# повторяется без ключа. Кто уже передал -w сам (d2k-ppe-deoffload.sh), второго
# не получает.
xt_wait() {
    xt_tool=$1; shift
    [ "${1:-}" != -w ] || shift
    command "$xt_tool" -w "$@"
    xt_rc=$?
    if [ "$xt_rc" = 2 ]; then
        command "$xt_tool" "$@"
        xt_rc=$?
    fi
    if [ "$xt_rc" != 0 ] && [ "${FW_DIAG:-0}" = 1 ] && [ "${3:-}" = -C ]; then
        svc_log "fw-check tool=$xt_tool rc=$xt_rc $*" >/dev/null || :
        case "$*" in
            *" --mark $PF_CONN_BIT/$PF_CONN_BIT -j NFQUEUE "*)
                # Independent listing before repair. Record counts, not addresses.
                { command "$xt_tool" -w -t mangle -S "$4" 2>/dev/null; echo "list_rc=$?"; } |
                    awk -v chain="$4" '$1=="-A" && $2==chain && / -m connmark --mark 0x0*8000000\/0x0*8000000 / &&
                        / -j NFQUEUE / && !/ -m comment / { n++ }
                        /^list_rc=/ { print "preflight-list",chain,$1,"marked_queue_rules=" n+0 }' >> "$SERVICE_LOG"
                ;;
        esac
    fi
    return "$xt_rc"
}
iptables() { xt_wait iptables "$@"; }
ip6tables() { xt_wait ip6tables "$@"; }
# Frequent live snapshots are volatile. The learned catalog stays on /opt.
RUNTIME_DIR=${D2K_RUNTIME_DIR:-/tmp/d2k}
SHADOW_QUEUE=$RUNTIME_DIR/shadow.queue
LIVE=$RUNTIME_DIR/live.json
# DNS and encrypted DNS are transport infrastructure, not strategy candidates.
# Keep standard DNS/DoT/DoQ ports out of the packet classifier even when PORTS
# is 0:65535; this does not alter resolver settings or DNS routing.
DNS_PORTS=53,853
# ПРОВОДНИК УСТАНОВКИ НА VPS (relay-gate/) — канал самого D2K, а не цель.
# Через него идут установка и ночное обновление (D2K_GATE — та же настройка,
# что у установщика и d2k-update.sh). Без исключения датапат принимал туннель
# CONNECT за поток к «github.com» на адресе VPS, и контроллер начинал искать
# обход собственному каналу (поле 14.10.2026: «по github.com начинаю поиск:
# 85.192.60.175:9444»). Исключается только IPv4-адрес с портом.
GATE_IP=
GATE_PORT=
gate_hp=${D2K_GATE-http://85.192.60.175:9444}
gate_hp=${gate_hp#http://}; gate_hp=${gate_hp%%/*}
if printf '%s\n' "$gate_hp" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$'; then
    GATE_IP=${gate_hp%:*}; GATE_PORT=${gate_hp##*:}
fi
TG_ENABLED=${TG_ENABLED:-0}
TG_PORT=${TG_PORT:-1443}
TGBIN=/opt/sbin/d2ktg
TG_PID=$RUN/d2ktg.pid
TG_STATUS=${TG_STATUS:-$STATE_DIR/telegram.status}
TG_FIREWALL=$RELEASE/d2k-tg-firewall.sh
TG_WATCHDOG=$RELEASE/d2k-tg-watchdog.sh
TG_WD_PID=$RUN/d2k-tg-watchdog.pid
DNS_SCHEDULER=$RELEASE/d2k-instagram-dns-scheduler.sh
DNS_SCHED_PID=$RUN/d2k-instagram-dns-scheduler.pid
TG_STATUS=${TG_STATUS:-$STATE_DIR/telegram.status}
unset TG_RELAY_SECRET TG_RELAY_URL TG_IDENTITY TG_CA_BUNDLE
FW_LOCK=${FW_LOCK:-/tmp/d2k-fw-operation.lock}
# Один замок на все переходы движка (start/stop/restart/reapply/recover):
# сторож, панель, обновлятор и человек не должны поднимать и гасить движок
# одновременно. Отдельный от FW_LOCK: тот берётся ВНУТРИ этих переходов.
ENGINE_LOCK=${ENGINE_LOCK:-/tmp/d2k-engine.lock}
# Намерение «движок должен работать» — в tmpfs: переживает падение демона,
# но не перезагрузку и не штатную остановку. Ставит его только успешный
# start_engine, снимают stop и engine-stop.
ENGINE_WANT=$RUNTIME_DIR/engine.want
RECOVER_STATE=$RUNTIME_DIR/recover.state
SERVICE_LOG=$LOG/service.log
ENGINE_ACTION=${1:-unknown}
if [ "$ENGINE_ACTION" = reapply ] && [ "${2:-}" = auto ]; then
    case "${D2K_HEAL_SOURCE:-}" in
        watchdog|ndm) ENGINE_ACTION=reapply-auto-$D2K_HEAL_SOURCE ;;
        *) ENGINE_ACTION=reapply-auto ;;
    esac
fi
FW_DIAG=0
# Метка «IPv6 не обслуживается»: ip6tables mangle на этой прошивке нет
# (без компонента IPv6 или без ip6table_mangle). fw_installed тогда не ждёт
# IPv6-правил, а fw_down метку снимает.
FW_V4ONLY=$RUN/fw-ipv4-only
FW_V6_REBUILDING=$RUN/fw-ipv6-rebuilding
PROC_DIR=/proc

# Разгрузка окна рукопожатия от аппаратного ускорителя Keenetic (-j PPE с
# connskip): без неё поток уходит мимо netfilter, и d2k не видит ответов.
# Правила и их уборка — в d2k-ppe-deoffload.sh, здесь только вызовы. Нет
# файла — нет разгрузки, остальная служба работает как прежде.
# D2K_PPE_DEOFFLOAD=0 в конфигурации выключает её.
PPE_LIB=$RELEASE/d2k-ppe-deoffload.sh
# shellcheck disable=SC2034  # читает d2k-ppe-deoffload.sh
D2K_PPE_DPLOG=$LOG/d2kd.log
# shellcheck disable=SC2034
D2K_PPE_CONFIG=$CONF
# shellcheck disable=SC1090
[ -r "$PPE_LIB" ] && . "$PPE_LIB"

# Остаток прежней версии: живой d2khttp или его nat-перехват порта 80.
# Процесс узнаётся по имени, а не по одному pid: старый pid-файл мог
# пережить перезагрузку, и его номер уже у чужого процесса (ревью M3).
legacy_http_pid() {
    [ -f "$HU_PID" ] || return 1
    lpid=$(cat "$HU_PID" 2>/dev/null)
    case "$lpid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$(cat "$PROC_DIR/$lpid/comm" 2>/dev/null)" = d2khttp ] || return 1
    echo "$lpid"
}
legacy_http_present() {
    legacy_http_pid >/dev/null && return 0
    iptables -t nat -C PREROUTING -j D2K_HTTP 2>/dev/null && return 0
    return 1
}

# Wait budgets below are in tenths of a second. Entware's BusyBox may
# accept only whole seconds; account for those seconds without retrying
# the unsupported fractional argument on every poll.
D2K_WAIT_TICKS=1
wait_tenth() {
    if [ "$D2K_WAIT_TICKS" -eq 1 ]; then
        sleep 0.1 2>/dev/null && return 0
        D2K_WAIT_TICKS=10
    fi
    sleep 1
}

legacy_http_stop() {
    if lpid=$(legacy_http_pid); then
        kill "$lpid" 2>/dev/null
        i=0
        while [ -d "$PROC_DIR/$lpid" ] && kill -0 "$lpid" 2>/dev/null && [ $i -lt 30 ]; do
            wait_tenth
            i=$((i + D2K_WAIT_TICKS))
        done
        kill -0 "$lpid" 2>/dev/null && kill -9 "$lpid" 2>/dev/null
    fi
    rm -f "$HU_PID"
}

say() { echo "$NAME: $*"; }
die() { echo "$NAME: $*" >&2; exit 1; }

# ПРИЧИНА ОТКАЗА — ИЗ ЖУРНАЛА ТОГО, КТО УПАЛ.
#
# Служба говорила «контроллер завершился сразу после запуска» и молчала о
# том, почему. Причина при этом записана: контроллер пишет её своим последним
# действием. Поле 13.10.2026 (установка пользователя на OpenWrt mipsel):
# пришлось воспроизводить запуск под QEMU, чтобы узнать строку, которая у
# человека лежала в файле. Теперь последние строки журнала печатаются рядом с
# отказом — ни одного лишнего запроса к человеку.
die_with_log() {
    _msg=$1; _log=$2
    if [ -s "$_log" ]; then
        echo "$NAME: $_msg" >&2
        echo "$NAME: последние строки $_log:" >&2
        tail -n 8 "$_log" 2>/dev/null | sed "s/^/$NAME:   /" >&2
        exit 1
    fi
    die "$_msg (журнал $_log пуст)"
}

running() {
    # Жив ли процесс, чей pid записан. Не «есть файл», а именно жив: файл
    # переживает SIGKILL, процесс — нет.
    [ -f "$1" ] || return 1
    pid=$(cat "$1" 2>/dev/null)
    [ -n "$pid" ] || return 1
    [ -d "$PROC_DIR/$pid" ] || return 1
    # Зомби мёртв. Демонов, запущенных обновлятором, усыновляет его
    # супервизор; пока он не собрал завершившегося потомка, тот висит зомби,
    # и остановка ждала бы его, добивала KILL и объявляла себя сорванной.
    [ "$(sed -n 's/^.*) \([A-Za-z]\).*/\1/p' "$PROC_DIR/$pid/stat" 2>/dev/null)" != Z ] || return 1
    pid_is_ours "$1" "$pid"
}

# ЧЕЙ НОМЕР В PID-ФАЙЛЕ. Файл переживает падение процесса, а номер за это
# время может достаться чужому: тогда «работает» было бы ложью, восстановление
# не началось бы, а остановка убила бы чужой процесс. Для процессов движка
# номер принимается, только если процесс тот самый: у d2kd и d2kc — имя в
# ядре (comm задаётся именем исполняемого файла, а не argv[0], и не зависит
# от сборки start-stop-daemon), у цикла сторожа (comm — sh) — путь сторожа в
# его командной строке. Остальные pid-файлы — как прежде.
pid_is_ours() {
    case "$1" in
        "$DP_PID") _comm=d2kd; _exe=$DPBIN ;;
        "$CT_PID") _comm=d2kc; _exe=$BIN ;;
        "${SH_PID:-}") _comm=d2kshadow; _exe=$SHADOWBIN ;;
        "$HL_PID")
            tr '\0' '\n' < "$PROC_DIR/$2/cmdline" 2>/dev/null | grep -qF -- "$HEAL" || return 1
            [ ! -r "$1.start" ] || [ "$(cat "$1.start" 2>/dev/null)" = "$(pid_start "$2")" ]
            return ;;
        *) return 0 ;;
    esac
    [ "$(cat "$PROC_DIR/$2/comm" 2>/dev/null)" = "$_comm" ] || return 1
    # Имя совпадает и у чужого процесса с тем же именем, получившего номер
    # упавшего. Экземпляр различает время старта в ядре (поле 22 stat): его
    # записывает pid_stamp сразу после запуска.
    if [ -r "$1.start" ]; then
        [ "$(cat "$1.start" 2>/dev/null)" = "$(pid_start "$2")" ]
        return
    fi
    # Отметки нет — процесс поднят прежней версией службы (миграция), и
    # pid-файл мог давно устареть. Тогда экземпляр подтверждают настоящий
    # исполняемый файл (не argv[0]; «(deleted)» — файл заменён обновлением) и
    # точный управляющий сокет этой службы в аргументах.
    case "$(readlink "$PROC_DIR/$2/exe" 2>/dev/null)" in
        "$_exe"|"$_exe (deleted)") ;;
        *) return 1 ;;
    esac
    if [ "$1" = "${SH_PID:-}" ]; then
        tr '\0' '\n' < "$PROC_DIR/$2/cmdline" 2>/dev/null |
            awk -v s="$SHADOW_QUEUE" 'p && $0 == s { f = 1 } { p = ($0 == "--queue") } END { exit !f }'
        return
    fi
    tr '\0' '\n' < "$PROC_DIR/$2/cmdline" 2>/dev/null |
        awk -v s="$SOCK" 'p && $0 == s { f = 1 } { p = ($0 == "--control") } END { exit !f }'
}

# Время старта процесса в тактах с загрузки (поле 22 /proc/PID/stat). Имя
# процесса может содержать пробелы и скобки — отсчёт после последней «) ».
pid_start() {
    sed -n 's/^.*) //p' "$PROC_DIR/$1/stat" 2>/dev/null | cut -d' ' -f20
}

# Отметка экземпляра рядом с pid-файлом: номер и время старта вместе.
pid_stamp() {
    _sp=$(cat "$1" 2>/dev/null)
    case "$_sp" in ''|*[!0-9]*) rm -f "$1.start"; return 1 ;; esac
    _st=$(pid_start "$_sp")
    [ -n "$_st" ] || { rm -f "$1.start"; return 1; }
    printf '%s\n' "$_st" > "$1.start"
}

# НОМЕР ЖИВОГО ПРОЦЕССА ПО ИМЕНИ. Тот же приём, что у legacy_http_pid ниже:
# имя надёжнее номера, переживающего перезагрузку.
pid_by_comm() {
    for _d in "$PROC_DIR"/[0-9]*; do
        [ -r "$_d/comm" ] || continue
        [ "$(cat "$_d/comm" 2>/dev/null)" = "$1" ] || continue
        echo "${_d##*/}"
        return 0
    done
    return 1
}

# ЖИВОСТЬ СРАЗУ ПОСЛЕ ЗАПУСКА — НЕ ОДНИМ ВЗГЛЯДОМ В PID-ФАЙЛ.
#
# Поле 13.10.2026, установка пользователя на OpenWrt 25.12 (mipsel): служба
# сказала «контроллер завершился сразу после запуска», а его собственный
# журнал говорит обратное — «запущен, сокет …», и следом «останавливаюсь»,
# то есть его остановили МЫ. Проверялся один-единственный раз pid-файл, и
# писал его start-stop-daemon чужой сборки: на этой прошивке к моменту
# проверки в нём не было живого номера. Из всех наших служб так проверяется
# только контроллер — поэтому и падал только он, а панель на том же роутере
# поднялась.
#
# Ждём события, а не спим наугад: до трёх секунд короткими шагами. Если
# pid-файл так и не отражает живой процесс, а процесс есть — усыновляем его
# по имени и говорим об этом вслух. Выдумывать тут нечего: имя наше, и в
# системе он один.
wait_running() {
    _pidf=$1; _name=$2; _i=0
    while :; do
        running "$_pidf" && return 0
        [ "$_i" -lt 30 ] || break
        wait_tenth
        _i=$((_i + D2K_WAIT_TICKS))
    done
    _p=$(pid_by_comm "$_name") || return 1
    [ -n "$_p" ] || return 1
    echo "$_p" > "$_pidf" 2>/dev/null || return 1
    say "pid-файл $_pidf не отражал живой $_name — записал номер $_p"
    return 0
}

# --- firewall ------------------------------------------------------------
#
# Своя цепочка в mangle, и переходы в неё из четырёх мест. Транзитный трафик
# идёт через POSTROUTING и FORWARD, собственные зонды — через OUTPUT и INPUT:
# зонд идёт С САМОГО роутера, и транзитные цепочки его не видят.

late_rst_from() {
    local late_rst_upper
    case "$CONNBYTES" in
        0:*) ;;
        *) return 1 ;;
    esac
    late_rst_upper=${CONNBYTES#0:}
    case "$late_rst_upper" in ''|*[!0-9]*) return 1 ;; esac
    [ "$late_rst_upper" -le 65535 ] || return 1
    echo $((late_rst_upper + 1))
}

# xt_addrtype есть не во всех прошивках (поле 03.10.2026: Keenetic mipsel
# 3.4_kn — «iptables: No chain/target/match by that name», служба не
# запускалась). Где модуля нет, те же исключения ставятся явными адресами.
# $1 — утилита, $2 — таблица, $3 — цепочка; печатает, каким способом встало.
fw_return_broadcast() {
    if "$1" -t "$2" -A "$3" -m addrtype --dst-type BROADCAST -j RETURN 2>/dev/null; then
        return 0
    fi
    say "в прошивке нет xt_addrtype: широковещательные адреса исключаю явным списком"
    "$1" -t "$2" -A "$3" -d 255.255.255.255 -j RETURN || return 1
    for b in $(ip -4 addr show 2>/dev/null | awk '$1 == "inet" { for (i = 1; i < NF; i++) if ($i == "brd") print $(i + 1) }' | sort -u); do
        "$1" -t "$2" -A "$3" -d "$b" -j RETURN || return 1
    done
}
fw_return_local() {
    if "$1" -t "$2" -A "$3" -m addrtype --dst-type LOCAL -j RETURN 2>/dev/null; then
        return 0
    fi
    say "в прошивке нет xt_addrtype: собственные адреса роутера исключаю явным списком"
    for a in $(ip -4 addr show 2>/dev/null | awk '$1 == "inet" { sub(/\/.*/, "", $2); print $2 }' | sort -u); do
        "$1" -t "$2" -A "$3" -d "$a" -j RETURN || return 1
    done
}

# ICMP «ВРЕМЯ ЖИЗНИ ИСТЕКЛО» (IPv4 11/0, ICMPv6 3/0) — к клиенту (FORWARD) и
# к роутеру (INPUT). Фальшивка плана с пониженным TTL умирает на узле по пути,
# узел отвечает time-exceeded, а NAT отдаёт его клиенту по кортежу его же
# потока. Поле 04.10.2026 (KN-1811, icmp-rua.pcap): Safari по такому ICMP
# закрывал UDP-сокет QUIC, страница не открывалась. d2kd снимает ТОЛЬКО ответ
# на собственную фальшивку (цитата — ровно её кортеж, длина, ID/номер),
# остальное (traceroute, чужие потоки) — ACCEPT. PMTU (frag needed, packet
# too big) и прочие ICMP в очередь не попадают вовсе. --queue-bypass: без
# d2kd ICMP идёт как без d2k. $1 — утилита, $2 — -A или -C.
fw_icmp_te_rule() {
    if [ "$1" = iptables ]; then
        "$1" -t mangle "$2" "$CHAIN_IN" -p icmp --icmp-type 11/0 \
            -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass
    else
        "$1" -t mangle "$2" "$CHAIN_IN" -p ipv6-icmp --icmpv6-type 3/0 \
            -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass
    fi
}

# auto → 0/1 по выполнимости (этап 33). Явные 0/1 не трогаются. Идемпотентно:
# повторный вызов после разрешения ничего не меняет.
LATE_WATCH_WHY=
watch_auto_resolve() {
    if [ "${LATE_WATCH:-0}" = auto ]; then
        LATE_WATCH=0
        if [ "$FW_BACKEND" != iptables ]; then
            LATE_WATCH_WHY="правила поздней доставки есть только для iptables"
        elif [ "$MODE" != apply ]; then
            LATE_WATCH_WHY="режим $MODE"
        elif [ "$(( (MARK | PROBE_MARK | MEASURE_MARK | HTTPUP_MARK) & 0x60000000 ))" != 0 ]; then
            LATE_WATCH_WHY="служебные биты 0x60000000 заняты метками службы"
        elif ! iptables -m connmark --help >/dev/null 2>&1; then
            LATE_WATCH_WHY="нет расширения xt_connmark"
        else
            LATE_WATCH=1
            LATE_WATCH_AUTO=1
        fi
        if [ "$LATE_WATCH" = 1 ] && [ -n "${KEENETIC_POLICY:-}" ]; then
            wp=$(policy_mark "$KEENETIC_POLICY")
            case "$wp" in
                ''|*[!0-9a-fA-F]*) LATE_WATCH=0; LATE_WATCH_WHY="метка политики Keenetic не найдена" ;;
                *) [ "$((0x$wp & 0x60000000))" = 0 ] || { LATE_WATCH=0; LATE_WATCH_WHY="метка политики использует служебные биты"; } ;;
            esac
        fi
    fi
    if [ "${VOICE_LATE:-0}" = auto ]; then
        VOICE_LATE=0
        [ "$FW_BACKEND" = iptables ] && VOICE_LATE=1
    fi
    return 0
}

watch_validate() {
    watch_auto_resolve
    case "${LATE_WATCH:-0}" in 0|1) ;; *) say "LATE_WATCH должен быть 0, 1 или auto"; return 1 ;; esac
    case "${TCP_WATCH:-0}" in 0) [ "${LATE_WATCH:-0}" = 1 ] || return 0 ;; 1) ;; *) say "TCP_WATCH должен быть 0 или 1"; return 1 ;; esac
    # Оба наблюдения делят служебные биты 0x60000000 (connmark 0x40000000,
    # nfmark 0x20000000): проверка меток общая.
    [ "$FW_BACKEND" = iptables ] && [ "$MODE" = apply ] || {
        say "TCP_WATCH/LATE_WATCH пока требуют iptables и MODE=apply"; return 1;
    }
    for wm in "$MARK" "$PROBE_MARK" "$MEASURE_MARK" "$HTTPUP_MARK"; do
        [ "$((wm & 0x60000000))" = 0 ] || {
            say "TCP_WATCH/LATE_WATCH: служебные биты пересекаются с меткой $wm"; return 1;
        }
    done
    if [ -n "${KEENETIC_POLICY:-}" ]; then
        wp=$(policy_mark "$KEENETIC_POLICY")
        if [ -z "$wp" ] && [ -f "$OPENWRT_RELEASE" ]; then
            TCP_WATCH=0; LATE_WATCH=0
            return 0
        fi
        case "$wp" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
        [ "$((0x$wp & 0x60000000))" = 0 ] || {
            say "TCP_WATCH: метка политики использует служебные биты"; return 1;
        }
    fi
}

# The daemon and rules are a single contract. A change requires a restart.
watch_contract_matches() {
    wa=0
    [ ! -f "$RUN/tcp-watch-active" ] || wa=1
    [ "${TCP_WATCH:-0}" = "$wa" ]
}

# Used for both installation and completeness checking; never broaden DNS,
# loopback, policy or own-raw-packet exclusions that precede these rules.
watch_rules() {
    wt=$1; op=$2
    [ "${TCP_WATCH:-0}" = 1 ] || return 0
    "$wt" -t mangle "$op" "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL \
        -m multiport --dports "$PORTS" --tcp-flags SYN,ACK SYN \
        -j CONNMARK --set-xmark 0x40000000/0x40000000 || return 1
    "$wt" -t mangle "$op" "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL \
        -m multiport --dports "$PORTS" -m connmark --mark 0x40000000/0x40000000 \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$wt" -t mangle "$op" "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY \
        -m multiport --sports "$PORTS" -m connmark --mark 0x40000000/0x40000000 \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
}

# Поздние STUN-транзакции долгого голосового потока (этап 13): запрос и ответ
# по magic cookie, с пакета за окном VOICE_CONNBYTES. Медиа в очередь не идёт.
# Без xt_u32 (iptables -m u32 --help) правила не ставятся — видимость остаётся
# окном, и это называется в журнале один раз на подъём правил.
voice_late_rules() {
    wt=$1; op=$2
    [ "${VOICE_LATE:-0}" = 1 ] || return 0
    # Ядро уже отвергло правило при постановке — проверка полноты его не ждёт.
    [ "$op" != -C ] || [ ! -f "$RUN/voice-late-off.$wt" ] || return 0
    if ! "$wt" -m u32 --help >/dev/null 2>&1; then
        [ "$op" != -A ] || say "VOICE_LATE: модуля xt_u32 нет — поздние STUN-запросы в очередь не идут, видимость только окно $VOICE_CONNBYTES"
        return 0
    fi
    # IPv6 has no IPv4 IHL. The fixed offset is valid only with UDP directly
    # after the base header; extension-header traffic stays on the normal path.
    late_cookie='0>>22&0x3C@12=0x2112A442'
    case "$wt" in *ip6tables*) late_cookie='4>>8&0xFF=17&&52=0x2112A442' ;; esac
    late_from=$(( ${VOICE_CONNBYTES#0:} + 1 ))
    "$wt" -t mangle "$op" "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL -m multiport --dports "$VOICE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        -m u32 --u32 "$late_cookie" \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || {
            [ "$op" = -A ] || return 1
            say "VOICE_LATE: ядро не приняло правило xt_u32 — видимость только окно $VOICE_CONNBYTES"
            { mkdir -p "$RUN" && : > "$RUN/voice-late-off.$wt"; } 2>/dev/null
            return 0
        }
    "$wt" -t mangle "$op" "$CHAIN_IN" -p udp -m conntrack --ctdir REPLY -m multiport --sports "$VOICE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        -m u32 --u32 "$late_cookie" \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || {
            [ "$op" = -A ] || return 1
            # Do not leave only one direction active after optional setup fails.
            "$wt" -t mangle -D "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL -m multiport --dports "$VOICE_PORTS" \
                -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
                -m u32 --u32 "$late_cookie" \
                -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
            say "VOICE_LATE: ядро не приняло обратное правило xt_u32 — видимость только окно $VOICE_CONNBYTES"
            { mkdir -p "$RUN" && : > "$RUN/voice-late-off.$wt"; } 2>/dev/null
            return 0
        }
}

# Поздняя доставка (этап 17): пакеты записей с битом 0x40000000 — в очередь,
# TCP и UDP, обе стороны. При TCP_WATCH=1 TCP-правила уже стоят (watch_rules),
# ставятся только UDP. Перед connbytes-правилами: те пакеты за окном не видят.
late_watch_rules() {
    wt=$1; op=$2
    [ "${LATE_WATCH:-0}" = 1 ] || return 0
    [ "$op" != -C ] || [ ! -f "$RUN/late-watch-off.$wt" ] || return 0
    if late_watch_rules_do "$wt" "$op"; then return 0; fi
    # Явное LATE_WATCH=1 — договор: отказ громкий, как прежде. auto — выключение
    # без срыва запуска: частично поставленное снимается, метка говорит
    # проверке полноты не ждать этих правил.
    [ "$op" = -A ] && [ "${LATE_WATCH_AUTO:-0}" = 1 ] || return 1
    late_watch_rules_do "$wt" -D >/dev/null 2>&1
    { mkdir -p "$RUN" && : > "$RUN/late-watch-off.$wt"; } 2>/dev/null
    say "LATE_WATCH=auto: ядро не приняло правило поздней доставки ($wt) — опыт на продолжении клиента только в окне очереди"
    return 0
}

late_watch_rules_do() {
    wt=$1; op=$2
    if [ "${TCP_WATCH:-0}" != 1 ]; then
        "$wt" -t mangle "$op" "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL \
            -m multiport --dports "$PORTS" -m connmark --mark 0x40000000/0x40000000 \
            -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
        "$wt" -t mangle "$op" "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY \
            -m multiport --sports "$PORTS" -m connmark --mark 0x40000000/0x40000000 \
            -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    fi
    "$wt" -t mangle "$op" "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL \
        -m connmark --mark 0x40000000/0x40000000 \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$wt" -t mangle "$op" "$CHAIN_IN" -p udp -m conntrack --ctdir REPLY \
        -m connmark --mark 0x40000000/0x40000000 \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Ядро без маски метки (4.9): d2kd кладёт правила точного кортежа в свои
    # цепочки; переход — здесь же, после исключений и RETURN меток службы.
    "$wt" -t mangle "$op" "$CHAIN_OUT" -j "$CHAIN_LATE_OUT" || return 1
    "$wt" -t mangle "$op" "$CHAIN_IN" -j "$CHAIN_LATE_IN" || return 1
}

watch_release_rules() {
    wt=$1; op=$2
    [ "${TCP_WATCH:-0}" = 1 ] || return 0
    "$wt" -t mangle "$op" "$CHAIN_WCLR" -j CONNMARK --set-xmark 0/0x40000000 || return 1
    "$wt" -t mangle "$op" "$CHAIN_WCLR" -j MARK --set-xmark 0/0x20000000 || return 1
    "$wt" -t mangle "$op" "$CHAIN_WCLR" -j ACCEPT || return 1
    for wc in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$wt" -t mangle "$op" "$wc" -m mark --mark 0x20000000/0x20000000 -j "$CHAIN_WCLR" || return 1
    done
}

# The probe and released SYN enter POSTROUTING with the same original tuple
# and packet mark, including on the native NETMAP path. Forced port changes
# can break that handover, and unreadable rules stay unsupported.
preflight_ipv6_available() (
    [ "${D2K_PREFLIGHT:-0}" = 1 ] || exit 1
    [ -r "$PROC_DIR/net/if_inet6" ] || exit 1
    if [ "$FW_BACKEND" = iptables ]; then
        ip6tables -t mangle -S POSTROUTING >/dev/null 2>&1 || exit 1
    fi
    if command -v ip6tables >/dev/null 2>&1; then
        if rules=$(ip6tables -t nat -S 2>/dev/null); then
            printf '%s\n' "$rules" | awk '
                $1 == "-A" {
                    for (i=2; i<NF; i++) {
                        if ($i != "-j" || $(i+1) !~ /^(SNAT|MASQUERADE)$/) continue
                        for (j=i+2; j<=NF; j++) {
                            if ($j ~ /^(--to-ports|--random|--random-fully)$/ ||
                                ($j == "--to-source" && $(j+1) ~ /^\[[^]]+\]:/))
                                unsupported = 1
                        }
                    }
                }
                END { exit unsupported ? 1 : 0 }
            ' || exit 1
        else
            [ -r "$PROC_DIR/net/ip6_tables_names" ] || exit 1
            ! grep -qx nat "$PROC_DIR/net/ip6_tables_names" || exit 1
        fi
    elif [ -r "$PROC_DIR/net/ip6_tables_names" ]; then
        ! grep -qx nat "$PROC_DIR/net/ip6_tables_names" || exit 1
    fi
    if command -v nft >/dev/null 2>&1; then
        rules=$(nft list ruleset 2>/dev/null) || exit 1
        printf '%s\n' "$rules" | awk -v own="$NFT_TABLE" '
            $1 == "table" { v6 = $2 == "ip6" || ($2 == "inet" && $3 != own); family = $2 }
            v6 && /(^|[[:space:]])(snat|masquerade)([[:space:]]|$)/ &&
                /(^|[[:space:],])(prefix|random|fully-random)([[:space:],;}]|$)|\]:[0-9]|[[:space:]]:[0-9]/ {
                if (family == "ip6" || $0 !~ /(^|[[:space:]])meta nfproto ipv4([[:space:]]|$)/) unsupported = 1
            }
            END { exit unsupported ? 1 : 0 }
        ' || exit 1
    elif [ "$FW_BACKEND" = nft ] || [ -d /sys/module/nf_tables ]; then
        exit 1
    fi
    exit 0
)
preflight_family() {
    [ "${D2K_PREFLIGHT:-0}" = 1 ] || return 1
    [ "$1" = iptables ] || { [ "$1" = ip6tables ] && [ "${D2K_PREFLIGHT_V6:-0}" = 1 ]; }
}

# Raw release SYN/control token first enters the queue, then NF_REPEAT clears
# only our connmark bit. Tokens are consumed; a released SYN keeps its NAT mark.
preflight_control_rules() {
    local wt op pc tag repeat_release repeat_token
    wt=$1; op=$2
    preflight_family "$wt" || return 0
    repeat_release=$(printf '0x%x' "$((PF_RELEASE_BIT | PF_RELEASE_MARK))")
    repeat_token=$(printf '0x%x' "$((PF_RELEASE_BIT | PF_TOKEN_MARK))")
    "$wt" -t mangle "$op" "$CHAIN_PFCLR" -j CONNMARK --set-xmark "0/$PF_CONN_BIT" || return 1
    "$wt" -t mangle "$op" "$CHAIN_PFCLR" -m mark --mark "$repeat_token" -j DROP || return 1
    "$wt" -t mangle "$op" "$CHAIN_PFCLR" -j MARK --set-xmark "$PF_MARK/0xffffffff" || return 1
    "$wt" -t mangle "$op" "$CHAIN_PFCLR" -j ACCEPT || return 1
    for pc in "$CHAIN_OUT" "$CHAIN_IN"; do
        for tag in "$repeat_release" "$repeat_token"; do
            "$wt" -t mangle "$op" "$pc" -m mark --mark "$tag" -j "$CHAIN_PFCLR" || return 1
        done
    done
    for pc in "$PF_RELEASE_MARK" "$PF_TOKEN_MARK"; do
        "$wt" -t mangle "$op" "$CHAIN_OUT" -p tcp -m mark --mark "$pc" -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    done
    "$wt" -t mangle "$op" "$CHAIN_OUT" -p tcp -m mark --mark "$PF_MARK" -j CONNMARK --set-xmark "$PF_CONN_BIT/$PF_CONN_BIT" || return 1
    "$wt" -t mangle "$op" "$CHAIN_OUT" -m mark --mark "$PF_MARK" -j RETURN || return 1
}
preflight_queue_rules() {
    local wt op
    wt=$1; op=$2
    preflight_family "$wt" || return 0
    # A narrowly scoped live repair checks every other rule before restoring
    # these two. The flag exists only in that repair's subshell.
    [ "$op" != -C ] || [ "${D2K_SKIP_PREFLIGHT_QUEUE_CHECK:-0}" != 1 ] || return 0
    "$wt" -t mangle "$op" "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m connmark --mark "$PF_CONN_BIT/$PF_CONN_BIT" -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$wt" -t mangle "$op" "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m connmark --mark "$PF_CONN_BIT/$PF_CONN_BIT" -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
}
preflight_nat_rule() {
    [ "${D2K_PREFLIGHT:-0}" = 1 ] && [ "$1" = iptables ] || return 0
    "$1" -t nat "$2" POSTROUTING -p tcp -m mark --mark "$PF_MARK" -j MASQUERADE
}
preflight_validate() {
    [ "${D2K_PREFLIGHT:-0}" = 1 ] || return 0
    local pm
    [ "$((PF_MARK))" = 49 ] && [ "$((PF_RELEASE_MARK))" = 50 ] &&
        [ "$((PF_TOKEN_MARK))" = 51 ] && [ "$((PF_CONN_BIT))" = 134217728 ] &&
        [ "$((PF_RELEASE_BIT))" = 67108864 ] || {
            say "preflight: метки должны совпадать с контрактом датапата"; return 1;
        }
    for pm in "$MARK" "$PROBE_MARK" "$MEASURE_MARK" "$HTTPUP_MARK"; do
        [ "$((pm))" -ne "$((PF_MARK))" ] && [ "$((pm))" -ne "$((PF_RELEASE_MARK))" ] && [ "$((pm))" -ne "$((PF_TOKEN_MARK))" ] &&
            [ "$((pm & (PF_CONN_BIT | PF_RELEASE_BIT)))" = 0 ] || {
                say "preflight: конфликт служебных меток"; return 1;
            }
    done
    if [ -n "${KEENETIC_POLICY:-}" ]; then
        pm=$(policy_mark "$KEENETIC_POLICY")
        if [ -z "$pm" ] && [ -f "$OPENWRT_RELEASE" ]; then
            D2K_PREFLIGHT=0
            return 0 # missing selector: policy_args restricts all client traffic
        fi
        case "$pm" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
        pm=$((0x$pm))
        if [ "$((pm & PF_CONN_BIT))" != 0 ] || [ "$pm" = "$((PF_MARK))" ] ||
            [ "$pm" = "$((PF_RELEASE_MARK))" ] || [ "$pm" = "$((PF_TOKEN_MARK))" ] ||
            [ "$pm" = "$((PF_RELEASE_BIT | PF_RELEASE_MARK))" ] ||
            [ "$pm" = "$((PF_RELEASE_BIT | PF_TOKEN_MARK))" ]; then
            D2K_PREFLIGHT=0
            preflight_policy_conflict=1
        fi
    fi
}

fw_family_up() (
    fw_tool=$1
    loopback=127.0.0.0/8
    [ "$fw_tool" != ip6tables ] || loopback=::1/128
    local late_from
    late_from=$(late_rst_from) || return 1

    # Код 3 — таблица mangle этого семейства непригодна вовсе (нет утилиты,
    # нет таблицы): для IPv6 это не отказ, а работа только по IPv4.
    command -v "$fw_tool" >/dev/null 2>&1 || return 3
    # Отказ создать цепочку при живой таблице (её список читается, -w ждёт
    # замок xtables) — обычная ошибка, а не отсутствие семейства.
    if ! "$fw_tool" -t mangle -N "$CHAIN_OUT" 2>/dev/null; then
        "$fw_tool" -w -t mangle -n -L POSTROUTING >/dev/null 2>&1 && return 1
        return 3
    fi
    "$fw_tool" -t mangle -N "$CHAIN_IN"  2>/dev/null || return 1
    "$fw_tool" -t mangle -N "$CHAIN_DNS_FAMILY" 2>/dev/null || return 1
    if [ "${LATE_WATCH:-0}" = 1 ]; then
        # d2kd мог создать их сам (уборка на старте) — уже есть, ладно.
        "$fw_tool" -t mangle -N "$CHAIN_LATE_OUT" 2>/dev/null || "$fw_tool" -t mangle -n -L "$CHAIN_LATE_OUT" >/dev/null 2>&1 || return 1
        "$fw_tool" -t mangle -N "$CHAIN_LATE_IN" 2>/dev/null || "$fw_tool" -t mangle -n -L "$CHAIN_LATE_IN" >/dev/null 2>&1 || return 1
    fi
    if [ "${TCP_WATCH:-0}" = 1 ]; then
        "$fw_tool" -t mangle -N "$CHAIN_WCLR" || return 1
        watch_release_rules "$fw_tool" -A || return 1
    fi

    # ПРОБРОС ПОРТОВ — НЕ НАШ ТРАФИК (issue #23, Keenetic + NAS). Соединение,
    # которое открыл узел С WAN на проброшенный порт, для conntrack идёт в
    # направлении ORIGINAL и проходит POSTROUTING. Правило очереди ниже
    # («--ctdir ORIGINAL», все порты) брало его как исходящее из LAN, а ответы
    # NAS — как ответы сервера, и проброс переставал работать. После
    # engine-stop работал. У такого соединения есть признак DNAT, и он стоит в
    # ОБОИХ направлениях. Под него же попадают сопоставления UPnP (входящие
    # пиры торрент-клиента). Исходящий трафик LAN признака DNAT не несёт: его
    # NAT — SNAT. Перехват Telegram (REDIRECT на d2ktg) уходит в INPUT, и
    # правила очереди его не брали и раньше. --ctstate DNAT есть в
    # iptables 1.4.21 (в отличие от --ctstatus DNAT, который issue пробовал).
    for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$fw_tool" -t mangle -A "$chain" -m conntrack --ctstate DNAT -j RETURN || return 1
    done
    # Канал самого D2K — проводник установки на VPS (GATE_IP выше).
    if [ -n "$GATE_IP" ] && [ "$fw_tool" = iptables ]; then
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -d "$GATE_IP" --dport "$GATE_PORT" -j RETURN || return 1
        "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -s "$GATE_IP" --sport "$GATE_PORT" -j RETURN || return 1
    fi


    if preflight_family "$fw_tool"; then
        "$fw_tool" -t mangle -N "$CHAIN_PFCLR" || return 1
        preflight_control_rules "$fw_tool" -A || return 1
    fi

    # Keenetic's DNS proxy talks to local encrypted-DNS helpers on dynamic
    # loopback ports. That IPC is not internet traffic and must not be queued.
    for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$fw_tool" -t mangle -A "$chain" -s $loopback -j RETURN || return 1
        "$fw_tool" -t mangle -A "$chain" -d $loopback -j RETURN || return 1
    done

    # Broadcast and multicast never enter the queue: there is no NAT clash to
    # cure and no plan for them, and a raw re-send to a broadcast address is
    # refused (EACCES; field 03.10.2026, router-local 192.168.1.255:3517/3518
    # and the like). The router's own unicast UDP stays queued: the Telegram
    # tunnel and controller probes may need d2k. Before every NFQUEUE jump.
    if [ "$fw_tool" = iptables ]; then
        fw_return_broadcast "$fw_tool" mangle "$CHAIN_OUT" || return 1
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -d 224.0.0.0/4 -j RETURN || return 1
    else
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -d ff00::/8 -j RETURN || return 1
    fi

    # Собственные сырые посылки датапата и измерительные запросы контроллера
    # исключаются. Активные verifier-зонды
    # контроллера помечаются отдельным PROBE_MARK: им нужно попасть в очередь,
    # чтобы точный trial Plan достался verifier; d2kd разбирает их, но не
    # порождает из них новое обнаружение.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -m mark --mark "$MARK" -j RETURN || return 1
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -m mark --mark "$MEASURE_MARK" -j RETURN || return 1
    # Keep ordinary DNS protected. Only the controller's own verifier mark
    # and exact admitted local DNS flows may traverse a selected program.
    for proto in tcp udp; do
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -p "$proto" -m multiport --dports "$DNS_PORTS" \
            -m mark ! --mark "$PROBE_MARK" -j RETURN || return 1
        "$fw_tool" -t mangle -A "$CHAIN_IN" -p "$proto" -m multiport --sports "$DNS_PORTS" \
            -j RETURN || return 1
    done

    preflight_queue_rules "$fw_tool" -A || return 1
    watch_rules "$fw_tool" -A || return 1
    late_watch_rules "$fw_tool" -A || return 1

    # --queue-bypass обязателен: смерть службы должна ПРОПУСКАТЬ трафик, а не
    # останавливать его (§10). Это касается и UDP-правил ниже в той же мере,
    # что и TCP: без --queue-bypass там остановка датапата обрывает весь QUIC
    # в сети, а не просто перестаёт его обрабатывать.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir original \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Если браузер сам сбрасывает зависший ответ после окна первых пакетов,
    # пропускаем в датапат только RST — payload большого потока не ставится
    # в очередь. Датапат поднимет volume-пару только если до этого видел TLS
    # app-data; один RST диагнозом или основанием для перебора не является.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Поздний RST — редкий, узкий сигнал для ответа, оборванного уже после
    # TLS app-data. Его надо видеть и ПОСЛЕ окна первых восьми пакетов, но не
    # ставить весь ответ в очередь. Правило ограничено трафиком за пределом
    # прежнего окна; ранние RST по-прежнему ловит обычная очередь ниже.
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # FIN без ответа тоже может повторяться после оборванного тела. Очередь
    # получает только закрывающие пакеты, не всю нагрузку. Первый FIN не
    # вызывает замер; повтор того же FIN без ответа (с планом и без) допускает
    # только узкую RX-пару, без плана — после второго такого потока за 30 с.
    # FIN сервера здесь же отпускает запись потока при обычном закрытии.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # HTTP live framing needs every late segment, including non-PSH body,
    # FIN and ACK. Narrowed to the measured cleartext HTTP port.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$HTTP_KEEPALIVE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Replies on reused HTTP connections must remain visible to live acceptance.
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$HTTP_KEEPALIVE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir reply \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1

    # То же самое для UDP (задача 4: датапат видит QUIC поверх UDP 443).
    # CONNBYTES с тем же порогом, что у TCP, — не для симметрии ради
    # симметрии: D2K_HELLO_WINDOW в session.c ограничивает разбор QUIC
    # ровно тем же числом первых датаграмм потока, так что очередь ничего не
    # выигрывает, продолжая получать пакеты сверх этого окна.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir original \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p udp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir reply \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1

    # Голос: первые пакеты туда (IP Discovery и повторы — по ним датапат
    # узнаёт голос и приговаривает «молчат») и первые оттуда (ответ сервера —
    # единственное подтверждение приёма голоса: зонда у голоса нет).
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL -m multiport --dports "$VOICE_PORTS" \
        -m connbytes --connbytes "$VOICE_CONNBYTES" --connbytes-dir original \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p udp -m conntrack --ctdir REPLY -m multiport --sports "$VOICE_PORTS" \
        -m connbytes --connbytes "$VOICE_CONNBYTES" --connbytes-dir reply \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1

    voice_late_rules "$fw_tool" -A || return 1

    fw_icmp_te_rule "$fw_tool" -A || return 1

    if [ "${2:-}" != detached ] || ! preflight_nat_rule "$fw_tool" -C 2>/dev/null; then
        preflight_nat_rule "$fw_tool" -A || return 1
    fi

    # СВОИ ПОСЫЛКИ ПО UDP — ЧЕРЕЗ MASQUERADE, и это не симметрия ради
    # симметрии, а разница между TCP и QUIC, замеренная на живом роутере
    # 13.09.2026.
    #
    # Датапат вклинивает пакеты сырым сокетом с адресами ИЗ ОЧЕРЕДИ, то есть
    # с ЛОКАЛЬНЫМ адресом клиента: очередь висит на mangle POSTROUTING, а
    # SNAT делается позже. Правильным внешним адресом такой пакет становится
    # ровно одним способом — попадая в ту же запись conntrack, что и поток
    # клиента.
    #
    #   TCP: приветствие — третий пакет соединения, запись давно есть, наши
    #        посылки попадают в неё сами. Ничего делать не нужно.
    #   QUIC: первая же датаграмма и ЕСТЬ приветствие, а запись подтверждается
    #        в конце прохода ЭТОГО пакета — в момент наших посылок её ещё нет
    #        ни при каком исправном ядре. Без правила ниже они уходят с
    #        локальным адресом и умирают у провайдера: замерено tcpdump на
    #        ppp0 (192.168.1.117 вместо 88.87.93.11).
    #
    # Правило создаёт трансляцию НАШЕЙ первой посылкой, а оригинал клиента,
    # идущий следом тем же кортежем, попадает в неё же — на проводе они
    # неотличимы. Только UDP: для TCP то же правило не нужно, а проверять
    # непроверенное на живой линии нельзя.
    if [ "${2:-}" = detached ]; then
        if [ "$fw_tool" = iptables ]; then
            "$fw_tool" -t nat -C POSTROUTING -p udp -m mark --mark "$MARK" -j MASQUERADE 2>/dev/null ||
                "$fw_tool" -t nat -A POSTROUTING -p udp -m mark --mark "$MARK" -j MASQUERADE || return 1
        fi
        return 0
    fi
    [ "$fw_tool" != iptables ] || "$fw_tool" -t nat -A POSTROUTING -p udp -m mark --mark "$MARK" \
        -j MASQUERADE || say "не поставить MASQUERADE для своих посылок — QUIC за роутером не пойдёт"

    "$fw_tool" -t mangle -I POSTROUTING -j "$CHAIN_OUT" || return 1
    "$fw_tool" -t mangle -I FORWARD     -j "$CHAIN_IN"  || return 1
    "$fw_tool" -t mangle -I INPUT       -j "$CHAIN_IN"  || return 1
    "$fw_tool" -t mangle -I INPUT -p udp --dport 53 ! -s "$loopback" \
        -j "$CHAIN_DNS_FAMILY" || return 1
    "$fw_tool" -t mangle -I OUTPUT -p udp --sport 53 ! -d "$loopback" \
        -j "$CHAIN_DNS_FAMILY" || return 1
    return 0
)

# Порядок опирается на то, что -j PPE НЕ завершает цепочку: замер на KN-1811
# 02.10.2026 — правило-счётчик с тем же совпадением сразу после -j PPE
# насчитало 788 из 788 пакетов и в FORWARD, и в PREROUTING; с PPE с первого
# пакета поток оставался виден целиком. Окажись цель завершающей, переход в
# D2K_IN ниже не получил бы ни одного пакета окна.
#
# Разгрузка ставится ПОСЛЕ переходов в цепочки d2k: -I кладёт её в начало
# FORWARD, выше перехода в D2K_IN. Пакет, отданный в NFQUEUE, до правил ниже
# по цепочке не доходит, и разгрузка под очередью не сработала бы для
# ответов в окне. Её отказ не отменяет правил очереди: без неё d2k видит
# хуже, но работает, как до неё.
ppe_up() {
    command -v d2k_ppe_ensure >/dev/null 2>&1 || return 0
    d2k_ppe_ensure
    case $? in
        0) ;;
        2) say "разгрузка PPE не ставится: в прошивке нет цели PPE" ;;
        3) say "разгрузка PPE выключена владельцем (D2K_PPE_DEOFFLOAD=0)" ;;
        *) say "разгрузка PPE встала не целиком — ответы под ускорителем могут быть не видны" ;;
    esac
    return 0
}

ppe_down() {
    command -v d2k_ppe_remove >/dev/null 2>&1 || return 0
    d2k_ppe_remove
}

# Без IPv4 работы нет. Без ip6tables mangle (код 3) служба работает по
# IPv4 и предупреждает: IPv6-трафик идёт мимо d2k, как без него. Любой иной
# отказ IPv6 — настоящая ошибка, и fw_up откатывает оба семейства.
fw_up_unlocked() {
    fw_family_up iptables || return 1
    rc6=0
    fw_family_up ip6tables || rc6=$?
    case $rc6 in
        0) rm -f "$FW_V4ONLY" ;;
        3)
            fw_family_down ip6tables
            { mkdir -p "$RUN" && : > "$FW_V4ONLY"; } || return 1
            say "ВНИМАНИЕ: ip6tables mangle недоступна (нет IPv6 в прошивке или модуля ip6table_mangle) — d2k работает только по IPv4, IPv6-трафик идёт без обработки"
            ;;
        *) return 1 ;;
    esac
    ppe_up
    dns_family_sync_unlocked || say "правила IPv4 fallback не синхронизировались; DNS оставлен без изменения"
}

fw_family_down() (
    fw_tool=$1
    dns_loopback=127.0.0.0/8
    [ "$fw_tool" != ip6tables ] || dns_loopback=::1/128
    while "$fw_tool" -t mangle -D OUTPUT -p udp --sport 53 ! -d "$dns_loopback" \
        -j "$CHAIN_DNS_FAMILY" 2>/dev/null; do :; done
    while "$fw_tool" -t mangle -D INPUT -p udp --dport 53 ! -s "$dns_loopback" \
        -j "$CHAIN_DNS_FAMILY" 2>/dev/null; do :; done
    if "$fw_tool" -t mangle -n -L "$CHAIN_DNS_FAMILY" >/dev/null 2>&1; then
        "$fw_tool" -t mangle -F "$CHAIN_DNS_FAMILY" 2>/dev/null
        "$fw_tool" -t mangle -X "$CHAIN_DNS_FAMILY" 2>/dev/null
    fi
    if [ "$fw_tool" = iptables ]; then
        while "$fw_tool" -t nat -D POSTROUTING -p tcp -m mark --mark "$PF_MARK" -j MASQUERADE 2>/dev/null; do :; done
    fi
    while "$fw_tool" -t nat -D PREROUTING -j D2K_HTTP 2>/dev/null; do :; done
    if "$fw_tool" -t nat -n -L D2K_HTTP >/dev/null 2>&1; then
        "$fw_tool" -t nat -F D2K_HTTP 2>/dev/null
        "$fw_tool" -t nat -X D2K_HTTP 2>/dev/null
    fi
    # Своё правило в nat снимается по тем же признакам, по которым ставилось.
    while "$fw_tool" -t nat -D POSTROUTING -p udp -m mark --mark "$MARK" \
        -j MASQUERADE 2>/dev/null; do :; done
    while "$fw_tool" -t mangle -D OUTPUT -m mark --mark "$HTTPUP_MARK" \
        -j CONNMARK --save-mark 2>/dev/null; do :; done
    while "$fw_tool" -t mangle -D OUTPUT -j D2K_HTTP_MARK 2>/dev/null; do :; done
    if "$fw_tool" -t mangle -n -L D2K_HTTP_MARK >/dev/null 2>&1; then
        "$fw_tool" -t mangle -F D2K_HTTP_MARK 2>/dev/null
        "$fw_tool" -t mangle -X D2K_HTTP_MARK 2>/dev/null
    fi
    for hook in POSTROUTING FORWARD OUTPUT INPUT; do
        for ch in "$CHAIN_OUT" "$CHAIN_IN"; do
            while "$fw_tool" -t mangle -D "$hook" -j "$ch" 2>/dev/null; do :; done
        done
    done
    for ch in "$CHAIN_OUT" "$CHAIN_IN"; do
        if "$fw_tool" -t mangle -n -L "$ch" >/dev/null 2>&1; then
            "$fw_tool" -t mangle -F "$ch" 2>/dev/null
            "$fw_tool" -t mangle -X "$ch" 2>/dev/null
        fi
    done
    if "$fw_tool" -t mangle -n -L "$CHAIN_WCLR" >/dev/null 2>&1; then
        "$fw_tool" -t mangle -F "$CHAIN_WCLR" 2>/dev/null
        "$fw_tool" -t mangle -X "$CHAIN_WCLR" 2>/dev/null
    fi
    # Содержимое цепочек поздней доставки — живое состояние d2kd: правила
    # его наблюдений, готовность которых он уже подтвердил. Пересборка при
    # живом d2kd (reapply, его откат) их не трогает; снимает остановка после
    # d2kd (engine_stop) или пересборка без него (остатки упавшего).
    if "$fw_tool" -t mangle -n -L "$CHAIN_PFCLR" >/dev/null 2>&1; then
        "$fw_tool" -t mangle -F "$CHAIN_PFCLR" 2>/dev/null
        "$fw_tool" -t mangle -X "$CHAIN_PFCLR" 2>/dev/null
    fi
    running "$DP_PID" || late_chains_drop "$fw_tool"
)

late_chains_drop() {
    for ch in "$CHAIN_LATE_OUT" "$CHAIN_LATE_IN"; do
        if "$1" -t mangle -n -L "$ch" >/dev/null 2>&1; then
            "$1" -t mangle -F "$ch" 2>/dev/null
            "$1" -t mangle -X "$ch" 2>/dev/null
        fi
    done

}

# Цепочки d2kd после его остановки (переход в них снят вместе с D2K_OUT/IN).
late_chains_down() {
    fw_lock_acquire || return 1
    for fw_tool in iptables ip6tables; do
        command -v "$fw_tool" >/dev/null 2>&1 && late_chains_drop "$fw_tool"
    done
    fw_lock_release
}

# ИСКЛЮЧЕНИЯ ВЛАДЕЛЬЦА В ЦЕПОЧКАХ D2K. Свои правила служба ставит в D2K_OUT и
# D2K_IN без комментария; правило с комментарием (-m comment) добавил человек
# — например, RETURN для устройства, которое не должно идти через очередь.
# Пересборка цепочек (reapply, полный перезапуск, TCP_WATCH, stop/start,
# перезагрузка) их прежде молча стирала. Теперь перед снятием они
# сохраняются в $USER_RULES, после постановки своих — возвращаются в начало
# цепочки тем же порядком. Семейство, у которого цепочек нет (после
# перезагрузки, IPv4-only), свой прежний снимок сохраняет; удалённое
# человеком при работающей службе правило не воскресает. Только iptables: на
# nft таблица d2k своя и снимается целиком.
USER_RULES=$STATE_DIR/user-rules
user_rules_save() {
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    _new=$USER_RULES.new.$$
    : > "$_new" || return 0
    for fw_tool in iptables ip6tables; do
        # Each chain can disappear independently during a partial firewall
        # failure. Preserve its saved rules only when that chain cannot be
        # read; a readable empty chain means the owner removed its rules.
        for _save_chain in "$CHAIN_OUT" "$CHAIN_IN"; do
            if { [ "$fw_tool" != iptables ] || [ -z "${RUN:-}" ] || [ ! -f "$RUN/fw-ipv4-rebuilding" ]; } &&
               { [ "$fw_tool" != ip6tables ] || [ ! -f "${FW_V6_REBUILDING:-}" ]; } &&
               command -v "$fw_tool" >/dev/null 2>&1 &&
               _saved_rules=$("$fw_tool" -t mangle -S "$_save_chain" 2>/dev/null); then
                printf '%s\n' "$_saved_rules" |
                    grep "^-A $_save_chain " | grep -F ' -m comment ' |
                    grep -vE ' --comment ("?d2k-dns-route"?)( |$)' |
                    sed "s/^/$fw_tool /" >> "$_new" || :
            elif [ -r "$USER_RULES" ]; then
                grep "^$fw_tool -A $_save_chain " "$USER_RULES" |
                    grep -vE ' --comment ("?d2k-dns-route"?)( |$)' >> "$_new" || :
            fi
        done
    done
    mv -f "$_new" "$USER_RULES" || rm -f "$_new"
    return 0
}

# set -- ниже разбирает сохранённое правило в слова, аргументов функция не
# принимает.
# shellcheck disable=SC2120
user_rules_restore() {
    local family_filter="${1:-}"
    [ -s "$USER_RULES" ] || return 0
    _ok=0; _bad=0
    # Обратный порядок с вставкой в позицию 1 даёт исходный порядок сверху.
    sed '1!G;h;$!d' "$USER_RULES" | while IFS= read -r _line; do
        case "$_line" in *' --comment d2k-dns-route '*|*' --comment "d2k-dns-route" '*) continue ;; esac
        _tool=${_line%% *}; _rule=${_line#* }
        [ -z "$family_filter" ] || [ "$family_filter" = "$_tool" ] || continue
        case "$_tool" in iptables|ip6tables) ;; *) continue ;; esac
        command -v "$_tool" >/dev/null 2>&1 || { [ -z "$family_filter" ] || exit 1; continue; }
        "$_tool" -t mangle -S "$CHAIN_OUT" >/dev/null 2>&1 || { [ -z "$family_filter" ] || exit 1; continue; }
        # Строка — вывод iptables -S. Ничего, кроме слов и кавычек: строка с
        # подстановкой или управляющим символом не исполняется.
        case "$_rule" in *[\`\$\;\&\|\<\>\(\)\\]*) say "исключение владельца не возвращено (недопустимые символы): $_rule"; continue ;; esac
        case "$_rule" in "-A $CHAIN_OUT "*|"-A $CHAIN_IN "*) ;; *) continue ;; esac
        _chain=${_rule#-A }; _chain=${_chain%% *}
        _args=${_rule#-A "$_chain" }
        eval "set -- $_args" 2>/dev/null || { say "исключение владельца не разобралось: $_rule"; continue; }
        "$_tool" -t mangle -C "$_chain" "$@" 2>/dev/null && continue
        "$_tool" -t mangle -I "$_chain" 1 "$@" 2>/dev/null ||
            { say "исключение владельца не возвращено ($_tool): $_rule"; [ -z "$family_filter" ] || exit 1; }
    done
}

fw_iptables_down() {
    local dns_shutdown_rc=0
    dns_local_routes_down || dns_shutdown_rc=1
    rm -f "$RUN/dns-routes.applied" "$RUN/dns-routes.reconciled"
    user_rules_save
    rm -f "$RUN"/late-watch-off.* "$RUN"/voice-late-off.* 2>/dev/null
    ppe_down
    for fw_tool in iptables ip6tables; do
        command -v "$fw_tool" >/dev/null 2>&1 && fw_family_down "$fw_tool"
    done
    rm -f "$FW_V4ONLY"
    return "$dns_shutdown_rc"
}

# --- nftables (OpenWrt) ----------------------------------------------------
#
# Те же правила, что у iptables выше, тем же порядком — в СВОЕЙ таблице inet
# d2k: оба семейства сразу, и снимается она целиком, без разбора по правилу.
# fw4 чужие таблицы не трогает: таблица переживает firewall restart и fw4
# reload (проверено 07.10.2026 на 25.12.5). Всё проверено nft -f на 25.12.5.
#
#   out      ← mangle POSTROUTING  (hook postrouting priority mangle)
#   in_rules ← D2K_IN, в неё переходят in_forward и in_input
#   nat_post ← nat POSTROUTING: MASQUERADE своих UDP, только IPv4, как выше
#
# multiport → множество портов, connbytes → ct <направление> packets,
# addrtype BROADCAST → fib daddr type broadcast. Таблица ставится одной
# транзакцией nft -f: прежняя удаляется в той же транзакции — окна без правил
# нет, и при отказе остаётся прежняя.
#
# Подавление RST зондами d2kc — ОТДЕЛЬНАЯ таблица inet d2k_rst: пересборка
# inet d2k (сторож, reapply) не должна снимать его у идущего зонда. Элементы
# с таймаутом ставит и снимает сам d2kc (detect/raw.c); после kill -9 элемент
# истекает сам, уборка по владельцу не нужна. Ключ — кортеж зонда (свой порт .
# адрес цели . порт цели): у iptables у каждого процесса было своё правило с
# владельцем, здесь два процесса с одним портом к разным целям не мешают друг
# другу, а один и тот же кортеж у двух зондов сразу невозможен.
NFT_TABLE=d2k
NFT_RST_TABLE=d2k_rst
NFT_PACKETS_MAX=18446744073709551615

# "a:b,c" (порты iptables) → "a-b, c".
nft_list() { printf '%s' "$1" | sed -e 's/:/-/g' -e 's/,/, /g'; }
# connbytes "A:B" → "A-B", открытое "A:" → "A-<максимум счётчика>".
# Нижняя граница 0 становится 1. У потока без расширения учёта (создан при
# nf_conntrack_acct=0, до загрузки таблицы — её ct packets включает учёт лишь
# для новых) nft читает счётчик как 0, а connbytes такой поток не берёт вовсе:
# окно 0-N держало бы его в очереди всю жизнь (ревью 07.10). Учтённый пакет к
# хукам mangle уже посчитан conntrack (приоритет -200), счётчик ≥ 1 — для
# учтённых потоков 1-N и 0:N совпадают.
nft_count() {
    case "$1" in
        *:) printf '%s-%s' "${1%:}" "$NFT_PACKETS_MAX" ;;
        0:*) printf '1-%s' "${1#0:}" ;;
        *) printf '%s' "$1" | tr ':' '-' ;;
    esac
}

nft_ruleset() (
    late=$(late_rst_from) || exit 1
    late=$(nft_count "$late:")
    win=$(nft_count "$CONNBYTES")
    ports=$(nft_list "$PORTS")
    dns=$(nft_list "$DNS_PORTS")
    voice=$(nft_list "$VOICE_PORTS")
    voicewin=$(nft_count "$VOICE_CONNBYTES")
    q="queue num $QUEUE_NUM bypass"
    pf_clear='' pf_out='' pf_in='' pf_nat=''
    pf_family='meta nfproto ipv4 '
    [ "${D2K_PREFLIGHT_V6:-0}" != 1 ] || pf_family=''
    if [ "${D2K_PREFLIGHT:-0}" = 1 ]; then
        pf_repeat_release=$(printf '0x%x' "$((PF_RELEASE_BIT | PF_RELEASE_MARK))")
        pf_repeat_token=$(printf '0x%x' "$((PF_RELEASE_BIT | PF_TOKEN_MARK))")
        pf_clear="chain pf_clear {
            ct mark set ct mark & 0xf7ffffff
            meta mark $pf_repeat_token drop
            meta mark set $PF_MARK
            accept
        }"
        pf_in="${pf_family}meta mark $pf_repeat_release jump pf_clear
            ${pf_family}meta mark $pf_repeat_token jump pf_clear"
        pf_out="$pf_in
            ${pf_family}meta l4proto tcp meta mark $PF_RELEASE_MARK $q
            ${pf_family}meta l4proto tcp meta mark $PF_TOKEN_MARK $q
            ${pf_family}meta l4proto tcp meta mark $PF_MARK ct mark set ct mark | $PF_CONN_BIT
            ${pf_family}meta mark $PF_MARK return"
        pf_nat="meta nfproto ipv4 meta l4proto tcp meta mark $PF_MARK masquerade"
    fi
    # Канал самого D2K — проводник установки на VPS (GATE_IP выше).
    gate_out=
    gate_in=
    if [ -n "$GATE_IP" ]; then
        gate_out="ip daddr $GATE_IP tcp dport $GATE_PORT return"
        gate_in="ip saddr $GATE_IP tcp sport $GATE_PORT return"
    fi
    cat <<EOF
table inet $NFT_TABLE {
    $pf_clear
	chain dns_family_out {
		type filter hook output priority mangle; policy accept;
	}
	chain dns_family_in {
		type filter hook input priority mangle; policy accept;
	}
	chain out {
		type filter hook postrouting priority mangle; policy accept;
        $pf_out
		ip saddr 127.0.0.0/8 return
		ip daddr 127.0.0.0/8 return
		ip6 saddr ::1 return
		ip6 daddr ::1 return
		meta nfproto ipv4 fib daddr type broadcast return
		ip daddr 224.0.0.0/4 return
		ip6 daddr ff00::/8 return
		meta mark $MARK return
		meta mark $MEASURE_MARK return
		meta mark != $PROBE_MARK meta l4proto { tcp, udp } th dport { $dns } return
		ct status dnat return
		$gate_out
$( [ "${D2K_PREFLIGHT:-0}" != 1 ] || printf '        %smeta l4proto tcp ct direction original ct mark & %s != 0 %s\n' "$pf_family" "$PF_CONN_BIT" "$q" )
		meta l4proto tcp ct direction original th dport { $ports } ct original packets $win $q
		meta l4proto tcp ct direction original th dport { $ports } ct original packets $late tcp flags & rst == rst $q
		meta l4proto tcp ct direction original th dport { $ports } ct original packets $late tcp flags & fin == fin $q
		meta l4proto tcp ct direction original th dport { $(nft_list "$HTTP_KEEPALIVE_PORTS") } ct original packets $late $q
		meta l4proto udp ct direction original th dport { $ports } ct original packets $win $q
		meta l4proto udp ct direction original th dport { $voice } ct original packets $voicewin $q
	}
	chain in_rules {
        $pf_in
		ip saddr 127.0.0.0/8 return
		ip daddr 127.0.0.0/8 return
		ip6 saddr ::1 return
		ip6 daddr ::1 return
		meta l4proto { tcp, udp } th sport { $dns } return
		ct status dnat return
		$gate_in
$( [ "${D2K_PREFLIGHT:-0}" != 1 ] || printf '        %smeta l4proto tcp ct direction reply ct mark & %s != 0 %s\n' "$pf_family" "$PF_CONN_BIT" "$q" )
		meta l4proto tcp ct direction reply th sport { $ports } ct reply packets $late tcp flags & rst == rst $q
		meta l4proto tcp ct direction reply th sport { $ports } ct reply packets $late tcp flags & fin == fin $q
		meta l4proto tcp ct direction reply th sport { $(nft_list "$HTTP_KEEPALIVE_PORTS") } ct reply packets $late $q
		meta l4proto tcp ct direction reply th sport { $ports } ct reply packets $win $q
		meta l4proto udp ct direction reply th sport { $ports } ct reply packets $win $q
		meta l4proto udp ct direction reply th sport { $voice } ct reply packets $voicewin $q
		icmp type time-exceeded icmp code 0 $q
		icmpv6 type time-exceeded icmpv6 code 0 $q
	}
	chain in_forward {
		type filter hook forward priority mangle; policy accept;
		jump in_rules
	}
	chain in_input {
		type filter hook input priority mangle; policy accept;
		jump in_rules
	}
	chain nat_post {
		type nat hook postrouting priority srcnat - 1; policy accept;
        $pf_nat
		meta nfproto ipv4 meta l4proto udp meta mark $MARK masquerade
	}
}
EOF
)

nft_rst_ruleset() {
    cat <<EOF
table inet $NFT_RST_TABLE {
	set rst4 { type inet_service . ipv4_addr . inet_service; flags timeout; }
	set rst6 { type inet_service . ipv6_addr . inet_service; flags timeout; }
	chain out {
		type filter hook output priority filter - 1; policy accept;
		meta nfproto ipv4 tcp flags & rst == rst tcp sport . ip daddr . tcp dport @rst4 drop
		meta nfproto ipv6 tcp flags & rst == rst tcp sport . ip6 daddr . tcp dport @rst6 drop
	}
}
EOF
}

nft_has() { nft list table inet "$1" >/dev/null 2>&1; }

fw_nft_up() {
    mkdir -p "$RUN" || return 1
    (
        ! nft_has "$NFT_TABLE" || echo "delete table inet $NFT_TABLE"
        nft_ruleset || exit 1
        nft_has "$NFT_RST_TABLE" || nft_rst_ruleset
    ) > "$RUN/fw.nft" || return 1
    nft -f "$RUN/fw.nft"
}

# Normalize only our preflight contract, preserving order within each chain.
# nft pads hexadecimal marks and prints queues differently from input syntax.
nft_preflight_contract() {
    sed -e 's/0x0*\([1-9a-f][0-9a-f]*\)/0x\1/g' -e 's/0x00*/0/g' \
        -e "s/queue num $QUEUE_NUM bypass/QUEUE/g" \
        -e "s/queue flags bypass to $QUEUE_NUM/QUEUE/g" \
        -e 's/[();]//g' |
    awk '
        $1 == "chain" { chain = $2; next }
        $1 == "}" { chain = ""; next }
        chain == "pf_clear" || (chain != "" && (/jump pf_clear/ || /0x(31|32|33|4000000|8000000)([^0-9a-f]|$)/)) {
            gsub(/[ \t]+/, " "); sub(/^ /, ""); sub(/ $/, "");
            if (length($0)) print chain ":" $0
        }'
}

fw_nft_installed() (
    listed=$(nft list table inet "$NFT_TABLE" 2>/dev/null) || return 1
    nft_has "$NFT_RST_TABLE" || return 1
    for chain in out dns_family_out dns_family_in in_rules in_forward in_input nat_post; do
        printf '%s\n' "$listed" | grep -q "chain $chain {" || return 1
    done
    printf '%s\n' "$listed" | grep -q masquerade || return 1
    if [ "${D2K_PREFLIGHT:-0}" = 1 ]; then
        pf_want=$(nft_ruleset | nft_preflight_contract) || return 1
        pf_got=$(printf '%s\n' "$listed" | nft_preflight_contract) || return 1
        [ "$pf_got" = "$pf_want" ] || return 1
    fi
    # nft печатает правило по-своему («queue flags bypass to 2000»), поэтому
    # сверяется число правил очереди с bypass и своим номером очереди.
    want=$(nft_ruleset | grep -c queue) || return 1
    got=$(printf '%s\n' "$listed" | grep queue | grep bypass | grep -cw -- "$QUEUE_NUM")
    dynamic=$(printf '%s\n' "$listed" | sed -n '/chain dns_family_out {/,/^[[:space:]]*}/p; /chain dns_family_in {/,/^[[:space:]]*}/p' | grep -c queue || :)
    [ "$((got - dynamic))" -eq "$want" ]
)

# Only clients with an active, controller-verified lease enter NFQUEUE. The
# empty OUTPUT chain is cheap and preserves ordinary DNS latency while no
# fallback is active. File data is never evaluated as shell code.
dns_family_sync_unlocked() {
    local family_now family_file family_expiry family_kind family_addr family_name family_extra family_tool family_bad
    family_now=$(date +%s) || return 1
    family_file=$STATE_DIR/ipv4-fallback
    family_bad=0
    if [ "$FW_BACKEND" = nft ]; then
        nft list chain inet "$NFT_TABLE" dns_family_out >/dev/null 2>&1 || return 0
        nft flush chain inet "$NFT_TABLE" dns_family_out || return 1
        nft flush chain inet "$NFT_TABLE" dns_family_in || return 1
    else
        for family_tool in iptables ip6tables; do
            command -v "$family_tool" >/dev/null 2>&1 || continue
            "$family_tool" -t mangle -n -L "$CHAIN_DNS_FAMILY" >/dev/null 2>&1 || continue
            "$family_tool" -t mangle -F "$CHAIN_DNS_FAMILY" || return 1
        done
    fi
    [ -r "$family_file" ] || return 0
    while read -r family_expiry family_kind family_addr family_name family_extra; do
        case "$family_expiry" in ''|*[!0-9]*) continue ;; esac
        [ "$family_expiry" -gt "$family_now" ] 2>/dev/null || continue
        [ -n "$family_name" ] && [ -z "$family_extra" ] || continue
        case "$family_kind" in
            4) family_tool=iptables; case "$family_addr" in *:*) continue ;; esac ;;
            6) family_tool=ip6tables; case "$family_addr" in *:*) ;; *) continue ;; esac ;;
            *) continue ;;
        esac
        if [ "$FW_BACKEND" = nft ]; then
            if [ "$family_kind" = 4 ]; then
                nft add rule inet "$NFT_TABLE" dns_family_out ip daddr "$family_addr" \
                    udp sport 53 queue num "$QUEUE_NUM" bypass || family_bad=1
                nft add rule inet "$NFT_TABLE" dns_family_in ip saddr "$family_addr" \
                    udp dport 53 queue num "$QUEUE_NUM" bypass || family_bad=1
            else
                nft add rule inet "$NFT_TABLE" dns_family_out ip6 daddr "$family_addr" \
                    udp sport 53 queue num "$QUEUE_NUM" bypass || family_bad=1
                nft add rule inet "$NFT_TABLE" dns_family_in ip6 saddr "$family_addr" \
                    udp dport 53 queue num "$QUEUE_NUM" bypass || family_bad=1
            fi
        elif command -v "$family_tool" >/dev/null 2>&1 &&
             "$family_tool" -t mangle -n -L "$CHAIN_DNS_FAMILY" >/dev/null 2>&1; then
            "$family_tool" -t mangle -A "$CHAIN_DNS_FAMILY" -d "$family_addr" \
                -p udp --sport 53 -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || family_bad=1
            "$family_tool" -t mangle -A "$CHAIN_DNS_FAMILY" -s "$family_addr" \
                -p udp --dport 53 -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || family_bad=1
        fi
    done < "$family_file"
    [ "$family_bad" = 0 ]
}
dns_family_sync() {
    fw_lock_acquire || return 1
    local family_rc=0
    dns_family_sync_unlocked || family_rc=1
    fw_lock_release || return 1
    return "$family_rc"
}

fw_down_unlocked() {
    local fw_remove_rc=0
    fw_iptables_down || fw_remove_rc=1
    if command -v nft >/dev/null 2>&1 && nft_has "$NFT_TABLE"; then
        nft delete table inet "$NFT_TABLE" || fw_remove_rc=1
    fi
    return "$fw_remove_rc"
}

# ПРАВИЛА ПОДАВЛЕНИЯ RST. d2kc и d2k-detect на время зонда ставят в filter
# OUTPUT правило «-p tcp --sport P --tcp-flags RST RST -m comment --comment
# d2k-rst:PID -j DROP» и снимают его сами; процесс, убитый сигналом KILL,
# оставляет его висеть. Снимаются только правила этой точной формы с портом
# зонда (30000-54999), как их опознаёт detect/raw.c:
#   dead — владелец мёртв (остановка движка: живой поиск панели сохраняет своё);
#   all  — ещё и владелец-процесс d2k (остановка службы, удаление).
rst_owner_removable() {
    kill -0 "$1" 2>/dev/null || return 0
    [ "$2" = all ] || return 1
    case "$(cat "$PROC_DIR/$1/comm" 2>/dev/null)" in d2k*) return 0 ;; esac
    return 1
}

rst_rules_down() {
    # nft: элементы зондов истекают сами; при остановке службы таблица
    # снимается целиком, при остановке движка живой поиск сохраняет своё.
    if [ "$1" = all ] && command -v nft >/dev/null 2>&1 && nft_has "$NFT_RST_TABLE"; then
        nft delete table inet "$NFT_RST_TABLE" 2>/dev/null || true
    fi
    for fw_tool in iptables ip6tables; do
        command -v "$fw_tool" >/dev/null 2>&1 || continue
        rules=$("$fw_tool" -w -S OUTPUT 2>/dev/null || "$fw_tool" -S OUTPUT 2>/dev/null) || continue
        printf '%s\n' "$rules" | sed -n \
            's/^-A OUTPUT -p tcp \(-m tcp \)\{0,1\}--sport \([0-9][0-9]*\) --tcp-flags RST RST -m comment --comment "\{0,1\}d2k-rst:\([1-9][0-9]*\)"\{0,1\} -j DROP *$/\2 \3/p' |
        while read -r port owner; do
            if ! { [ "$port" -ge 30000 ] && [ "$port" -le 54999 ]; }; then continue; fi
            rst_owner_removable "$owner" "$1" || continue
            "$fw_tool" -w -D OUTPUT -p tcp --sport "$port" --tcp-flags RST RST \
                -m comment --comment "d2k-rst:$owner" -j DROP 2>/dev/null ||
            "$fw_tool" -D OUTPUT -p tcp --sport "$port" --tcp-flags RST RST \
                -m comment --comment "d2k-rst:$owner" -j DROP 2>/dev/null || true
        done
    done
}

# Сторож: вернуть снесённую разгрузку, не трогая правил очереди. Под тем же
# замком, что fw_up, — иначе вставка может лечь между снятием и постановкой.
ppe_ensure() {
    [ "$FW_BACKEND" = iptables ] || return 0
    command -v d2k_ppe_ensure >/dev/null 2>&1 || return 0
    running "$DP_PID" || return 0
    fw_lock_acquire || return 1
    d2k_ppe_ensure
    rc=$?
    fw_lock_release || return 1
    case $rc in 0|2|3) return 0 ;; *) return 1 ;; esac
}

# Замок-каталог: mkdir атомарен. Замок умершего владельца снимается.
dir_lock_acquire() { # <каталог> <бюджет в десятых секунды; 0 — не ждать>
    local attempt owner
    attempt=0
    while ! mkdir "$1" 2>/dev/null; do
        owner=$(cat "$1/pid" 2>/dev/null)
        case "$owner" in
            ''|*[!0-9]*)
                # Владелец упал между mkdir и записью номера: замок без
                # номера старше LOCK_EMPTY_STALE с — ничей. Живой владелец
                # пишет номер сразу после mkdir.
                _lt=$(date -r "$1" +%s 2>/dev/null)
                case "$_lt" in
                    ''|*[!0-9]*) ;;
                    *)
                        if [ $(($(date +%s) - _lt)) -gt "${LOCK_EMPTY_STALE:-5}" ] &&
                           [ ! -s "$1/pid" ]; then
                            rm -f "$1/pid" 2>/dev/null
                            rmdir "$1" 2>/dev/null
                            continue
                        fi ;;
                esac ;;
            *)
                if ! kill -0 "$owner" 2>/dev/null; then
                    rm -f "$1/pid" 2>/dev/null
                    rmdir "$1" 2>/dev/null
                    continue
                fi ;;
        esac
        [ "$attempt" -lt "$2" ] || return 1
        wait_tenth
        attempt=$((attempt + D2K_WAIT_TICKS))
    done
    printf '%s\n' "$$" > "$1/pid" || { rmdir "$1"; return 1; }
}

dir_lock_release() {
    [ "$(cat "$1/pid" 2>/dev/null)" = "$$" ] || return 1
    rm -f "$1/pid"
    rmdir "$1"
}

fw_lock_acquire() { dir_lock_acquire "$FW_LOCK" 300; }
fw_lock_release() { dir_lock_release "$FW_LOCK"; }

# Замок переходов движка держится до выхода этого процесса, в том числе по
# die: снимает его ловушка EXIT.
engine_lock() { # <попыток по 0,1 с>
    dir_lock_acquire "$ENGINE_LOCK" "$1" || return 1
    trap 'dir_lock_release "$ENGINE_LOCK" 2>/dev/null' EXIT
    trap 'exit 130' INT TERM HUP
}
locked() {
    engine_lock 1200 || die "другая операция со службой не закончилась за 2 мин — повторите позже"
}

# Настроенные DNS защищены от обычного подбора. Собственный проверочный
# поток проходит через выбранный опыт; при измеренном отказе контроллер
# разрешает восстановление точного апстрима. Остальные DNS и UDP сохраняют
# защиту. Источник — фактическая конфигурация, без списка провайдеров.
# Неразрешившееся имя сохраняет прежние собственные адресные наблюдения.
# procd supplies the live command for each running DoH instance, including its
# resolver URL and bootstrap addresses. Keep URL paths in the private snapshot.
openwrt_dns_snapshot() (
    command -v jsonfilter >/dev/null 2>&1 || return 1
    instances=$(ubus call service list '{"name":"https-dns-proxy"}') || return 1
    [ -n "$instances" ] || return 1
    # jsonfilter returns 1 when a valid service list has no matching instance.
    pids=$(printf '%s' "$instances" | jsonfilter -e '@["https-dns-proxy"].instances[@.running=true].pid') || :
    for pid in $pids; do
        case $pid in *[!0-9]*|'') return 1 ;; esac
        args=$(tr '\000' '\n' < "/proc/$pid/cmdline") || return 1
        url=$(printf '%s\n' "$args" | awk '$0=="-r"{getline;print;exit}')
        case $url in https://*) ;; *) continue ;; esac
        printf 'upstream %s\n' "$url"
        host=${url#https://}; host=${host%%[/?]*}
        case $host in *'@'*|'['*) continue ;; esac
        host=${host%%:*}
        case $host in ''|-*|*[!A-Za-z0-9.-]*) continue ;; *[!0-9.]*) ;; *) continue ;; esac
        bootstrap=$(printf '%s\n' "$args" | awk '$0=="-b"{getline;gsub(/,/," ");print;exit}')
        for server in ${bootstrap:-127.0.0.1}; do
            case $server in *[!0-9a-fA-F.:\[\]]*) continue ;; esac
            answer=$(nslookup -timeout=2 "$host" "$server" 2>/dev/null) || continue
            printf '%s\n' "$answer" | awk -v host="$host" '
                /^Name:/ {answer=1;next}
                answer && /^Address/ {ip=$NF
                    if(ip ~ /^[0-9.]+$/) print "static_a = " host,ip,0
                    else if(ip ~ /^[0-9a-fA-F:]+$/ && index(ip,":")) print "static_aaaa = " host,ip,0
                }'
            break
        done
    done
)

dns_config_snapshot() (
    if ! command -v ndmc >/dev/null 2>&1; then
        [ -f "${OPENWRT_RELEASE:-/etc/openwrt_release}" ] || return 0
        umask 077
        native=$(mktemp "$RUN/.dns-upstreams.XXXXXX") || return 1
        if openwrt_dns_snapshot > "$native"; then
            mv -f "$native" "$RUN/dns-upstreams" || return 1
        else
            rm -f "$native"
        fi
        [ ! -r "$RUN/dns-upstreams" ] || cat "$RUN/dns-upstreams"
        return
    fi
    umask 077
    dns_raw=$(mktemp "$RUN/.dns-upstreams.raw.XXXXXX") || return 1
    dns_clean=
    if ndmc -c "show dns-proxy" > "$dns_raw" 2>/dev/null; then
        dns_clean=$(mktemp "$RUN/.dns-upstreams.clean.XXXXXX") || { rm -f "$dns_raw"; return 1; }
        if tr -d '\033\r' < "$dns_raw" > "$dns_clean" && chmod 600 "$dns_clean"; then
            mv -f "$dns_clean" "$RUN/dns-upstreams" || { rm -f "$dns_raw" "$dns_clean"; return 1; }
        else
            rm -f "$dns_raw" "$dns_clean";return 1
        fi
    fi
    rm -f "$dns_raw"
    # A failed read retains the last complete private configuration snapshot.
    [ ! -r "$RUN/dns-upstreams" ] || cat "$RUN/dns-upstreams"
)
dns_upstreams() {
    command -v ndmc >/dev/null 2>&1 || [ -f "${OPENWRT_RELEASE:-/etc/openwrt_release}" ] || return 0
    [ -r "$RUN/dns-upstreams" ] || dns_config_snapshot >/dev/null || return 1
    [ -r "$RUN/dns-upstreams" ] || return 0
    awk '
        function emit(s, def,    host, port, t) {
            host = s; port = def; t = s
            if (s ~ /^\[/) {
                sub(/^\[/, "", host); sub(/\].*/, "", host)
                if (s ~ /\]:[0-9]+$/) { port = s; sub(/.*\]:/, "", port) }
            } else if (gsub(/:/, ":", t) == 1) {
                sub(/:.*/, "", host); port = s; sub(/.*:/, "", port)
            }
            if (host != "" && port ~ /^[0-9]+$/) print host, port
        }
        $1 == "upstream" && $2 ~ /^https:\/\// {
            c=$2; sub(/^https:\/\//,"",c); sub(/[\/?].*/,"",c); emit(c,443); next
        }
        $1 == "dns_server" && $2 == "=" {
            a = $3
            if (a !~ /^127\./ && a !~ /^\[?::1\]?(:|$)/) emit(a, 53)
            c = ""
            for (i = 4; i < NF; i++) if ($i == "#") { c = $(i + 1); break }
            if (c == "") next
            sub(/@.*/, "", c)
            if (c ~ /^https:\/\//) { sub(/^https:\/\//, "", c); sub(/\/.*/, "", c); emit(c, 443) }
            else { sub(/^tls:\/\//, "", c); emit(c, 853) }
        }' "$RUN/dns-upstreams"
}
# Only locally originated, unmarked traffic to an admitted DNS endpoint receives
# the own-verifier mark. Client policy selection remains in effect for LAN
# clients, and existing routing-policy marks are never overwritten.
dns_local_route_rule() (
    dns_local_action=$1 dns_local_address=$2 dns_local_port=$3 dns_local_proto=${4:-tcp}
    case "$dns_local_proto" in tcp|udp) ;; *) exit 1 ;; esac
    dns_local_tool=iptables
    case $dns_local_address in *:*) dns_local_tool=ip6tables; [ ! -f "$FW_V4ONLY" ] || return 0 ;; esac
    set -- OUTPUT -p "$dns_local_proto" -d "$dns_local_address" --dport "$dns_local_port" \
        -m mark --mark 0 -m comment --comment d2k-dns-route -j MARK --set-xmark "$PROBE_MARK/0xffffffff"
    if [ "$dns_local_action" = -A ]; then
        "$dns_local_tool" -t mangle -C "$@" 2>/dev/null || "$dns_local_tool" -t mangle -I "$@" || return 1
    else
        while "$dns_local_tool" -t mangle -C "$@" 2>/dev/null; do
            "$dns_local_tool" -t mangle -D "$@" || return 1
        done
    fi
    # INPUT is local to the router. Keep the shared chain's exclusions even
    # when this exact resolver and transport are admitted for local traffic.
    set -- INPUT -p "$dns_local_proto" -s "$dns_local_address" --sport "$dns_local_port" \
        -m comment --comment d2k-dns-route -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass
    if [ "$dns_local_action" = -A ]; then
        "$dns_local_tool" -t mangle -C "$@" 2>/dev/null || "$dns_local_tool" -t mangle -I "$@" || return 1
    else
        while "$dns_local_tool" -t mangle -C "$@" 2>/dev/null; do
            "$dns_local_tool" -t mangle -D "$@" || return 1
        done
    fi
)
dns_local_routes_down() (
    set -f
    for dns_cleanup_tool in iptables ip6tables; do
        command -v "$dns_cleanup_tool" >/dev/null 2>&1 || continue
        for dns_cleanup_chain in OUTPUT INPUT "$CHAIN_IN"; do
            if ! dns_cleanup_rules=$("$dns_cleanup_tool" -t mangle -S "$dns_cleanup_chain" 2>/dev/null); then
                [ "$dns_cleanup_chain" != "$CHAIN_IN" ] || continue
                # An unavailable family/table cannot contain an owned rule.
                "$dns_cleanup_tool" -t mangle -n -L POSTROUTING >/dev/null 2>&1 || continue
                exit 1
            fi
            printf '%s\n' "$dns_cleanup_rules" |
            sed 's/"d2k-dns-route"/d2k-dns-route/g' |
            while IFS= read -r dns_cleanup_line; do
                case "$dns_cleanup_line" in
                    "-A $dns_cleanup_chain "*' --comment d2k-dns-route '*)
                        # shellcheck disable=SC2086 # parsed iptables-save words
                        set -- $dns_cleanup_line;shift
                        "$dns_cleanup_tool" -t mangle -D "$@" || exit 1 ;;
                esac
            done || exit 1
        done
    done
)

dns_excl_rule() { # <-D|-A> <адрес> <порт>
    dns_rule_action=$1 dns_rule_address=$2 dns_rule_port=$3
    dx_tool=iptables
    case $dns_rule_address in *:*) dx_tool=ip6tables; [ ! -f "$FW_V4ONLY" ] || return 0 ;; esac
    for dx_pr in tcp udp; do
        dns_route_action=-D
        if [ "$dns_rule_action" = -A ] && [ -r "${DNS_ROUTES_INPUT:-${RUN:-/tmp/d2k}/dns-routes}" ] &&
           awk -v a="$dns_rule_address" -v p="$dns_rule_port" -v protocol="$dx_pr" \
               'NF==4 && $2==a && $3==p && $4==protocol {f=1} END {exit !f}' "${DNS_ROUTES_INPUT:-${RUN:-/tmp/d2k}/dns-routes}"; then
            dns_route_action=-A
        fi
        dns_local_route_rule "$dns_route_action" "$dns_rule_address" "$dns_rule_port" "$dx_pr" || return 1
        for dx_dir in out in; do
            if [ "$dx_dir" = out ]; then
                set -- "$CHAIN_OUT" -p "$dx_pr" -d "$dns_rule_address" --dport "$dns_rule_port"
                # Retire the older unqualified rule; otherwise it would still
                # hide this own verifier after the qualified rule was skipped.
                while "$dx_tool" -t mangle -C "$@" -j RETURN 2>/dev/null; do
                    "$dx_tool" -t mangle -D "$@" -j RETURN || return 1
                done
                set -- "$@" -m mark ! --mark "$PROBE_MARK"
            else
                set -- "$CHAIN_IN" -p "$dx_pr" -s "$dns_rule_address" --sport "$dns_rule_port"
            fi
            if [ "$dns_rule_action" = -D ]; then
                while "$dx_tool" -t mangle -C "$@" -j RETURN 2>/dev/null; do
                    "$dx_tool" -t mangle -D "$@" -j RETURN || return 1
                done
            else
                "$dx_tool" -t mangle -C "$@" -j RETURN 2>/dev/null ||
                    "$dx_tool" -t mangle -I "$@" -j RETURN || return 1
            fi
        done
    done
}
# Reconcile owned rules against actual kernel state as well as the cache:
# a partially failed earlier addition must still be revocable after a later
# configuration change. Foreign rules are not part of this namespace.
dns_local_routes_prune() (
    set -f
    dns_prune_targets=$1
    for dns_prune_tool in iptables ip6tables; do
        command -v "$dns_prune_tool" >/dev/null 2>&1 || continue
        for dns_prune_chain in OUTPUT INPUT "$CHAIN_IN"; do
            if ! dns_prune_rules=$("$dns_prune_tool" -t mangle -S "$dns_prune_chain" 2>/dev/null); then
                [ "$dns_prune_chain" != "$CHAIN_IN" ] || continue
                # An unavailable family/table cannot contain an owned rule.
                "$dns_prune_tool" -t mangle -n -L POSTROUTING >/dev/null 2>&1 || continue
                exit 1
            fi
            printf '%s\n' "$dns_prune_rules" |
            sed 's/"d2k-dns-route"/d2k-dns-route/g' |
            while IFS= read -r dns_prune_line; do
                case "$dns_prune_line" in "-A $dns_prune_chain "*' --comment d2k-dns-route '*) ;; *) continue ;; esac
                dns_prune_ip='' dns_prune_port='' dns_prune_proto='' dns_prune_prev=''
                for dns_prune_word in $dns_prune_line; do
                    case "$dns_prune_prev" in
                        -s|-d) dns_prune_ip=$dns_prune_word ;;
                        --sport|--dport) dns_prune_port=$dns_prune_word ;;
                        -p) dns_prune_proto=$dns_prune_word ;;
                    esac
                    dns_prune_prev=$dns_prune_word
                done
                case "$dns_prune_ip" in *:*/128) dns_prune_ip=${dns_prune_ip%/128} ;; */32) dns_prune_ip=${dns_prune_ip%/32} ;; esac
                if [ "$dns_prune_chain" != "$CHAIN_IN" ] && [ -r "${DNS_ROUTES_INPUT:-$RUN/dns-routes}" ] &&
                   awk -v a="$dns_prune_ip" -v p="$dns_prune_port" '$2==a && $3==p {f=1} END {exit !f}' "$dns_prune_targets" &&
                   awk -v a="$dns_prune_ip" -v p="$dns_prune_port" -v protocol="$dns_prune_proto" \
                       'NF==4 && $2==a && $3==p && $4==protocol {f=1} END {exit !f}' "${DNS_ROUTES_INPUT:-$RUN/dns-routes}"; then
                    continue
                fi
                # shellcheck disable=SC2086 # parsed iptables-save words
                set -- $dns_prune_line;shift
                "$dns_prune_tool" -t mangle -D "$@" || exit 1
            done || exit 1
        done
    done
)
dns_excl_apply() { # [fresh] — цепочки только что собраны заново
    dns_config_snapshot >/dev/null || return 1
    [ "$FW_BACKEND" = iptables ] || return 0
    dx_state=$RUN/dns-excl
    dx_new=$dx_state.new
    dns_upstreams | while read -r dx_h dx_p; do
        case $dx_h in
            *:*|*[!0-9.]*) ;;
            *) echo "$dx_h $dx_h $dx_p"; continue ;;
        esac
        case $dx_h in *:*) echo "$dx_h $dx_h $dx_p"; continue ;; esac
        # Keenetic's own bootstrap survives a DoH outage; the resolver we
        # would otherwise ask is precisely the component that may be down.
        dx_static_ips=
        if [ -r "$RUN/dns-upstreams" ]; then
            dx_static_ips=$(awk -v h="$dx_h" '
                $1 == "static_a" && $2 == "=" && $3 == h && $4 ~ /^[0-9.]+$/ { print $4 }
                $1 == "static_aaaa" && $2 == "=" && $3 == h && $4 ~ /^[0-9a-fA-F:]+$/ { print $4 }
            ' "$RUN/dns-upstreams")
        fi
        dx_ips=
        if [ -z "$dx_static_ips" ]; then
            dx_ips=$(nslookup "$dx_h" 127.0.0.1 2>/dev/null |
                awk '/^Name:/ { n = 1; next } n && /^Address/ { print $3 }')
        fi
        for dx_ip in $dx_static_ips $dx_ips; do echo "$dx_h $dx_ip $dx_p"; done
        if [ -z "$dx_ips" ]; then
            if [ -f "$dx_state" ]; then
                awk -v h="$dx_h" -v p="$dx_p" '$1 == h && $3 == p' "$dx_state"
            fi
            if [ -r "${DNS_ROUTES_INPUT:-$RUN/dns-routes}" ]; then
                # The controller can already own an exact address witness
                # from its saved DNS proof even when bootstrap is down.
                awk -v h="$dx_h" -v p="$dx_p" 'NF==4 && $1==h && $3==p && ($4=="tcp" || $4=="udp") {print $1, $2, $3}' "${DNS_ROUTES_INPUT:-$RUN/dns-routes}"
            fi
        fi
    done | sort -u > "$dx_new" || return 1
    dns_local_routes_prune "$dx_new" || return 1
    if [ "${1:-}" != fresh ] && [ -f "$dx_state" ]; then
        while read -r dx_h dx_ip dx_p; do
            awk -v a="$dx_ip" -v p="$dx_p" '$2 == a && $3 == p { f = 1 } END { exit !f }' "$dx_new" ||
                dns_excl_rule -D "$dx_ip" "$dx_p" || return 1
        done < "$dx_state"
    fi
    while read -r dx_h dx_ip dx_p; do
        if [ -r "$STATE_DIR/doh-targets" ] &&
           awk -v h="$dx_h" -v p="$dx_p" '$1==h && $2==p {f=1} END {exit !f}' "$STATE_DIR/doh-targets"; then
            # Keep the owner's explicit admission while retaining its
            # address observation for automatic health and cold recovery.
            dns_excl_rule -D "$dx_ip" "$dx_p" || return 1
            for dx_protocol in tcp udp; do
                if [ -r "${DNS_ROUTES_INPUT:-$RUN/dns-routes}" ] &&
                   awk -v a="$dx_ip" -v p="$dx_p" -v proto="$dx_protocol" 'NF==4 && $2==a && $3==p && $4==proto {f=1} END {exit !f}' "${DNS_ROUTES_INPUT:-$RUN/dns-routes}"; then
                    dns_local_route_rule -A "$dx_ip" "$dx_p" "$dx_protocol" || return 1
                fi
            done
        else
            dns_excl_rule -A "$dx_ip" "$dx_p" || return 1
        fi
    done < "$dx_new"
    mv -f "$dx_new" "$dx_state"
}
dns_excl_sync_unlocked() (
    case "$FW_BACKEND" in
        iptables) ;;
        *) dns_config_snapshot >/dev/null; return $? ;;
    esac
    route_snapshot=$(mktemp "$RUN/.dns-routes.XXXXXX") || return 1
    route_applied=$(mktemp "$RUN/.dns-applied.XXXXXX") || { rm -f "$route_snapshot"; return 1; }
    trap 'rm -f "$route_snapshot" "$route_applied"' EXIT
    if [ -r "$RUN/dns-routes" ]; then
        cat "$RUN/dns-routes" > "$route_snapshot" || return 1
    fi
    DNS_ROUTES_INPUT=$route_snapshot
    rm -f "$RUN/dns-routes.applied" "$RUN/dns-routes.reconciled" || return 1
    dns_excl_apply "$@" || return 1
    route_v4only=0
    [ ! -f "$FW_V4ONLY" ] || route_v4only=1
    awk -v v4only="$route_v4only" '
        FILENAME==ARGV[1] && NF==3 { active[$1,$2,$3]=1; next }
        NF==4 && (($1,$2,$3) in active) && (!v4only || $2 !~ /:/) { print }
    ' "$RUN/dns-excl" "$route_snapshot" > "$route_applied" || return 1
    mv -f "$route_applied" "$RUN/dns-routes.applied" &&
        mv -f "$route_snapshot" "$RUN/dns-routes.reconciled"
)
dns_excl_sync() {
    fw_lock_acquire || return 1
    dns_sync_rc=0
    dns_excl_sync_unlocked || dns_sync_rc=$?
    fw_lock_release || return 1
    return "$dns_sync_rc"
}

fw_up() {
    preflight_validate || return 1
    watch_validate || return 1
    local rc
    fw_lock_acquire || return 1
    if [ "$FW_BACKEND" = nft ]; then
        # Остатки iptables (установка времён Entware) снимаются; таблица nft
        # заменяется своей транзакцией, без окна без правил.
        if ! fw_iptables_down; then
            rc=1
        elif fw_nft_up; then
            rc=0
            [ ! -f "$OPENWRT_RELEASE" ] || dns_config_snapshot >/dev/null
            dns_family_sync_unlocked || say "правила IPv4 fallback не синхронизировались; DNS оставлен без изменения"
        else
            say "nft не принял правила — см. $RUN/fw.nft"
            fw_down_unlocked
            rc=1
        fi
    else
        if ! fw_down_unlocked; then
            rc=1
        elif fw_up_unlocked; then
            rc=0
            dns_excl_sync_unlocked fresh || say "исключение DNS роутера встало не целиком"
            user_rules_restore
        else
            # IPv4 may already be hooked when IPv6 setup fails. Stop the
            # producer before removing the release handler during rollback.
            if [ -f "$RUN/tcp-watch-active" ] || [ -f "$RUN/preflight-active" ]; then
                stop_pidfile "$CT_PID"
                stop_pidfile "$DP_PID"
            fi
            fw_down_unlocked
            rc=1
        fi
    fi
    fw_lock_release || return 1
    return "$rc"
}

fw_down() {
    local rc
    fw_lock_acquire || return 1
    fw_down_unlocked
    rc=$?
    fw_lock_release || return 1
    return "$rc"
}

fw_family_installed() (
    fw_tool=$1
    loopback=127.0.0.0/8
    [ "$fw_tool" != ip6tables ] || loopback=::1/128
    local late_from
    preflight_control_rules "$fw_tool" -C || return 1
    preflight_queue_rules "$fw_tool" -C || return 1
    [ "${2:-}" = mangle-only ] || preflight_nat_rule "$fw_tool" -C || return 1
    watch_rules "$fw_tool" -C || return 1
    watch_release_rules "$fw_tool" -C || return 1
    late_watch_rules "$fw_tool" -C || return 1
    voice_late_rules "$fw_tool" -C || return 1
    late_from=$(late_rst_from) || return 1
    # A jump into an empty chain does not send a single packet to d2kd.
    # Check the complete contract, including reply traffic and bypass. -C
    # is supported by the target's iptables 1.4.21 (verified 12.09).
    for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$fw_tool" -t mangle -C "$chain" -s $loopback -j RETURN 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$chain" -d $loopback -j RETURN 2>/dev/null || return 1
    done
    if [ "$fw_tool" = iptables ]; then
        { "$fw_tool" -t mangle -C "$CHAIN_OUT" -m addrtype --dst-type BROADCAST \
              -j RETURN 2>/dev/null ||
          "$fw_tool" -t mangle -C "$CHAIN_OUT" -d 255.255.255.255 -j RETURN 2>/dev/null; } || return 1
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -d 224.0.0.0/4 -j RETURN 2>/dev/null || return 1
    else
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -d ff00::/8 -j RETURN 2>/dev/null || return 1
    fi
    "$fw_tool" -t mangle -C POSTROUTING -j "$CHAIN_OUT" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C FORWARD -j "$CHAIN_IN" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C INPUT -j "$CHAIN_IN" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C OUTPUT -p udp --sport 53 ! -d "$loopback" \
        -j "$CHAIN_DNS_FAMILY" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C INPUT -p udp --dport 53 ! -s "$loopback" \
        -j "$CHAIN_DNS_FAMILY" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -m mark --mark "$MARK" -j RETURN 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -m mark --mark "$MEASURE_MARK" -j RETURN 2>/dev/null || return 1
    for proto in tcp udp; do
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -p "$proto" -m multiport --dports "$DNS_PORTS" \
            -m mark ! --mark "$PROBE_MARK" -j RETURN 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$CHAIN_IN" -p "$proto" -m multiport --sports "$DNS_PORTS" \
            -j RETURN 2>/dev/null || return 1
    done
    for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$fw_tool" -t mangle -C "$chain" -m conntrack --ctstate DNAT -j RETURN 2>/dev/null || return 1
    done
    if [ -n "$GATE_IP" ] && [ "$fw_tool" = iptables ]; then
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -d "$GATE_IP" --dport "$GATE_PORT" -j RETURN 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$CHAIN_IN" -p tcp -s "$GATE_IP" --sport "$GATE_PORT" -j RETURN 2>/dev/null || return 1
    fi
    for proto in tcp udp; do
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -p "$proto" -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
            -m connbytes --connbytes "$CONNBYTES" --connbytes-dir original \
            --connbytes-mode packets -j NFQUEUE --queue-num "$QUEUE_NUM" \
            --queue-bypass 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$CHAIN_IN" -p "$proto" -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
            -m connbytes --connbytes "$CONNBYTES" --connbytes-dir reply \
            --connbytes-mode packets -j NFQUEUE --queue-num "$QUEUE_NUM" \
            --queue-bypass 2>/dev/null || return 1
    done
    fw_icmp_te_rule "$fw_tool" -C 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$HTTP_KEEPALIVE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$HTTP_KEEPALIVE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    [ "${2:-}" = mangle-only ] || [ "$fw_tool" != iptables ] || "$fw_tool" -t nat -C POSTROUTING -p udp -m mark --mark "$MARK" \
        -j MASQUERADE 2>/dev/null || return 1
    return 0
)

fw_installed() {
    local D2K_PREFLIGHT_V6=0
    preflight_validate || return 1
    if preflight_ipv6_available; then
        [ -f "$RUN/preflight-v6-active" ] || return 1
        D2K_PREFLIGHT_V6=1
    else
        [ ! -f "$RUN/preflight-v6-active" ] || return 1
    fi
    if [ "${D2K_PREFLIGHT:-0}" != 1 ] && [ -f "$RUN/preflight-active" ]; then return 1; fi
    watch_auto_resolve
    [ "$FW_BACKEND" != nft ] || { fw_nft_installed; return; }
    fw_family_installed iptables || return 1
    [ -f "$FW_V4ONLY" ] || fw_family_installed ip6tables
}

