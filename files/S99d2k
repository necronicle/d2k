#!/bin/sh
# d2k — служба обхода DPI для Keenetic.
#
# BusyBox ash. Никаких башизмов: на роутере другого шелла нет.
#
# Два процесса, и это намеренно (§7.1 документа): падение планировщика не
# должно ронять разбор пакетов. d2kd видит пакеты, d2kc подбирает, d2kpanel
# независимо показывает состояние.
#
# Правила firewall живут в СВОИХ цепочках. Не в общих с комментарием: уборка
# по комментарию однажды промахнулась мимо правила, поставленного чуть иначе,
# и оно осталось висеть. Своя цепочка снимается целиком и без разбора.
#
# fw_up/fw_down проверены настоящим iptables (не только shellcheck'ом — тот
# в scripts/check.sh, а этот файл в его глоб *.sh не попадает: init-скрипты
# Keenetic называются без расширения): sh scripts/check_firewall.sh гоняет их
# в Linux-контейнере и сверяет вывод `iptables -S` построчно. Требует Docker,
# в обычный гейт не включён — запускать вручную при правке этого файла.

PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# ВРЕМЯ В ЖУРНАЛЕ — МЕСТНОЕ, а не UTC.
#
# Движок печатает время через localtime(), а оно на Keenetic не работает само:
# /etc/localtime — ссылка на /var/TZ, и внутри лежит ПОСИКСНАЯ СТРОКА ("MSK-3"),
# а не двоичный tzfile, которого ждёт libc. Не разобрав файл, libc молча
# отступает к UTC — и человек, читая журнал рядом с выводом `date`, видит
# расхождение в три часа и не понимает, живая служба или встала (проверено
# 13.09.2026: последняя строка 13:54 при системных 16:54).
#
# Переменная TZ ту же посиксную строку принимает напрямую. Берём её у системы,
# а не вписываем: часовой пояс задаёт владелец роутера, и знать его наперёд
# мы не можем. Своё значение, если оно уже есть в окружении, не трогаем.
if [ -z "${TZ:-}" ] && [ -r /etc/TZ ]; then
    TZ=$(cat /etc/TZ 2>/dev/null)
    [ -n "$TZ" ] && export TZ
fi

NAME=d2k
DIR=${D2K_DIR:-/opt/d2k}
RELEASE=$DIR
# Контроллер и панель — независимые процессы на C. Управление панелью
# ограничено локальной loopback-привязкой и командами из фиксированного списка.
BIN=/opt/sbin/d2kc
PANELBIN=/opt/sbin/d2kpanel
PANEL_ASSETS=$RELEASE/panel
DPBIN=/opt/sbin/d2kd
CONF=$DIR/config
RUN=$DIR/run
LOG=$DIR/log

DP_PID=$RUN/d2kd.pid
CT_PID=$RUN/d2k.pid
PN_PID=$RUN/d2k-panel.pid
# Прежний прокси открытого HTTP (d2khttp, до задачи 51): его pid-файл и
# правила снимаются при остановке и запуске — миграция со старой версии.
HU_PID=$RUN/d2k-http.pid
HL_PID=$RUN/d2k-heal.pid
HEAL=$RELEASE/d2k-fw-heal.sh
LM_PID=$RUN/d2k-log-maintenance.pid
LOG_MAINTENANCE=$RELEASE/d2k-log-maintenance.sh
UPDATER=$RELEASE/d2k-update.sh
UPD_PID=$RUN/d2k-update.pid
SOCK=$RUN/d2kd.sock

# Собственные цепочки, по одной на направление. Не одна на оба: правило,
# лежащее в цепочке, вызываемой из двух мест, оценивается ДВАЖДЫ для одного
# пакета, и датапат видит его дважды. Здесь каждое направление ловится ровно
# в одном месте, и двойная выдача становится невозможной по построению.
#
# Где именно ловить — измерено на этапе 0, а не выбрано:
#   исходящее  POSTROUTING — видит и транзит, и собственные зонды роутера;
#   ответное   FORWARD     — в PREROUTING обратный NAT ещё не отработал и
#                            адрес клиента там не виден;
#              INPUT       — ответы собственным зондам: они идут не транзитом.
CHAIN_OUT=D2K_OUT
CHAIN_IN=D2K_IN

# Значения по умолчанию; конфигурация их перекрывает.
QUEUE_NUM=2000
PANEL_LISTEN=127.0.0.1:8090
STATE_DIR=$DIR/state
MARK=0x2d
# Controller probes must traverse NFQUEUE for exact trial Plans, while raw
# packets emitted by d2kd bypass it using MARK. Keep a distinct observable
# mark so d2kd can parse verifier traffic without rediscovering its own probes.
PROBE_MARK=0x2e
# Контроллерские измерения обходят собственный NFQUEUE. Точные проверки
# кандидата используют PROBE_MARK и специально идут через datapath.
MEASURE_MARK=0x2f
# Метка прежнего прокси открытого HTTP: только чтобы снять его правила при
# обновлении. Открытый HTTP теперь идёт ядром; вставку провайдера в первые
# пакеты HTTP-потока узнаёт и заменяет d2kd (задача 51).
HTTPUP_MARK=0x30
# Наблюдаем весь TCP/UDP трафик, а не только привычный HTTPS-порт. Протокол
# определяется разбором первых пакетов в d2kd; ограничение портом 443 теряло
# QUIC/DoT/нестандартные TLS и адресные потоки до того, как ядро могло выбрать
# собственный путь. connbytes ниже ограничивает только начальное окно каждого
# потока, а не охват портов.
PORTS=0:65535
CONNBYTES=0:8
# ГОЛОС ДИСКОРДА — порты боевого профиля discord_udp z2k (и эталона bol-van
# 50-discord-media для медиадиапазона 50000–50099). Узнаётся голос по первому
# пакету потока (IP Discovery), и в очередь идут только ПЕРВЫЕ пакеты: профиль
# z2k ставит фальшивку в первые четыре (--out-range=-d4), а медиапоток через
# очередь гнать нельзя вовсе — на MIPS он её захлёбывает.
VOICE_PORTS=50000:50099,1400,3478:3481,5349,19294:19344
VOICE_CONNBYTES=0:4
# ОТКРЫТЫЙ HTTP, KEEP-ALIVE (поле 04.10.2026, www.fast-torrent.ru): коробка
# смотрит КАЖДЫЙ запрос соединения, а второй запрос браузера лежит далеко за
# окном CONNBYTES. После окна в очередь идут только сегменты клиента на этот
# порт с флагом PSH — запросы, а не поток подтверждений; d2kd применяет к
# запросу на известной границе план его имени и пропускает остальное.
HTTP_KEEPALIVE_PORTS=80
MODE=apply
FLOWS=2048
# Период сводки датапата в журнал. Ноль выключает; без сводки нечем понять,
# видит ли служба трафик вообще.
STATS_SEC=900

# shellcheck disable=SC1090  # путь к конфигурации задан выше и постоянен
[ -r "$CONF" ] && . "$CONF"

# ПРАВИЛА — nftables НА OpenWrt, iptables НА Keenetic. В OpenWrt 25.12 пакетов
# iptables нет вовсе (07.10.2026: ни iptables-nft, ни -zz-legacy для aarch64,
# arm, mipsel, x86_64), а штатный firewall там — fw4 на nftables. Поэтому на
# OpenWrt правила ставятся своими таблицами nft, и Entware не нужен; прежняя
# установка с iptables из Entware при первом fw_up переходит на них же.
# FW_BACKEND=iptables|nft в конфигурации выбирает явно.
OPENWRT_RELEASE=${D2K_OPENWRT_RELEASE:-/etc/openwrt_release}
case "${FW_BACKEND:-auto}" in
    nft|iptables) ;;
    *)
        if [ -f "$OPENWRT_RELEASE" ] && command -v nft >/dev/null 2>&1; then
            FW_BACKEND=nft
        else
            FW_BACKEND=iptables
        fi ;;
esac
# d2kc ставит правило подавления RST сам (detect/raw.c) — тем же способом.
D2K_FW=$FW_BACKEND
export D2K_FW
# Frequent live snapshots are volatile. The learned catalog stays on /opt.
RUNTIME_DIR=${D2K_RUNTIME_DIR:-/tmp/d2k}
LIVE=$RUNTIME_DIR/live.json
# DNS and encrypted DNS are transport infrastructure, not strategy candidates.
# Keep standard DNS/DoT/DoQ ports out of the packet classifier even when PORTS
# is 0:65535; this does not alter resolver settings or DNS routing.
DNS_PORTS=53,853
TG_ENABLED=${TG_ENABLED:-0}
TG_PORT=${TG_PORT:-1443}
TGBIN=/opt/sbin/d2ktg
TG_PID=$RUN/d2ktg.pid
TG_STATUS=${TG_STATUS:-$STATE_DIR/telegram.status}
TG_FIREWALL=$RELEASE/d2k-tg-firewall.sh
TG_WATCHDOG=$RELEASE/d2k-tg-watchdog.sh
TG_WD_PID=$RUN/d2k-tg-watchdog.pid
DNS_SCHEDULER=$RELEASE/d2k-instagram-dns-scheduler.sh
DNS_SCHED_PID=$RUN/d2k-instagram-dns-scheduler.pid
TG_STATUS=${TG_STATUS:-$STATE_DIR/telegram.status}
unset TG_RELAY_SECRET TG_RELAY_URL TG_IDENTITY TG_CA_BUNDLE
FW_LOCK=${FW_LOCK:-/tmp/d2k-fw-operation.lock}
# Метка «IPv6 не обслуживается»: ip6tables mangle на этой прошивке нет
# (без компонента IPv6 или без ip6table_mangle). fw_installed тогда не ждёт
# IPv6-правил, а fw_down метку снимает.
FW_V4ONLY=$RUN/fw-ipv4-only
PROC_DIR=/proc

# Разгрузка окна рукопожатия от аппаратного ускорителя Keenetic (-j PPE с
# connskip): без неё поток уходит мимо netfilter, и d2k не видит ответов.
# Правила и их уборка — в d2k-ppe-deoffload.sh, здесь только вызовы. Нет
# файла — нет разгрузки, остальная служба работает как прежде.
# D2K_PPE_DEOFFLOAD=0 в конфигурации выключает её.
PPE_LIB=$RELEASE/d2k-ppe-deoffload.sh
# shellcheck disable=SC2034  # читает d2k-ppe-deoffload.sh
D2K_PPE_DPLOG=$LOG/d2kd.log
# shellcheck disable=SC2034
D2K_PPE_CONFIG=$CONF
# shellcheck disable=SC1090
[ -r "$PPE_LIB" ] && . "$PPE_LIB"

# Остаток прежней версии: живой d2khttp или его nat-перехват порта 80.
# Процесс узнаётся по имени, а не по одному pid: старый pid-файл мог
# пережить перезагрузку, и его номер уже у чужого процесса (ревью M3).
legacy_http_pid() {
    [ -f "$HU_PID" ] || return 1
    lpid=$(cat "$HU_PID" 2>/dev/null)
    case "$lpid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$(cat "$PROC_DIR/$lpid/comm" 2>/dev/null)" = d2khttp ] || return 1
    echo "$lpid"
}
legacy_http_present() {
    legacy_http_pid >/dev/null && return 0
    iptables -t nat -C PREROUTING -j D2K_HTTP 2>/dev/null && return 0
    return 1
}
legacy_http_stop() {
    if lpid=$(legacy_http_pid); then
        kill "$lpid" 2>/dev/null
        i=0
        while [ -d "$PROC_DIR/$lpid" ] && kill -0 "$lpid" 2>/dev/null && [ $i -lt 30 ]; do
            i=$((i + 1))
            sleep 0.1 2>/dev/null || sleep 1
        done
        kill -0 "$lpid" 2>/dev/null && kill -9 "$lpid" 2>/dev/null
    fi
    rm -f "$HU_PID"
}

say() { echo "$NAME: $*"; }
die() { echo "$NAME: $*" >&2; exit 1; }

running() {
    # Жив ли процесс, чей pid записан. Не «есть файл», а именно жив: файл
    # переживает SIGKILL, процесс — нет.
    [ -f "$1" ] || return 1
    pid=$(cat "$1" 2>/dev/null)
    [ -n "$pid" ] || return 1
    [ -d "$PROC_DIR/$pid" ] || return 1
    # Зомби мёртв. Демонов, запущенных обновлятором, усыновляет его
    # супервизор; пока он не собрал завершившегося потомка, тот висит зомби,
    # и остановка ждала бы его, добивала KILL и объявляла себя сорванной.
    [ "$(sed -n 's/^.*) \([A-Za-z]\).*/\1/p' "$PROC_DIR/$pid/stat" 2>/dev/null)" != Z ] || return 1
    return 0
}

# --- firewall ------------------------------------------------------------
#
# Своя цепочка в mangle, и переходы в неё из четырёх мест. Транзитный трафик
# идёт через POSTROUTING и FORWARD, собственные зонды — через OUTPUT и INPUT:
# зонд идёт С САМОГО роутера, и транзитные цепочки его не видят.

late_rst_from() {
    local late_rst_upper
    case "$CONNBYTES" in
        0:*) ;;
        *) return 1 ;;
    esac
    late_rst_upper=${CONNBYTES#0:}
    case "$late_rst_upper" in ''|*[!0-9]*) return 1 ;; esac
    [ "$late_rst_upper" -le 65535 ] || return 1
    echo $((late_rst_upper + 1))
}

# xt_addrtype есть не во всех прошивках (поле 03.10.2026: Keenetic mipsel
# 3.4_kn — «iptables: No chain/target/match by that name», служба не
# запускалась). Где модуля нет, те же исключения ставятся явными адресами.
# $1 — утилита, $2 — таблица, $3 — цепочка; печатает, каким способом встало.
fw_return_broadcast() {
    if "$1" -t "$2" -A "$3" -m addrtype --dst-type BROADCAST -j RETURN 2>/dev/null; then
        return 0
    fi
    say "в прошивке нет xt_addrtype: широковещательные адреса исключаю явным списком"
    "$1" -t "$2" -A "$3" -d 255.255.255.255 -j RETURN || return 1
    for b in $(ip -4 addr show 2>/dev/null | awk '$1 == "inet" { for (i = 1; i < NF; i++) if ($i == "brd") print $(i + 1) }' | sort -u); do
        "$1" -t "$2" -A "$3" -d "$b" -j RETURN || return 1
    done
}
fw_return_local() {
    if "$1" -t "$2" -A "$3" -m addrtype --dst-type LOCAL -j RETURN 2>/dev/null; then
        return 0
    fi
    say "в прошивке нет xt_addrtype: собственные адреса роутера исключаю явным списком"
    for a in $(ip -4 addr show 2>/dev/null | awk '$1 == "inet" { sub(/\/.*/, "", $2); print $2 }' | sort -u); do
        "$1" -t "$2" -A "$3" -d "$a" -j RETURN || return 1
    done
}

# ICMP «ВРЕМЯ ЖИЗНИ ИСТЕКЛО» (IPv4 11/0, ICMPv6 3/0) — к клиенту (FORWARD) и
# к роутеру (INPUT). Фальшивка плана с пониженным TTL умирает на узле по пути,
# узел отвечает time-exceeded, а NAT отдаёт его клиенту по кортежу его же
# потока. Поле 04.10.2026 (KN-1811, icmp-rua.pcap): Safari по такому ICMP
# закрывал UDP-сокет QUIC, страница не открывалась. d2kd снимает ТОЛЬКО ответ
# на собственную фальшивку (цитата — ровно её кортеж, длина, ID/номер),
# остальное (traceroute, чужие потоки) — ACCEPT. PMTU (frag needed, packet
# too big) и прочие ICMP в очередь не попадают вовсе. --queue-bypass: без
# d2kd ICMP идёт как без d2k. $1 — утилита, $2 — -A или -C.
fw_icmp_te_rule() {
    if [ "$1" = iptables ]; then
        "$1" -t mangle "$2" "$CHAIN_IN" -p icmp --icmp-type 11/0 \
            -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass
    else
        "$1" -t mangle "$2" "$CHAIN_IN" -p ipv6-icmp --icmpv6-type 3/0 \
            -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass
    fi
}

fw_family_up() (
    fw_tool=$1
    loopback=127.0.0.0/8
    [ "$fw_tool" != ip6tables ] || loopback=::1/128
    local late_from
    late_from=$(late_rst_from) || return 1

    # Код 3 — таблица mangle этого семейства непригодна вовсе (нет утилиты,
    # нет таблицы): для IPv6 это не отказ, а работа только по IPv4.
    command -v "$fw_tool" >/dev/null 2>&1 || return 3
    # Отказ создать цепочку при живой таблице (её список читается, -w ждёт
    # замок xtables) — обычная ошибка, а не отсутствие семейства.
    if ! "$fw_tool" -t mangle -N "$CHAIN_OUT" 2>/dev/null; then
        "$fw_tool" -w -t mangle -n -L POSTROUTING >/dev/null 2>&1 && return 1
        return 3
    fi
    "$fw_tool" -t mangle -N "$CHAIN_IN"  2>/dev/null || return 1

    # Keenetic's DNS proxy talks to local encrypted-DNS helpers on dynamic
    # loopback ports. That IPC is not internet traffic and must not be queued.
    for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$fw_tool" -t mangle -A "$chain" -s $loopback -j RETURN || return 1
        "$fw_tool" -t mangle -A "$chain" -d $loopback -j RETURN || return 1
    done

    # Broadcast and multicast never enter the queue: there is no NAT clash to
    # cure and no plan for them, and a raw re-send to a broadcast address is
    # refused (EACCES; field 03.10.2026, router-local 192.168.1.255:3517/3518
    # and the like). The router's own unicast UDP stays queued: the Telegram
    # tunnel and controller probes may need d2k. Before every NFQUEUE jump.
    if [ "$fw_tool" = iptables ]; then
        fw_return_broadcast "$fw_tool" mangle "$CHAIN_OUT" || return 1
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -d 224.0.0.0/4 -j RETURN || return 1
    else
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -d ff00::/8 -j RETURN || return 1
    fi

    # Собственные сырые посылки датапата и измерительные запросы контроллера
    # исключаются. Активные verifier-зонды
    # контроллера помечаются отдельным PROBE_MARK: им нужно попасть в очередь,
    # чтобы точный trial Plan достался verifier; d2kd разбирает их, но не
    # порождает из них новое обнаружение.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -m mark --mark "$MARK" -j RETURN || return 1
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -m mark --mark "$MEASURE_MARK" -j RETURN || return 1
    # Never queue DNS (UDP/TCP 53) or encrypted DNS (DoT/DoQ, 853). These
    # packets are required for ordinary connectivity and are not useful
    # strategy inputs. Place exclusions before the broad TCP/UDP NFQUEUE rules.
    for proto in tcp udp; do
        "$fw_tool" -t mangle -A "$CHAIN_OUT" -p "$proto" -m multiport --dports "$DNS_PORTS" \
            -j RETURN || return 1
        "$fw_tool" -t mangle -A "$CHAIN_IN" -p "$proto" -m multiport --sports "$DNS_PORTS" \
            -j RETURN || return 1
    done

    # --queue-bypass обязателен: смерть службы должна ПРОПУСКАТЬ трафик, а не
    # останавливать его (§10). Это касается и UDP-правил ниже в той же мере,
    # что и TCP: без --queue-bypass там остановка датапата обрывает весь QUIC
    # в сети, а не просто перестаёт его обрабатывать.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir original \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Если браузер сам сбрасывает зависший ответ после окна первых пакетов,
    # пропускаем в датапат только RST — payload большого потока не ставится
    # в очередь. Датапат поднимет volume-пару только если до этого видел TLS
    # app-data; один RST диагнозом или основанием для перебора не является.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Поздний RST — редкий, узкий сигнал для ответа, оборванного уже после
    # TLS app-data. Его надо видеть и ПОСЛЕ окна первых восьми пакетов, но не
    # ставить весь ответ в очередь. Правило ограничено трафиком за пределом
    # прежнего окна; ранние RST по-прежнему ловит обычная очередь ниже.
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # FIN без ответа тоже может повторяться после оборванного тела. Очередь
    # получает только закрывающие пакеты, не всю нагрузку. Первый FIN не
    # вызывает замер; повтор того же FIN без ответа (с планом и без) допускает
    # только узкую RX-пару, без плана — после второго такого потока за 30 с.
    # FIN сервера здесь же отпускает запись потока при обычном закрытии.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    # Следующие запросы соединения открытого HTTP (keep-alive): сегменты
    # клиента с PSH за окном. Чистые подтверждения загрузки PSH не несут и в
    # очередь не идут; запрос без PSH d2kd увидит как потерянную границу и
    # дальше пропустит поток как есть.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$HTTP_KEEPALIVE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags PSH PSH -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir reply \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1

    # То же самое для UDP (задача 4: датапат видит QUIC поверх UDP 443).
    # CONNBYTES с тем же порогом, что у TCP, — не для симметрии ради
    # симметрии: D2K_HELLO_WINDOW в session.c ограничивает разбор QUIC
    # ровно тем же числом первых датаграмм потока, так что очередь ничего не
    # выигрывает, продолжая получать пакеты сверх этого окна.
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir original \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p udp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$CONNBYTES" --connbytes-dir reply \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1

    # Голос: первые пакеты туда (IP Discovery и повторы — по ним датапат
    # узнаёт голос и приговаривает «молчат») и первые оттуда (ответ сервера —
    # единственное подтверждение приёма голоса: зонда у голоса нет).
    "$fw_tool" -t mangle -A "$CHAIN_OUT" -p udp -m conntrack --ctdir ORIGINAL -m multiport --dports "$VOICE_PORTS" \
        -m connbytes --connbytes "$VOICE_CONNBYTES" --connbytes-dir original \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1
    "$fw_tool" -t mangle -A "$CHAIN_IN" -p udp -m conntrack --ctdir REPLY -m multiport --sports "$VOICE_PORTS" \
        -m connbytes --connbytes "$VOICE_CONNBYTES" --connbytes-dir reply \
        --connbytes-mode packets \
        -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || return 1

    fw_icmp_te_rule "$fw_tool" -A || return 1

    # СВОИ ПОСЫЛКИ ПО UDP — ЧЕРЕЗ MASQUERADE, и это не симметрия ради
    # симметрии, а разница между TCP и QUIC, замеренная на живом роутере
    # 13.09.2026.
    #
    # Датапат вклинивает пакеты сырым сокетом с адресами ИЗ ОЧЕРЕДИ, то есть
    # с ЛОКАЛЬНЫМ адресом клиента: очередь висит на mangle POSTROUTING, а
    # SNAT делается позже. Правильным внешним адресом такой пакет становится
    # ровно одним способом — попадая в ту же запись conntrack, что и поток
    # клиента.
    #
    #   TCP: приветствие — третий пакет соединения, запись давно есть, наши
    #        посылки попадают в неё сами. Ничего делать не нужно.
    #   QUIC: первая же датаграмма и ЕСТЬ приветствие, а запись подтверждается
    #        в конце прохода ЭТОГО пакета — в момент наших посылок её ещё нет
    #        ни при каком исправном ядре. Без правила ниже они уходят с
    #        локальным адресом и умирают у провайдера: замерено tcpdump на
    #        ppp0 (192.168.1.117 вместо 88.87.93.11).
    #
    # Правило создаёт трансляцию НАШЕЙ первой посылкой, а оригинал клиента,
    # идущий следом тем же кортежем, попадает в неё же — на проводе они
    # неотличимы. Только UDP: для TCP то же правило не нужно, а проверять
    # непроверенное на живой линии нельзя.
    [ "$fw_tool" != iptables ] || "$fw_tool" -t nat -A POSTROUTING -p udp -m mark --mark "$MARK" \
        -j MASQUERADE || say "не поставить MASQUERADE для своих посылок — QUIC за роутером не пойдёт"

    "$fw_tool" -t mangle -I POSTROUTING -j "$CHAIN_OUT" || return 1
    "$fw_tool" -t mangle -I FORWARD     -j "$CHAIN_IN"  || return 1
    "$fw_tool" -t mangle -I INPUT       -j "$CHAIN_IN"  || return 1
    return 0
)

# Порядок опирается на то, что -j PPE НЕ завершает цепочку: замер на KN-1811
# 02.10.2026 — правило-счётчик с тем же совпадением сразу после -j PPE
# насчитало 788 из 788 пакетов и в FORWARD, и в PREROUTING; с PPE с первого
# пакета поток оставался виден целиком. Окажись цель завершающей, переход в
# D2K_IN ниже не получил бы ни одного пакета окна.
#
# Разгрузка ставится ПОСЛЕ переходов в цепочки d2k: -I кладёт её в начало
# FORWARD, выше перехода в D2K_IN. Пакет, отданный в NFQUEUE, до правил ниже
# по цепочке не доходит, и разгрузка под очередью не сработала бы для
# ответов в окне. Её отказ не отменяет правил очереди: без неё d2k видит
# хуже, но работает, как до неё.
ppe_up() {
    command -v d2k_ppe_ensure >/dev/null 2>&1 || return 0
    d2k_ppe_ensure
    case $? in
        0) ;;
        2) say "разгрузка PPE не ставится: в прошивке нет цели PPE" ;;
        3) say "разгрузка PPE выключена владельцем (D2K_PPE_DEOFFLOAD=0)" ;;
        *) say "разгрузка PPE встала не целиком — ответы под ускорителем могут быть не видны" ;;
    esac
    return 0
}

ppe_down() {
    command -v d2k_ppe_remove >/dev/null 2>&1 || return 0
    d2k_ppe_remove
}

# Без IPv4 работы нет. Без ip6tables mangle (код 3) служба работает по
# IPv4 и предупреждает: IPv6-трафик идёт мимо d2k, как без него. Любой иной
# отказ IPv6 — настоящая ошибка, и fw_up откатывает оба семейства.
fw_up_unlocked() {
    fw_family_up iptables || return 1
    rc6=0
    fw_family_up ip6tables || rc6=$?
    case $rc6 in
        0) rm -f "$FW_V4ONLY" ;;
        3)
            fw_family_down ip6tables
            { mkdir -p "$RUN" && : > "$FW_V4ONLY"; } || return 1
            say "ВНИМАНИЕ: ip6tables mangle недоступна (нет IPv6 в прошивке или модуля ip6table_mangle) — d2k работает только по IPv4, IPv6-трафик идёт без обработки"
            ;;
        *) return 1 ;;
    esac
    ppe_up
}

fw_family_down() (
    fw_tool=$1
    while "$fw_tool" -t nat -D PREROUTING -j D2K_HTTP 2>/dev/null; do :; done
    if "$fw_tool" -t nat -n -L D2K_HTTP >/dev/null 2>&1; then
        "$fw_tool" -t nat -F D2K_HTTP 2>/dev/null
        "$fw_tool" -t nat -X D2K_HTTP 2>/dev/null
    fi
    # Своё правило в nat снимается по тем же признакам, по которым ставилось.
    while "$fw_tool" -t nat -D POSTROUTING -p udp -m mark --mark "$MARK" \
        -j MASQUERADE 2>/dev/null; do :; done
    while "$fw_tool" -t mangle -D OUTPUT -m mark --mark "$HTTPUP_MARK" \
        -j CONNMARK --save-mark 2>/dev/null; do :; done
    while "$fw_tool" -t mangle -D OUTPUT -j D2K_HTTP_MARK 2>/dev/null; do :; done
    if "$fw_tool" -t mangle -n -L D2K_HTTP_MARK >/dev/null 2>&1; then
        "$fw_tool" -t mangle -F D2K_HTTP_MARK 2>/dev/null
        "$fw_tool" -t mangle -X D2K_HTTP_MARK 2>/dev/null
    fi
    for hook in POSTROUTING FORWARD OUTPUT INPUT; do
        for ch in "$CHAIN_OUT" "$CHAIN_IN"; do
            while "$fw_tool" -t mangle -D "$hook" -j "$ch" 2>/dev/null; do :; done
        done
    done
    for ch in "$CHAIN_OUT" "$CHAIN_IN"; do
        if "$fw_tool" -t mangle -n -L "$ch" >/dev/null 2>&1; then
            "$fw_tool" -t mangle -F "$ch" 2>/dev/null
            "$fw_tool" -t mangle -X "$ch" 2>/dev/null
        fi
    done
)

fw_iptables_down() {
    ppe_down
    for fw_tool in iptables ip6tables; do
        command -v "$fw_tool" >/dev/null 2>&1 && fw_family_down "$fw_tool"
    done
    rm -f "$FW_V4ONLY"
}

# --- nftables (OpenWrt) ----------------------------------------------------
#
# Те же правила, что у iptables выше, тем же порядком — в СВОЕЙ таблице inet
# d2k: оба семейства сразу, и снимается она целиком, без разбора по правилу.
# fw4 чужие таблицы не трогает: таблица переживает firewall restart и fw4
# reload (проверено 07.10.2026 на 25.12.5). Всё проверено nft -f на 25.12.5.
#
#   out      ← mangle POSTROUTING  (hook postrouting priority mangle)
#   in_rules ← D2K_IN, в неё переходят in_forward и in_input
#   nat_post ← nat POSTROUTING: MASQUERADE своих UDP, только IPv4, как выше
#
# multiport → множество портов, connbytes → ct <направление> packets,
# addrtype BROADCAST → fib daddr type broadcast. Таблица ставится одной
# транзакцией nft -f: прежняя удаляется в той же транзакции — окна без правил
# нет, и при отказе остаётся прежняя.
#
# Подавление RST зондами d2kc — ОТДЕЛЬНАЯ таблица inet d2k_rst: пересборка
# inet d2k (сторож, reapply) не должна снимать его у идущего зонда. Элементы
# с таймаутом ставит и снимает сам d2kc (detect/raw.c); после kill -9 элемент
# истекает сам, уборка по владельцу не нужна.
NFT_TABLE=d2k
NFT_RST_TABLE=d2k_rst
NFT_PACKETS_MAX=18446744073709551615

# "a:b,c" (порты iptables) → "a-b, c".
nft_list() { printf '%s' "$1" | sed -e 's/:/-/g' -e 's/,/, /g'; }
# connbytes "A:B" → "A-B", открытое "A:" → "A-<максимум счётчика>".
# Нижняя граница 0 становится 1. У потока без расширения учёта (создан при
# nf_conntrack_acct=0, до загрузки таблицы — её ct packets включает учёт лишь
# для новых) nft читает счётчик как 0, а connbytes такой поток не берёт вовсе:
# окно 0-N держало бы его в очереди всю жизнь (ревью 07.10). Учтённый пакет к
# хукам mangle уже посчитан conntrack (приоритет -200), счётчик ≥ 1 — для
# учтённых потоков 1-N и 0:N совпадают.
nft_count() {
    case "$1" in
        *:) printf '%s-%s' "${1%:}" "$NFT_PACKETS_MAX" ;;
        0:*) printf '1-%s' "${1#0:}" ;;
        *) printf '%s' "$1" | tr ':' '-' ;;
    esac
}

nft_ruleset() (
    late=$(late_rst_from) || exit 1
    late=$(nft_count "$late:")
    win=$(nft_count "$CONNBYTES")
    ports=$(nft_list "$PORTS")
    dns=$(nft_list "$DNS_PORTS")
    voice=$(nft_list "$VOICE_PORTS")
    voicewin=$(nft_count "$VOICE_CONNBYTES")
    q="queue num $QUEUE_NUM bypass"
    cat <<EOF
table inet $NFT_TABLE {
	chain out {
		type filter hook postrouting priority mangle; policy accept;
		ip saddr 127.0.0.0/8 return
		ip daddr 127.0.0.0/8 return
		ip6 saddr ::1 return
		ip6 daddr ::1 return
		meta nfproto ipv4 fib daddr type broadcast return
		ip daddr 224.0.0.0/4 return
		ip6 daddr ff00::/8 return
		meta mark $MARK return
		meta mark $MEASURE_MARK return
		meta l4proto { tcp, udp } th dport { $dns } return
		meta l4proto tcp ct direction original th dport { $ports } ct original packets $win $q
		meta l4proto tcp ct direction original th dport { $ports } ct original packets $late tcp flags & rst == rst $q
		meta l4proto tcp ct direction original th dport { $ports } ct original packets $late tcp flags & fin == fin $q
		meta l4proto tcp ct direction original th dport { $(nft_list "$HTTP_KEEPALIVE_PORTS") } ct original packets $late tcp flags & psh == psh $q
		meta l4proto udp ct direction original th dport { $ports } ct original packets $win $q
		meta l4proto udp ct direction original th dport { $voice } ct original packets $voicewin $q
	}
	chain in_rules {
		ip saddr 127.0.0.0/8 return
		ip daddr 127.0.0.0/8 return
		ip6 saddr ::1 return
		ip6 daddr ::1 return
		meta l4proto { tcp, udp } th sport { $dns } return
		meta l4proto tcp ct direction reply th sport { $ports } ct reply packets $late tcp flags & rst == rst $q
		meta l4proto tcp ct direction reply th sport { $ports } ct reply packets $late tcp flags & fin == fin $q
		meta l4proto tcp ct direction reply th sport { $ports } ct reply packets $win $q
		meta l4proto udp ct direction reply th sport { $ports } ct reply packets $win $q
		meta l4proto udp ct direction reply th sport { $voice } ct reply packets $voicewin $q
		icmp type time-exceeded icmp code 0 $q
		icmpv6 type time-exceeded icmpv6 code 0 $q
	}
	chain in_forward {
		type filter hook forward priority mangle; policy accept;
		jump in_rules
	}
	chain in_input {
		type filter hook input priority mangle; policy accept;
		jump in_rules
	}
	chain nat_post {
		type nat hook postrouting priority srcnat - 1; policy accept;
		meta nfproto ipv4 meta l4proto udp meta mark $MARK masquerade
	}
}
EOF
)

nft_rst_ruleset() {
    cat <<EOF
table inet $NFT_RST_TABLE {
	set rst4 { type inet_service; flags timeout; }
	set rst6 { type inet_service; flags timeout; }
	chain out {
		type filter hook output priority filter - 1; policy accept;
		meta nfproto ipv4 tcp sport @rst4 tcp flags & rst == rst drop
		meta nfproto ipv6 tcp sport @rst6 tcp flags & rst == rst drop
	}
}
EOF
}

nft_has() { nft list table inet "$1" >/dev/null 2>&1; }

fw_nft_up() {
    mkdir -p "$RUN" || return 1
    (
        ! nft_has "$NFT_TABLE" || echo "delete table inet $NFT_TABLE"
        nft_ruleset || exit 1
        nft_has "$NFT_RST_TABLE" || nft_rst_ruleset
    ) > "$RUN/fw.nft" || return 1
    nft -f "$RUN/fw.nft"
}

fw_nft_installed() (
    listed=$(nft list table inet "$NFT_TABLE" 2>/dev/null) || return 1
    nft_has "$NFT_RST_TABLE" || return 1
    for chain in out in_rules in_forward in_input nat_post; do
        printf '%s\n' "$listed" | grep -q "chain $chain {" || return 1
    done
    printf '%s\n' "$listed" | grep -q masquerade || return 1
    # nft печатает правило по-своему («queue flags bypass to 2000»), поэтому
    # сверяется число правил очереди с bypass и своим номером очереди.
    want=$(nft_ruleset | grep -c queue) || return 1
    got=$(printf '%s\n' "$listed" | grep queue | grep bypass | grep -cw -- "$QUEUE_NUM")
    [ "$got" -eq "$want" ]
)

fw_down_unlocked() {
    fw_iptables_down
    if command -v nft >/dev/null 2>&1 && nft_has "$NFT_TABLE"; then
        nft delete table inet "$NFT_TABLE" || return 1
    fi
    return 0
}

# ПРАВИЛА ПОДАВЛЕНИЯ RST. d2kc и d2k-detect на время зонда ставят в filter
# OUTPUT правило «-p tcp --sport P --tcp-flags RST RST -m comment --comment
# d2k-rst:PID -j DROP» и снимают его сами; процесс, убитый сигналом KILL,
# оставляет его висеть. Снимаются только правила этой точной формы с портом
# зонда (30000-54999), как их опознаёт detect/raw.c:
#   dead — владелец мёртв (остановка движка: живой поиск панели сохраняет своё);
#   all  — ещё и владелец-процесс d2k (остановка службы, удаление).
rst_owner_removable() {
    kill -0 "$1" 2>/dev/null || return 0
    [ "$2" = all ] || return 1
    case "$(cat "$PROC_DIR/$1/comm" 2>/dev/null)" in d2k*) return 0 ;; esac
    return 1
}

rst_rules_down() {
    # nft: элементы зондов истекают сами; при остановке службы таблица
    # снимается целиком, при остановке движка живой поиск сохраняет своё.
    if [ "$1" = all ] && command -v nft >/dev/null 2>&1 && nft_has "$NFT_RST_TABLE"; then
        nft delete table inet "$NFT_RST_TABLE" 2>/dev/null || true
    fi
    for fw_tool in iptables ip6tables; do
        command -v "$fw_tool" >/dev/null 2>&1 || continue
        rules=$("$fw_tool" -w -S OUTPUT 2>/dev/null || "$fw_tool" -S OUTPUT 2>/dev/null) || continue
        printf '%s\n' "$rules" | sed -n \
            's/^-A OUTPUT -p tcp \(-m tcp \)\{0,1\}--sport \([0-9][0-9]*\) --tcp-flags RST RST -m comment --comment "\{0,1\}d2k-rst:\([1-9][0-9]*\)"\{0,1\} -j DROP *$/\2 \3/p' |
        while read -r port owner; do
            [ "$port" -ge 30000 ] && [ "$port" -le 54999 ] || continue
            rst_owner_removable "$owner" "$1" || continue
            "$fw_tool" -w -D OUTPUT -p tcp --sport "$port" --tcp-flags RST RST \
                -m comment --comment "d2k-rst:$owner" -j DROP 2>/dev/null ||
            "$fw_tool" -D OUTPUT -p tcp --sport "$port" --tcp-flags RST RST \
                -m comment --comment "d2k-rst:$owner" -j DROP 2>/dev/null || true
        done
    done
}

# Сторож: вернуть снесённую разгрузку, не трогая правил очереди. Под тем же
# замком, что fw_up, — иначе вставка может лечь между снятием и постановкой.
ppe_ensure() {
    [ "$FW_BACKEND" = iptables ] || return 0
    command -v d2k_ppe_ensure >/dev/null 2>&1 || return 0
    running "$DP_PID" || return 0
    fw_lock_acquire || return 1
    d2k_ppe_ensure
    rc=$?
    fw_lock_release || return 1
    case $rc in 0|2|3) return 0 ;; *) return 1 ;; esac
}

fw_lock_acquire() {
    local attempt owner
    attempt=0
    while ! mkdir "$FW_LOCK" 2>/dev/null; do
        owner=$(cat "$FW_LOCK/pid" 2>/dev/null)
        case "$owner" in
            ''|*[!0-9]*) ;;
            *)
                if ! kill -0 "$owner" 2>/dev/null; then
                    rm -f "$FW_LOCK/pid" 2>/dev/null
                    rmdir "$FW_LOCK" 2>/dev/null
                    continue
                fi ;;
        esac
        [ "$attempt" -lt 300 ] || return 1
        attempt=$((attempt + 1))
        sleep 0.1 2>/dev/null || sleep 1
    done
    printf '%s\n' "$$" > "$FW_LOCK/pid" || { rmdir "$FW_LOCK"; return 1; }
}

fw_lock_release() {
    [ "$(cat "$FW_LOCK/pid" 2>/dev/null)" = "$$" ] || return 1
    rm -f "$FW_LOCK/pid"
    rmdir "$FW_LOCK"
}

fw_up() {
    local rc
    fw_lock_acquire || return 1
    if [ "$FW_BACKEND" = nft ]; then
        # Остатки iptables (установка времён Entware) снимаются; таблица nft
        # заменяется своей транзакцией, без окна без правил.
        fw_iptables_down
        if fw_nft_up; then
            rc=0
        else
            say "nft не принял правила — см. $RUN/fw.nft"
            fw_down_unlocked
            rc=1
        fi
    else
        fw_down_unlocked
        if fw_up_unlocked; then
            rc=0
        else
            fw_down_unlocked
            rc=1
        fi
    fi
    fw_lock_release || return 1
    return "$rc"
}

fw_down() {
    local rc
    fw_lock_acquire || return 1
    fw_down_unlocked
    rc=$?
    fw_lock_release || return 1
    return "$rc"
}

fw_family_installed() (
    fw_tool=$1
    loopback=127.0.0.0/8
    [ "$fw_tool" != ip6tables ] || loopback=::1/128
    local late_from
    late_from=$(late_rst_from) || return 1
    # A jump into an empty chain does not send a single packet to d2kd.
    # Check the complete contract, including reply traffic and bypass. -C
    # is supported by the target's iptables 1.4.21 (verified 12.09).
    for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
        "$fw_tool" -t mangle -C "$chain" -s $loopback -j RETURN 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$chain" -d $loopback -j RETURN 2>/dev/null || return 1
    done
    if [ "$fw_tool" = iptables ]; then
        { "$fw_tool" -t mangle -C "$CHAIN_OUT" -m addrtype --dst-type BROADCAST \
              -j RETURN 2>/dev/null ||
          "$fw_tool" -t mangle -C "$CHAIN_OUT" -d 255.255.255.255 -j RETURN 2>/dev/null; } || return 1
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -d 224.0.0.0/4 -j RETURN 2>/dev/null || return 1
    else
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -d ff00::/8 -j RETURN 2>/dev/null || return 1
    fi
    "$fw_tool" -t mangle -C POSTROUTING -j "$CHAIN_OUT" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C FORWARD -j "$CHAIN_IN" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C INPUT -j "$CHAIN_IN" 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -m mark --mark "$MARK" -j RETURN 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -m mark --mark "$MEASURE_MARK" -j RETURN 2>/dev/null || return 1
    for proto in tcp udp; do
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -p "$proto" -m multiport --dports "$DNS_PORTS" \
            -j RETURN 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$CHAIN_IN" -p "$proto" -m multiport --sports "$DNS_PORTS" \
            -j RETURN 2>/dev/null || return 1
    done
    for proto in tcp udp; do
        "$fw_tool" -t mangle -C "$CHAIN_OUT" -p "$proto" -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
            -m connbytes --connbytes "$CONNBYTES" --connbytes-dir original \
            --connbytes-mode packets -j NFQUEUE --queue-num "$QUEUE_NUM" \
            --queue-bypass 2>/dev/null || return 1
        "$fw_tool" -t mangle -C "$CHAIN_IN" -p "$proto" -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
            -m connbytes --connbytes "$CONNBYTES" --connbytes-dir reply \
            --connbytes-mode packets -j NFQUEUE --queue-num "$QUEUE_NUM" \
            --queue-bypass 2>/dev/null || return 1
    done
    fw_icmp_te_rule "$fw_tool" -C 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags RST RST -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_IN" -p tcp -m conntrack --ctdir REPLY -m multiport --sports "$PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir reply --connbytes-mode packets \
        --tcp-flags FIN FIN -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    "$fw_tool" -t mangle -C "$CHAIN_OUT" -p tcp -m conntrack --ctdir ORIGINAL -m multiport --dports "$HTTP_KEEPALIVE_PORTS" \
        -m connbytes --connbytes "$late_from": --connbytes-dir original --connbytes-mode packets \
        --tcp-flags PSH PSH -j NFQUEUE --queue-num "$QUEUE_NUM" \
        --queue-bypass 2>/dev/null || return 1
    [ "$fw_tool" != iptables ] || "$fw_tool" -t nat -C POSTROUTING -p udp -m mark --mark "$MARK" \
        -j MASQUERADE 2>/dev/null || return 1
    return 0
)

fw_installed() {
    [ "$FW_BACKEND" != nft ] || { fw_nft_installed; return; }
    fw_family_installed iptables || return 1
    [ -f "$FW_V4ONLY" ] || fw_family_installed ip6tables
}

# --- запуск --------------------------------------------------------------

# УСКОРИТЕЛЬ NAT ВЫКЛЮЧАЕТСЯ НА ВРЕМЯ РАБОТЫ, и это не «оптимизация наоборот».
#
# При nf_conntrack_fastnat=1 транзитные потоки ведёт ускоритель, МИМО
# conntrack: записи о потоке в таблице нет вовсе. А датапату она нужна не для
# счёта, а чтобы узнать, каким адресом поток виден серверу: очередь висит на
# mangle POSTROUTING, где у транзитного пакета ещё локальный адрес клиента, и
# посылки плана, собранные с ним, уходят в никуда (см. d2k_nat.h).
#
# Замерено на живом роутере 13.09.2026: с включённым ускорителем обход
# работал ТОЛЬКО для трафика самого роутера, а любое устройство за ним
# получало ноль — при том, что собственный зонд на той же цели отвечал 200.
#
# Прежнее значение запоминается и возвращается при остановке: чужую настройку
# менять навсегда мы не вправе.
FASTNAT=/proc/sys/net/netfilter/nf_conntrack_fastnat
FASTNAT_SAVED=$RUN/fastnat.saved

fastnat_off() {
    [ -w "$FASTNAT" ] || return 0
    cat "$FASTNAT" > "$FASTNAT_SAVED" 2>/dev/null
    echo 0 > "$FASTNAT" 2>/dev/null
    [ "$(cat "$FASTNAT" 2>/dev/null)" = "0" ] || \
        say "не удалось выключить ускоритель NAT — обхода за роутером не будет"
}

fastnat_restore() {
    [ -w "$FASTNAT" ] || return 0
    [ -f "$FASTNAT_SAVED" ] || return 0
    cat "$FASTNAT_SAVED" > "$FASTNAT" 2>/dev/null
    rm -f "$FASTNAT_SAVED"
}

prepare_runtime() {
    [ ! -L "$RUNTIME_DIR" ] || die "runtime directory must not be a symlink"
    if ! (umask 077; mkdir -p "$RUNTIME_DIR") || ! chmod 0700 "$RUNTIME_DIR"; then
        die "не создать приватный $RUNTIME_DIR"
    fi
}

spawn_daemon() (
    exec 3>&- 4>&- 5>&-
    exec start-stop-daemon "$@"
)

start_log_maintenance() {
    mkdir -p "$RUN" "$LOG" || return 1
    if [ -x "$LOG_MAINTENANCE" ] && ! running "$LM_PID"; then
        spawn_daemon -S -b -m -p "$LM_PID" -x "$LOG_MAINTENANCE" -- run \
            || say "ротация журналов не запустилась"
    fi
}

# МОДУЛИ ЯДРА. На Keenetic модули Netfilter лежат в прошивке файлами
# /lib/modules/<ядро>/*.ko, но сами не загружаются: modprobe из Entware ищет
# в /opt/lib/modules, которого там нет (опыт z2k, lib/utils.sh). Поле
# 03.10.2026, Keenetic mipsel: xt_addrtype/xt_comment не загружены — служба не
# стартовала. Загружаем сами; отсутствие модуля — не отказ здесь: правило,
# которому он нужен, либо имеет запасной путь, либо назовёт себя при отказе.
MODULES_DIR=${D2K_MODULES_DIR:-/lib/modules}
# nf_conntrack_netlink: счётчики потока по кортежу для детектора тишины QUIC
# (d2kd); без него детектор выключен, остальное работает.
SYS_MODULE_DIR=${D2K_SYS_MODULE_DIR:-/sys/module}
D2K_MODULES="nfnetlink_queue xt_NFQUEUE xt_conntrack xt_connbytes xt_multiport xt_mark xt_connmark xt_CONNMARK xt_addrtype xt_comment ip6table_mangle nf_conntrack_netlink"
# nft сам подгружает модули выражений; очередь и ctnetlink — отдельные модули.
[ "$FW_BACKEND" != nft ] || D2K_MODULES="nfnetlink_queue nft_queue nf_conntrack_netlink"
module_present() {
    case "$1" in
        xt_NFQUEUE|xt_CONNMARK)
            grep -qw "${1#xt_}" "$PROC_DIR/net/ip_tables_targets" 2>/dev/null && return 0 ;;
        nfnetlink_queue) [ -e "$PROC_DIR/net/netfilter/nfnetlink_queue" ] && return 0 ;;
        ip6table_mangle) grep -qw mangle "$PROC_DIR/net/ip6_tables_names" 2>/dev/null && return 0 ;;
        xt_*) grep -qw "${1#xt_}" "$PROC_DIR/net/ip_tables_matches" 2>/dev/null && return 0 ;;
    esac
    # Встроенный в ядро модуль в lsmod не виден, но есть в /sys/module.
    [ -d "$SYS_MODULE_DIR/$1" ] && return 0
    lsmod 2>/dev/null | grep -q "^$1 "
}
load_modules() {
    kver=$(uname -r 2>/dev/null)
    for m in $D2K_MODULES; do
        module_present "$m" && continue
        modprobe "$m" 2>/dev/null && module_present "$m" && continue
        ko=
        for d in "$MODULES_DIR/$kver" "$MODULES_DIR"; do
            [ -f "$d/$m.ko" ] && { ko="$d/$m.ko"; break; }
        done
        [ -n "$ko" ] || ko=$(find "$MODULES_DIR" -name "$m.ko" -type f 2>/dev/null | head -1)
        if [ -n "$ko" ] && insmod "$ko" 2>/dev/null; then
            say "загружен модуль ядра $m"
        fi
    done
}

start_engine() {
    [ "$MODE" = "off" ] && { say "MODE=off — запуск запрещён"; return 1; }
    [ -x "$DPBIN" ] || die "нет $DPBIN"
    [ -x "$BIN" ] || die "нет $BIN"

    mkdir -p "$RUN" "$LOG" "$DIR/state" || die "не создать $RUN"
    prepare_runtime
    start_log_maintenance

    if running "$DP_PID"; then
        if running "$CT_PID" && fw_installed && \
            ! legacy_http_present && \
            { [ ! -x "$HEAL" ] || running "$HL_PID"; }; then
            say "движок уже запущен полностью"
            return 0
        fi
        say "обнаружен частичный запуск — восстанавливаю весь движок"
        engine_stop || return 1
    else
        # Контроллер может пережить упавший datapath и продолжать писать
        # ложное live-состояние. Перед чистым запуском убираем весь остаток.
        engine_stop || return 1
    fi

    # Файл сокета переживает SIGKILL и мешает следующему запуску.
    rm -f "$SOCK"

    dpmode=observe
    [ "$MODE" = "apply" ] && dpmode=apply
    [ "$PROBE_MARK" != "$MARK" ] || die "PROBE_MARK должен отличаться от MARK"
    [ "$MEASURE_MARK" != "$MARK" ] && [ "$MEASURE_MARK" != "$PROBE_MARK" ] || die "MEASURE_MARK должен отличаться от MARK и PROBE_MARK"

    set -- --health-file "$RUNTIME_DIR/d2kd.health"
    legacy_stats=${STATS_SEC:-900}
    spawn_daemon -S -b -m -p "$DP_PID" -x "$DPBIN" -- \
        --queue "$QUEUE_NUM" --mode "$dpmode" --mark "$MARK" \
        --probe-mark "$PROBE_MARK" --udp-reverse-hook \
        --flows "$FLOWS" --control "$SOCK" --stats "$legacy_stats" \
        "$@" --log "$LOG/d2kd.log" || die "датапат не запустился"

    # Ждём привязки очереди, а не спим наугад: правила, поставленные до
    # привязки, отправляют пакеты в никуда.
    i=0
    while [ $i -lt 50 ]; do
        bound=$(awk -v q="$QUEUE_NUM" '$1==q{print $2}' \
            /proc/net/netfilter/nfnetlink_queue 2>/dev/null)
        [ -n "$bound" ] && [ "$bound" != "0" ] && break
        i=$((i + 1))
        sleep 0.1 2>/dev/null || sleep 1
    done
    if [ -z "$bound" ] || [ "$bound" = "0" ]; then
        engine_stop
        die "очередь $QUEUE_NUM не привязалась — правила не ставлю"
    fi

    load_modules
    fw_up || { engine_stop; die "не поставить правила"; }

    # После правил, но до контроллера: к моменту первого приветствия таблица
    # соединений уже обязана вестись.
    fastnat_off

    # Журнал задаётся ключом, а не перенаправлением: start-stop-daemon -b
    # потоки потомка не наследует, и вывод уходил бы в никуда — проверено на
    # роутере, файл оставался нулевым при исправно работающем движке.
    set -- --health-file "$RUNTIME_DIR/d2kc.health"
    spawn_daemon -S -b -m -p "$CT_PID" -x "$BIN" -- \
        --control "$SOCK" --catalog "$DIR/state/catalog.json" --live "$LIVE" --mark "$PROBE_MARK" \
        --measure-mark "$MEASURE_MARK" \
        "$@" --log "$LOG/d2kc.log" || { engine_stop; die "контроллер не запустился"; }
    if ! running "$CT_PID"; then
        engine_stop
        die "контроллер завершился сразу после запуска"
    fi

    WATCHLOOP="while :; do
        \"$HEAL\" >/dev/null 2>&1
        sleep ${HEAL_EVERY:-60}
    done"
    # Сторож правил — отдельным процессом, и его отсутствие НЕ отменяет обход,
    # а только страховку. Период 60 с унаследован у z2k (её сторож живёт
    # вызовом планировщика раз в минуту); событийный хук NDM реагирует
    # быстрее, а этот ловит сбросы, на которые хук не сработал.
    if [ -x "$HEAL" ]; then
        spawn_daemon -S -b -m -p "$HL_PID" -x /bin/sh -- -c \
            "$WATCHLOOP" \
            || say "сторож правил не запустился — правила придётся возвращать вручную"
    fi

    say "движок запущен: очередь $QUEUE_NUM, режим $MODE"
}

start_panel() {
    # Панель — отдельный процесс и не принадлежит жизненному циклу datapath:
    # команды engine-stop/engine-start оставляют её доступной для управления.
    if [ -x "$PANELBIN" ]; then
        prepare_runtime
        start_log_maintenance
        set -- --health-file "$RUNTIME_DIR/d2kpanel.health"
        spawn_daemon -S -b -m -p "$PN_PID" -x "$PANELBIN" -- serve \
            --config "$CONF" --live "$LIVE" --assets "$PANEL_ASSETS" \
            --listen "$PANEL_LISTEN" --state-dir "$STATE_DIR" --mode "$MODE" \
            --queue "$QUEUE_NUM" --service /opt/etc/init.d/S99d2k \
            --engine-pid "$DP_PID" --controller-pid "$CT_PID" \
            "$@" --log "$LOG/panel.log" \
            || { say "панель не запустилась — обход это не затрагивает"; return 1; }
    fi
}

start() {
    start_engine || return $?
    telegram_start || say "Telegram tunnel не поднят; D2K продолжает работу независимо"
    start_panel
    if [ -x "$DNS_SCHEDULER" ] && ! running "$DNS_SCHED_PID"; then
        spawn_daemon -S -b -m -p "$DNS_SCHED_PID" -x "$DNS_SCHEDULER" -- run \
            || say "планировщик Instagram DNS не запустился — повторы вручную"
    fi
    if [ -x "$UPDATER" ] && ! running "$UPD_PID"; then
        spawn_daemon -S -b -m -p "$UPD_PID" -x "$UPDATER" -- run \
            || say "ночная проверка обновлений не запустилась — обновление кнопкой в панели"
    fi
}

stop_pidfile() {
    p=$1
    if running "$p"; then
        start-stop-daemon -K -q -p "$p" 2>/dev/null
        i=0
        while running "$p" && [ $i -lt 30 ]; do
            i=$((i + 1))
            sleep 0.1 2>/dev/null || sleep 1
        done
        if running "$p"; then
            start-stop-daemon -K -q -s KILL -p "$p" 2>/dev/null
        fi
    fi
    rm -f "$p"
}

write_telegram_status() {
    mkdir -p "$(dirname "$TG_STATUS")" || return 1
    tmp=$TG_STATUS.new.$$
    printf '%s\n' "$1" > "$tmp" || return 1
    chmod 0644 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$TG_STATUS"
}

telegram_start() {
    [ "${TG_ENABLED:-0}" = 1 ] || { write_telegram_status stopped; return 0; }
    [ -x "$TGBIN" ] || { say "Telegram включён, но нет $TGBIN"; write_telegram_status error; return 1; }
    "$TGBIN" --check-config "$CONF" >/dev/null 2>&1 || {
        say "Telegram включён, но адрес релея или способ регистрации не настроены корректно"
        write_telegram_status not_configured
        return 1
    }
    mkdir -p "$RUN" "$LOG" "$(dirname "$TG_STATUS")" || return 1
    prepare_runtime
    start_log_maintenance
    if running "$TG_PID"; then
        [ -x "$TG_FIREWALL" ] && "$TG_FIREWALL" heal || true
        return 0
    fi
    stop_pidfile "$TG_PID" || return 1
    set -- --health-file "$RUNTIME_DIR/d2ktg.health"
    spawn_daemon -S -b -m -p "$TG_PID" -x "$TGBIN" -- \
        --config "$CONF" "$@" --log "$LOG/telegram.log" || { write_telegram_status error; return 1; }
    i=0
    while [ $i -lt 20 ]; do
        running "$TG_PID" && break
        i=$((i + 1)); sleep 0.1 2>/dev/null || sleep 1
    done
    if ! running "$TG_PID"; then
        say "d2ktg завершился при запуске — см. $LOG/telegram.log"
        write_telegram_status error
        return 1
    fi
    if [ -x "$TG_FIREWALL" ]; then
        "$TG_FIREWALL" start || { stop_pidfile "$TG_PID"; write_telegram_status error; return 1; }
    else
        stop_pidfile "$TG_PID" || return 1; write_telegram_status error; say "нет правил Telegram firewall $TG_FIREWALL"; return 1
    fi
    if [ -x "$TG_WATCHDOG" ] && ! running "$TG_WD_PID"; then
        spawn_daemon -S -b -m -p "$TG_WD_PID" -x "$TG_WATCHDOG" \
            || say "Telegram health watchdog не запустился"
    fi
    say "Telegram TCP tunnel запущен на :$TG_PORT"
}

telegram_stop() {
    stop_pidfile "$TG_WD_PID" || return 1
    stop_pidfile "$TG_PID" || return 1
    [ -x "$TG_FIREWALL" ] && "$TG_FIREWALL" stop || true
    write_telegram_status stopped
    say "Telegram tunnel остановлен"
}

telegram_restart() {
    stop_pidfile "$TG_PID" || return 1
    [ -x "$TG_FIREWALL" ] && "$TG_FIREWALL" stop || true
    [ "${TG_ENABLED:-0}" = 1 ] || { write_telegram_status stopped; return 0; }
    telegram_start
}

telegram_reapply() {
    [ "${TG_ENABLED:-0}" = 1 ] || return 0
    running "$TG_PID" || return 0
    [ -x "$TG_FIREWALL" ] && "$TG_FIREWALL" heal
}

set_telegram_enabled() {
    value=$1
    [ -f "$CONF" ] || return 1
    tmp=$CONF.new.$$
    (umask 077; awk -v value="$value" '
        /^[[:space:]]*TG_ENABLED=/ { if (!done) print "TG_ENABLED=" value; done=1; next }
        { print }
        END { if (!done) print "TG_ENABLED=" value }
    ' "$CONF" > "$tmp") || { rm -f "$tmp"; return 1; }
    chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$CONF" || { rm -f "$tmp"; return 1; }
}

telegram_enable() {
    set_telegram_enabled 1 || die "не изменить TG_ENABLED"
    TG_ENABLED=1
    telegram_start
}

telegram_disable() {
    set_telegram_enabled 0 || die "не изменить TG_ENABLED"
    TG_ENABLED=0
    telegram_stop
}

engine_stop() {
    # Сторож гасится ДО снятия правил: иначе он может заметить снятые правила
    # и успеть восстановить их, пока служба останавливается.
    stop_pidfile "$HL_PID" || return 1
    fw_down
    legacy_http_stop
    fastnat_restore
    stop_pidfile "$CT_PID" || return 1
    stop_pidfile "$DP_PID" || return 1
    rst_rules_down dead
    rm -f "$SOCK"
    say "движок остановлен"
}

stop() {
    stop_pidfile "$DNS_SCHED_PID" || return 1
    stop_pidfile "$UPD_PID" || return 1
    telegram_stop || return 1
    engine_stop || return 1
    stop_pidfile "$PN_PID" || return 1
    stop_pidfile "$LM_PID" || return 1
    rst_rules_down all
    rm -f "$LIVE"
    say "служба остановлена"
}

status() {
    echo "$NAME"
    running "$DP_PID" && echo "  датапат: работает (pid $(cat $DP_PID))" \
                      || echo "  датапат: не работает"
    running "$CT_PID" && echo "  контроллер: работает (pid $(cat $CT_PID))" \
                      || echo "  контроллер: не работает"
    running "$PN_PID" && echo "  панель: работает (pid $(cat $PN_PID))" \
                      || echo "  панель: не работает"
    running "$TG_PID" && echo "  Telegram tunnel: работает (pid $(cat $TG_PID))" \
                       || echo "  Telegram tunnel: не работает (enabled=${TG_ENABLED:-0})"
    running "$DNS_SCHED_PID" && echo "  Instagram DNS: суточное обновление запланировано (pid $(cat $DNS_SCHED_PID))" \
                              || echo "  Instagram DNS: планировщик не работает"
    running "$UPD_PID" && echo "  автообновление: ночная проверка запланирована (pid $(cat "$UPD_PID"))" \
                       || echo "  автообновление: не запланировано"
    running "$HL_PID" && echo "  сторож правил: работает (pid $(cat $HL_PID))" \
                      || echo "  сторож правил: не работает"
    fw_installed && echo "  правила: стоят" || echo "  правила: отсутствуют или неполны"
    [ ! -f "$FW_V4ONLY" ] || echo "  IPv6: не обслуживается — нет ip6tables mangle, работа только по IPv4"
    if [ "$FW_BACKEND" = iptables ] && command -v d2k_ppe_status >/dev/null 2>&1; then
        d2k_ppe_status
    fi
    bound=$(awk -v q="$QUEUE_NUM" '$1==q{print $2}' \
        /proc/net/netfilter/nfnetlink_queue 2>/dev/null)
    if [ -n "$bound" ] && [ "$bound" != "0" ]; then
        echo "  очередь $QUEUE_NUM: привязана к $bound"
    else
        echo "  очередь $QUEUE_NUM: НЕ привязана"
    fi
    [ -x "$BIN" ] && "$BIN" version 2>/dev/null | sed 's/^/  /'
}

# NDM периодически сносит чужие правила. Сторож есть: событийный хук
# /opt/etc/ndm/netfilter.d/001-d2k.sh и периодическая страховка
# d2k-fw-heal.sh — оба зовут ЭТУ команду, а не повторяют её содержимое.
# Руками она тоже годится.
reapply() {
    running "$DP_PID" || die "датапат не работает — ставить правила не для кого"
    legacy_http_stop
    load_modules
    fw_up || { fw_down; die "не поставить полный набор правил"; }
    say "правила поставлены заново"
}

case "$1" in
    start)   start ;;
    heal) if running "$DP_PID"; then fw_installed || reapply; ppe_ensure; fi
          telegram_reapply ;;
    dns-tick) "$DNS_SCHEDULER" tick ;;
    dns-refresh) "$RELEASE/d2k-instagram-dns.sh" refresh ;;
    dns-remove) "$RELEASE/d2k-instagram-dns.sh" remove ;;
    log-tick) "$LOG_MAINTENANCE" tick ;;
    # Для панели. Установка — отдельной сессией: установщик останавливает и
    # эту службу, и того, кто его позвал.
    update-check) "$UPDATER" check ;;
    update-install) start-stop-daemon -S -b -x "$UPDATER" -- install manual ;;
    update-auto-on) "$UPDATER" auto on ;;
    update-auto-off) "$UPDATER" auto off ;;
    tg-heal) telegram_reapply ;;
    tg-stop-rules) "$TG_FIREWALL" stop ;;

    stop)    stop ;;
    restart) stop && start ;;
    engine-start) start_engine ;;
    engine-stop) engine_stop ;;
    engine-restart)
        [ "$MODE" != "off" ] || die "MODE=off — перезапуск невозможен"
        engine_stop && start_engine
        ;;
    telegram-enable) telegram_enable ;;
    telegram-disable) telegram_disable ;;
    telegram-restart) telegram_restart ;;
    telegram-reapply) telegram_reapply ;;
    status)  status ;;
    reapply) reapply ;;
    ppe-ensure) ppe_ensure ;;
    ppe-remove) d2k_ppe_remove ;;
    ppe-status)
        command -v d2k_ppe_status >/dev/null 2>&1 || die "нет $PPE_LIB"
        d2k_ppe_status "$2"
        ;;
    *) echo "использование: $0 {start|stop|restart|engine-start|engine-stop|engine-restart|status|reapply|ppe-ensure|ppe-status [адрес]}" >&2; exit 2 ;;
esac
