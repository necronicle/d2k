# УСКОРИТЕЛЬ NAT ВЫКЛЮЧАЕТСЯ НА ВРЕМЯ РАБОТЫ, и это не «оптимизация наоборот».
#
# При nf_conntrack_fastnat=1 транзитные потоки ведёт ускоритель, МИМО
# conntrack: записи о потоке в таблице нет вовсе. А датапату она нужна не для
# счёта, а чтобы узнать, каким адресом поток виден серверу: очередь висит на
# mangle POSTROUTING, где у транзитного пакета ещё локальный адрес клиента, и
# посылки плана, собранные с ним, уходят в никуда (см. d2k_nat.h).
#
# Замерено на живом роутере 13.09.2026: с включённым ускорителем обход
# работал ТОЛЬКО для трафика самого роутера, а любое устройство за ним
# получало ноль — при том, что собственный зонд на той же цели отвечал 200.
#
# Прежнее значение запоминается и возвращается при остановке: чужую настройку
# менять навсегда мы не вправе.
FASTNAT=/proc/sys/net/netfilter/nf_conntrack_fastnat
FASTNAT_SAVED=$RUN/fastnat.saved

fastnat_off() {
    [ -w "$FASTNAT" ] || return 0
    cat "$FASTNAT" > "$FASTNAT_SAVED" 2>/dev/null
    echo 0 > "$FASTNAT" 2>/dev/null
    [ "$(cat "$FASTNAT" 2>/dev/null)" = "0" ] || \
        say "не удалось выключить ускоритель NAT — обхода за роутером не будет"
}

fastnat_restore() {
    [ -w "$FASTNAT" ] || return 0
    [ -f "$FASTNAT_SAVED" ] || return 0
    cat "$FASTNAT_SAVED" > "$FASTNAT" 2>/dev/null
    rm -f "$FASTNAT_SAVED"
}

# ТОЛЬКО ДЛЯ ПОЛИТИКИ KEENETIC (задача 59). KEENETIC_POLICY в конфигурации —
# имя политики доступа так, как его видно в веб-интерфейсе (описание), или
# внутреннее имя (Policy0). Метку политики называет ndmc; датапат получает её
# ключом --only-mark и обслуживает только устройства с этой меткой, прочие и
# трафик самого роутера идут ядром. Политики нет — «none»: устройств D2K не
# трогает и говорит об этом, а не обрабатывает молча всех.
# OpenWrt PBR assigns one mark/mask to each routing table. Different LuCI
# rules targeting the same table are deliberately one choice in the panel.
# A native firewall MARK rule can group clients even on routers without PBR.
# Use the mark as identity: several rules may deliberately mark the same group.
openwrt_mark_number() {
    local word
    case "$1" in
        0x*) word=${1#0x}; case "$word" in ''|*[!a-fA-F0-9]*) return 1 ;; esac
             [ "${#word}" -le 8 ] || return 1 ;;
        0|[1-9]*) case "$1" in *[!0-9]*) return 1 ;; esac
             [ "${#1}" -le 10 ] && [ "$1" -le 4294967295 ] || return 1 ;;
        *) return 1 ;;
    esac
    printf '%x' "$1"
}
openwrt_firewall_policy() {
    local section="$1" target value mask enabled mark
    config_get_bool enabled "$section" enabled 1
    [ "$enabled" = 1 ] || return 0
    config_get target "$section" target
    [ "$target" = MARK ] || [ "$target" = mark ] || return 0
    config_get value "$section" set_mark
    [ -n "$value" ] || config_get value "$section" set_xmark
    case "$value" in */*) mask=${value#*/}; value=${value%%/*} ;; *) mask=0xffffffff ;; esac
    mark=$(openwrt_mark_number "$value") && mask=$(openwrt_mark_number "$mask") || return 0
    [ "$mark" != 0 ] && [ "$mask" != 0 ] && [ "$((0x$mark & 0x$mask))" = "$((0x$mark))" ] || return 0
    printf 'mark.%s.%s\t0x%s/0x%s\t%s/0x%s\n' "$mark" "$mask" "$mark" "$mask" "$mark" "$mask"
}
openwrt_policies() (
    # Some minimal OpenWrt installations only provide firewall MARK rules.
    v4=$(ip -4 rule show 2>/dev/null) || v4=
    v6=
    if [ -e /proc/net/if_inet6 ]; then v6=$(ip -6 rule show 2>/dev/null) || v6=; fi
    printf '%s\n%s\n' "$v4" "$v6" | awk '
        function hex(s) {
            return s ~ /^0x[[:xdigit:]]+$/ && length(s)<=10
        }
        # Include only rules selected solely by a nonzero firewall mark.
        NF==7 && $2=="from" && $3=="all" && $4=="fwmark" && ($6=="lookup" || $6=="table") {
            table=$7
            if (table !~ /^[A-Za-z0-9_.-]+$/ || length(table)>56 ||
                table ~ /^(main|default|local|253|254|255)$/) next
            n=split(tolower($5),part,"/")
            mask=n==1 ? "0xffffffff" : part[2]
            if (n>2 || !hex(part[1]) || !hex(mask) ||
                part[1] ~ /^0x0+$/ || mask ~ /^0x0+$/) next
            selector=substr(part[1],3) "/" mask
            if (!(table in seen)) { order[++count]=table; seen[table]=selector }
            else if (seen[table]!=selector) ambiguous[table]=1
            if ((selector in owner) && owner[selector]!=table) {
                ambiguous[owner[selector]]=1; ambiguous[table]=1
            }
            owner[selector]=table
        }
        END { for (i=1;i<=count;i++) {
            t=order[i]; if (!ambiguous[t]) print "route." t "\t" t "\t" seen[t]
        } }'
    # shellcheck disable=SC1091
    . /lib/functions.sh
    config_load firewall || exit 1
    config_foreach openwrt_firewall_policy rule | sort -u
)

openwrt_selector() {
    openwrt_policies | awk -F '\t' -v id="$1" '$1==id {print $3}'
}
policy_mark() {
    if [ -f "$OPENWRT_RELEASE" ]; then
        selector=$(openwrt_selector "$1")
        printf '%s\n' "${selector%%/*}"
        return
    fi
    command -v ndmc >/dev/null 2>&1 || return 0
    policy_list=$(ndmc -c "show ip policy" 2>/dev/null) || return 0
    printf '%s\n' "$policy_list" | tr -d '\033' | awk -v want="$1" '
        /policy, name = / {
            line = $0; sub(/.*policy, name = /, "", line)
            name = line; sub(/,.*/, "", name)
            # Без описания строка кончается двоеточием: «name = D2Ktest: »
            # (поле 14.10.2026).
            sub(/:[[:space:]]*$/, "", name); sub(/[[:space:]]+$/, "", name)
            desc = ""
            if (line ~ /description = /) {
                desc = line; sub(/.*description = /, "", desc)
                sub(/:[[:space:]]*$/, "", desc); sub(/[[:space:]]+$/, "", desc)
            }
            exact = (name == want); bydesc = (desc == want)
            next
        }
        /^[[:space:]]*mark:/ {
            if (exact) { id_count++; id_mark=$2 }
            if (bydesc) { desc_count++; desc_mark=$2 }
            exact=0; bydesc=0
        }
        END {
            if (id_count == 1) print id_mark
            else if (id_count == 0 && desc_count == 1) print desc_mark
        }'
}
policy_args() {
    [ -n "${KEENETIC_POLICY:-}" ] || return 0
    if [ -f "$OPENWRT_RELEASE" ]; then
        selector=$(openwrt_selector "$KEENETIC_POLICY")
        if [ -n "$selector" ]; then
            printf '%s\n' "--only-mark 0x$selector"
        else
            echo "--only-mark none"
        fi
        return
    fi
    pm=$(policy_mark "$KEENETIC_POLICY")
    case "$pm" in
        ''|*[!0-9a-fA-F]*)
            echo "d2k: ВНИМАНИЕ: политика Keenetic «${KEENETIC_POLICY}» не найдена (ndmc show ip policy) — устройства не обрабатываются; проверьте KEENETIC_POLICY в $CONF" >&2
            echo "--only-mark none" ;;
        *)
            echo "d2k: только политика Keenetic «${KEENETIC_POLICY}» (метка 0x$pm); остальные устройства идут как без D2K" >&2
            echo "--only-mark 0x$pm/0xffffffff" ;;
    esac
}

# УСКОРЕНИЕ ПОТОКОВ fw4 (OpenWrt) — тот же случай, что ускоритель NAT выше.
# С flow_offloading поток после рукопожатия уходит в flowtable мимо всех
# цепочек: лаборатория 07.10.2026 (25.12.5, клиент LAN, HTTPS) — в очередь 4-5
# пакетов вместо 17-18, ClientHello D2K не видел. Выключается на время работы
# (вместе с ним и аппаратное: flow_offloading_hw без него не действует),
# прежнее значение запоминается и возвращается при остановке.
flowoffload_saved() { echo "$RUN/flow-offloading.saved"; }
flowoffload_off() {
    [ "$FW_BACKEND" = nft ] || return 0
    command -v uci >/dev/null 2>&1 || return 0
    [ "$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)" = 1 ] || return 0
    mkdir -p "$RUN" || return 0
    # Сохранённое не перезаписывается: после сбоя без остановки там значение
    # владельца, а сейчас в настройке уже наше 0.
    [ -f "$(flowoffload_saved)" ] || echo 1 > "$(flowoffload_saved)"
    if uci set firewall.@defaults[0].flow_offloading=0 && uci commit firewall; then
        fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1
        say "ускорение потоков fw4 (flow offloading) выключено на время работы: с ним D2K не видит потоков клиентов; при остановке вернётся"
    else
        say "не выключить flow offloading fw4 — потоки клиентов D2K видеть не будет"
    fi
}

flowoffload_restore() {
    [ -f "$(flowoffload_saved)" ] || return 0
    command -v uci >/dev/null 2>&1 || return 0
    if [ "$(cat "$(flowoffload_saved)" 2>/dev/null)" = 1 ] &&
       uci set firewall.@defaults[0].flow_offloading=1 && uci commit firewall; then
        fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1
    fi
    rm -f "$(flowoffload_saved)"
}

prepare_runtime() {
    [ ! -L "$RUNTIME_DIR" ] || die "runtime directory must not be a symlink"
    if ! (umask 077; mkdir -p "$RUNTIME_DIR") || ! chmod 0700 "$RUNTIME_DIR"; then
        die "не создать приватный $RUNTIME_DIR"
    fi
}

spawn_daemon() (
    exec 3>&- 4>&- 5>&-
    exec start-stop-daemon "$@"
)

start_log_maintenance() {
    mkdir -p "$RUN" "$LOG" || return 1
    if [ -x "$LOG_MAINTENANCE" ] && ! running "$LM_PID"; then
        spawn_daemon -S -b -m -p "$LM_PID" -x "$LOG_MAINTENANCE" -- run \
            || say "ротация журналов не запустилась"
    fi
}

# МОДУЛИ ЯДРА. На Keenetic модули Netfilter лежат в прошивке файлами
# /lib/modules/<ядро>/*.ko, но сами не загружаются: modprobe из Entware ищет
# в /opt/lib/modules, которого там нет (опыт z2k, lib/utils.sh). Поле
# 03.10.2026, Keenetic mipsel: xt_addrtype/xt_comment не загружены — служба не
# стартовала. Загружаем сами; отсутствие модуля — не отказ здесь: правило,
# которому он нужен, либо имеет запасной путь, либо назовёт себя при отказе.
MODULES_DIR=${D2K_MODULES_DIR:-/lib/modules}
# nf_conntrack_netlink: счётчики потока по кортежу для детектора тишины QUIC
# (d2kd); без него детектор выключен, остальное работает.
SYS_MODULE_DIR=${D2K_SYS_MODULE_DIR:-/sys/module}
D2K_MODULES="nfnetlink_queue xt_NFQUEUE xt_conntrack xt_connbytes xt_multiport xt_mark xt_connmark xt_CONNMARK xt_addrtype xt_comment ip6table_mangle nf_conntrack_netlink"
# nft сам подгружает модули выражений; очередь и ctnetlink — отдельные модули.
[ "$FW_BACKEND" != nft ] || D2K_MODULES="nfnetlink_queue nft_queue nf_conntrack_netlink"
module_present() {
    case "$1" in
        xt_NFQUEUE|xt_CONNMARK)
            grep -qw "${1#xt_}" "$PROC_DIR/net/ip_tables_targets" 2>/dev/null && return 0 ;;
        nfnetlink_queue) [ -e "$PROC_DIR/net/netfilter/nfnetlink_queue" ] && return 0 ;;
        ip6table_mangle) grep -qw mangle "$PROC_DIR/net/ip6_tables_names" 2>/dev/null && return 0 ;;
        xt_*) grep -qw "${1#xt_}" "$PROC_DIR/net/ip_tables_matches" 2>/dev/null && return 0 ;;
    esac
    # Встроенный в ядро модуль в lsmod не виден, но есть в /sys/module.
    [ -d "$SYS_MODULE_DIR/$1" ] && return 0
    lsmod 2>/dev/null | grep -q "^$1 "
}
load_modules() {
    kver=$(uname -r 2>/dev/null)
    for m in $D2K_MODULES; do
        module_present "$m" && continue
        modprobe "$m" 2>/dev/null && module_present "$m" && continue
        ko=
        for d in "$MODULES_DIR/$kver" "$MODULES_DIR"; do
            [ -f "$d/$m.ko" ] && { ko="$d/$m.ko"; break; }
        done
        [ -n "$ko" ] || ko=$(find "$MODULES_DIR" -name "$m.ko" -type f 2>/dev/null | head -1)
        if [ -n "$ko" ] && insmod "$ko" 2>/dev/null; then
            say "загружен модуль ядра $m"
        fi
    done
}

start_engine() {
    preflight_validate || return 1
    if [ "${preflight_policy_conflict:-0}" = 1 ]; then
        say "предварительная проба отключена: метка политики Keenetic пересекается со служебными битами"
    fi
    watch_validate || return 1
    [ "$MODE" = "off" ] && { say "MODE=off — запуск запрещён"; return 1; }
    [ -x "$DPBIN" ] || die "нет $DPBIN"
    [ -x "$BIN" ] || die "нет $BIN"

    mkdir -p "$RUN" "$LOG" "$DIR/state" || die "не создать $RUN"
    prepare_runtime
    start_log_maintenance

    if running "$DP_PID"; then
        if running "$CT_PID" && watch_contract_matches && fw_installed && \
            ! legacy_http_present && \
            { [ ! -x "$HEAL" ] || running "$HL_PID"; }; then
            shadow_reconcile
            say "движок уже запущен полностью"
            return 0
        fi
        say "обнаружен частичный запуск — восстанавливаю весь движок"
        engine_stop || return 1
    else
        # Контроллер может пережить упавший datapath и продолжать писать
        # ложное live-состояние. Перед чистым запуском убираем весь остаток.
        engine_stop || return 1
    fi

    # Файл сокета переживает SIGKILL и мешает следующему запуску.
    rm -f "$SOCK"

    [ "$PROBE_MARK" != "$MARK" ] || die "PROBE_MARK должен отличаться от MARK"
    if ! { [ "$MEASURE_MARK" != "$MARK" ] && [ "$MEASURE_MARK" != "$PROBE_MARK" ]; }; then die "MEASURE_MARK должен отличаться от MARK и PROBE_MARK"; fi

    if [ "${TCP_WATCH:-0}" = 1 ]; then
        : > "$RUN/tcp-watch-active" || return 1
    else
        rm -f "$RUN/tcp-watch-active"
    fi
    if [ "${D2K_PREFLIGHT:-0}" = 1 ]; then
        : > "$RUN/preflight-active" || return 1
    else
        rm -f "$RUN/preflight-active"
    fi
    load_modules
    D2K_PREFLIGHT_V6=0
    if preflight_ipv6_available; then
        D2K_PREFLIGHT_V6=1
        : > "$RUN/preflight-v6-active" || return 1
    fi
    spawn_datapath
    case $? in
        0) ;;
        1) die_with_log "датапат не запустился" "$LOG/d2kd.log" ;;
        *) engine_stop; die "очередь $QUEUE_NUM не привязалась — правила не ставлю" ;;
    esac

    fw_up || { engine_stop; die "не поставить правила"; }
    rm -f "$RUN/fw-ipv4-rebuilding"
    rmdir "$RUNTIME_DIR/d2kd.health.fw4" 2>/dev/null || :
    rm -f "$FW_V6_REBUILDING"
    rmdir "$RUNTIME_DIR/d2kd.health.fw6" 2>/dev/null || :
    sha256sum < "$CONF" > "$RUN/fw-config.sha256" || rm -f "$RUN/fw-config.sha256"

    # После правил, но до контроллера: к моменту первого приветствия таблица
    # соединений уже обязана вестись.
    fastnat_off
    flowoffload_off

    spawn_controller
    case $? in
        0) ;;
        1) engine_stop; die_with_log "контроллер не запустился" "$LOG/d2kc.log" ;;
        *) engine_stop; die_with_log "контроллер завершился сразу после запуска" "$LOG/d2kc.log" ;;
    esac

    shadow_reconcile

    WATCHLOOP="elapsed=${HEAL_EVERY:-60}
    while :; do
        if [ \$elapsed -ge ${HEAL_EVERY:-60} ]; then
            D2K_HEAL_SOURCE=watchdog \"$HEAL\" >/dev/null 2>&1
            elapsed=0
        elif [ \"$FW_BACKEND\" = iptables ] && [ -r \"$RUN/dns-routes\" ] &&
             ! cmp -s \"$RUN/dns-routes\" \"$RUN/dns-routes.reconciled\"; then
            \"$0\" dns-ensure >/dev/null 2>&1
        fi
        sleep 2
        elapsed=\$((elapsed + 2))
    done"
    # Сторож правил — отдельным процессом, и его отсутствие НЕ отменяет обход,
    # а только страховку. Период 60 с унаследован у z2k (её сторож живёт
    # вызовом планировщика раз в минуту); событийный хук NDM реагирует
    # быстрее, а этот ловит сбросы, на которые хук не сработал.
    if [ -x "$HEAL" ]; then
        rm -f "$HL_PID.start"
        if spawn_daemon -S -b -m -p "$HL_PID" -x /bin/sh -- -c "$WATCHLOOP"; then
            pid_stamp "$HL_PID" || say "отметка сторожа не записалась — его номер проверяется по командной строке"
        else
            say "сторож правил не запустился — правила придётся возвращать вручную"
        fi
    fi

    : > "$ENGINE_WANT" || say "метка автовосстановления не записалась — упавший демон сам не поднимется"
    say "движок запущен: очередь $QUEUE_NUM, режим $MODE"
}

# Датапат с теми же ключами, что при полном запуске, и ожидание привязки
# очереди. 0 — работает, 1 — не запустился, 2 — очередь не привязалась.
spawn_datapath() {
    dpmode=observe
    [ "$MODE" = "apply" ] && dpmode=apply
    set -- --health-file "$RUNTIME_DIR/d2kd.health" --dns-family-file "$STATE_DIR/ipv4-fallback"
    [ "${D2K_PREFLIGHT:-0}" != 1 ] || set -- "$@" --preflight --provider-ips "$STATE_DIR/provider-ips"
    [ "${D2K_PREFLIGHT_V6:-0}" != 1 ] || set -- "$@" --preflight-ipv6
    [ "${TCP_WATCH:-0}" != 1 ] || set -- "$@" --watch-release-bit 0x20000000
    [ "${LATE_WATCH:-0}" != 1 ] || set -- "$@" --late-watch-mark 0x40000000 --late-rules
    # shellcheck disable=SC2046  # ключ и значение — два слова нарочно
    set -- "$@" $(policy_args)
    [ "${EXP_CONTROL:-0}" != 1 ] || set -- "$@" --exp-control "$EXP_SOCK"
    legacy_stats=${STATS_SEC:-900}
    rm -f "$DP_PID.start"
    spawn_daemon -S -b -m -p "$DP_PID" -x "$DPBIN" -- \
        --queue "$QUEUE_NUM" --mode "$dpmode" --mark "$MARK" \
        --probe-mark "$PROBE_MARK" --udp-reverse-hook \
        --flows "$FLOWS" --control "$SOCK" --stats "$legacy_stats" \
        "$@" --log "$LOG/d2kd.log" || return 1

    # Ждём привязки очереди, а не спим наугад: правила, поставленные до
    # привязки, отправляют пакеты в никуда.
    i=0
    while :; do
        bound=$(awk -v q="$QUEUE_NUM" '$1==q{print $2}' \
            /proc/net/netfilter/nfnetlink_queue 2>/dev/null)
        if [ -n "$bound" ] && [ "$bound" != "0" ]; then
            pid_stamp "$DP_PID"
            return 0
        fi
        [ "$i" -lt 50 ] || break
        wait_tenth
        i=$((i + D2K_WAIT_TICKS))
    done
    return 2
}

# Контроллер. 0 — работает, 1 — не запустился, 2 — завершился сразу.
# Журнал задаётся ключом, а не перенаправлением: start-stop-daemon -b
# потоки потомка не наследует, и вывод уходил бы в никуда — проверено на
# роутере, файл оставался нулевым при исправно работающем движке.
spawn_controller() {
    # Controller, datapath and firewall share the same response-probe switch.
    export D2K_PREFLIGHT D2K_PREFLIGHT_V6
    rm -f "$CT_PID.start"
    if [ "${NEWCHAIN:-0}" = 1 ] && { [ "${SHADOW:-0}" != 1 ] || [ "${EXP_CONTROL:-0}" != 1 ]; }; then
        svc_log "контроллер не запущен: NEWCHAIN=1 требует SHADOW=1 и EXP_CONTROL=1"
        return 1
    fi
    if [ "${SYNTHESIS_ONLY:-0}" = 1 ] && { [ "${SHADOW:-0}" != 1 ] || [ "${NEWCHAIN:-0}" != 1 ]; }; then
        svc_log "контроллер не запущен: SYNTHESIS_ONLY=1 требует SHADOW=1 и NEWCHAIN=1"
        return 1
    fi
    set --
    if [ "${SYNTHESIS_ONLY:-0}" = 1 ]; then
        set -- --synthesis-only
    elif [ "${SYNTHESIS_HTTPS:-0}" = 1 ]; then
        set -- --synthesis-https
    fi
    if [ "${SHADOW:-0}" = 1 ] && [ "${EXP_CONTROL:-0}" = 1 ]; then
        set -- "$@" --shadow-queue "$RUNTIME_DIR/shadow.queue"
    fi
    if [ "${NEWCHAIN:-0}" = 1 ]; then
        set -- "$@" --newchain-store "$DIR/state/shadow.d2km"
    fi
    spawn_daemon -S -b -m -p "$CT_PID" -x "$BIN" -- \
        --control "$SOCK" --catalog "$DIR/state/catalog.json" --live "$LIVE" --mark "$PROBE_MARK" \
        --measure-mark "$MEASURE_MARK" --doh-targets "$STATE_DIR/doh-targets" --force-targets "$STATE_DIR/force-targets" \
        --dns-upstreams "$RUN/dns-upstreams" --dns-addresses "$RUN/dns-excl" --dns-routes "$RUN/dns-routes" \
        --health-file "$RUNTIME_DIR/d2kc.health" --log "$LOG/d2kc.log" "$@" || return 1
    wait_running "$CT_PID" d2kc || return 2
    pid_stamp "$CT_PID"
}

# Новая цепочка владеет только своим сокетом опытов, каталогом и журналом.
# Отказ тени не останавливает рабочий движок. Тот же сторож зовёт recover.
spawn_shadow() {
    [ -x "$SHADOWBIN" ] || { svc_log "тень не запущена: нет $SHADOWBIN"; return 1; }
    [ -r "$DIR/files/modern.hex" ] || { svc_log "тень не запущена: нет формы $DIR/files/modern.hex"; return 1; }
    prepare_runtime || return 1
    rm -f "$SH_PID.start"
    spawn_daemon -S -b -m -p "$SH_PID" -x "$SHADOWBIN" -- \
        --queue "$RUNTIME_DIR/shadow.queue" --form "$DIR/files/modern.hex" --legacy-form "$DIR/files/legacy.hex" \
        --store "$DIR/state/shadow.d2km" \
        --journal "$LOG/shadow-why.jsonl" --log "$LOG/shadow.log" \
        --exp-control "$EXP_SOCK" --daemon-log "$LOG/shadow-daemon.log" || return 1
    wait_running "$SH_PID" d2kshadow || return 1
    pid_stamp "$SH_PID"
}

shadow_reconcile() {
    SHADOW_QUEUE=$RUNTIME_DIR/shadow.queue
    if [ "${SHADOW:-0}" != 1 ]; then
        running "$SH_PID" && stop_pidfile "$SH_PID"
        return 0
    fi
    if [ "${EXP_CONTROL:-0}" != 1 ]; then
        running "$SH_PID" && stop_pidfile "$SH_PID"
        svc_log "тень не запущена: SHADOW=1 требует EXP_CONTROL=1"
        return 0
    fi
    running "$SH_PID" || spawn_shadow || svc_log "тень не запустилась — сторож повторит запуск"
    return 0
}

svc_log() {
    mkdir -p "$LOG" 2>/dev/null
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$*" >> "$SERVICE_LOG" 2>/dev/null
    say "$*"
}

# Capture evidence before recover/stop can remove or replace the PID files.
# Kernel ring timestamps are retained; an old line is never an inferred cause.
engine_evidence() (
    dp_pid=none; ct_pid=none
    if [ -r "$DP_PID" ]; then read -r dp_pid < "$DP_PID" || :; fi
    if [ -r "$CT_PID" ]; then read -r ct_pid < "$CT_PID" || :; fi
    svc_log "engine-event=$1 action=$ENGINE_ACTION service_pid=$$ dp_pid=$dp_pid ct_pid=$ct_pid" >/dev/null
    {
        awk '/^(MemAvailable|SwapFree):/' "$PROC_DIR/meminfo"
        for p in "$dp_pid" "$ct_pid"; do
            case "$p" in ''|*[!0-9]*) continue ;; esac
            if [ -r "$PROC_DIR/$p/status" ]; then
                awk -v p="$p" '/^(Name|State|VmRSS|VmSwap):/ {print "pid=" p, $0}' "$PROC_DIR/$p/status"
            fi
        done
        dmesg 2>/dev/null | awk -v dp="$dp_pid" -v ct="$ct_pid" '
            index($0, "process " dp " (d2kd)") || index($0, "process " ct " (d2kc)") ||
            index($0, "d2kd[" dp "]") || index($0, "d2kc[" ct "]")' | tail -4
    } 2>/dev/null >> "$SERVICE_LOG"
    exit 0
)

# Read after the event. Include only lifecycle diagnostics, even if the daemon
# logs also contain browsing targets. Bound reads on small routers.
stop_report() {
    for report in "$SERVICE_LOG" "$LOG/d2kd.log" "$LOG/d2kc.log"; do
        [ -r "$report" ] || continue
        printf '%s\n' "--- ${report##*/} ---"
        tail -c 65536 "$report" | awk '
            /engine-event=|engine-signal=|engine-exit |fw-check tool=|^preflight-list |^MemAvailable:|^SwapFree:|^pid=[0-9]+ |Killed process [0-9]+ \(d2k[cd]\)|^.*d2k[cd]\[[0-9]+\].*(fault|segfault)/ {
                gsub(/ -[sd] [^ ]+/, " [address]")
                print
            }' | tail -40
    done
}

# Штатная остановка снимает намерение и счёт попыток: после неё движок
# своей волей не поднимается — ни сторожем, ни хуком NDM.
engine_unwant() {
    rm -f "$ENGINE_WANT" "$RECOVER_STATE"
}

# Пауза между попытками: первая сразу, дальше RECOVER_BASE_S, удваиваясь до
# RECOVER_MAX_S. 0 — пробовать можно (попытка записана), 1 — рано.
recover_backoff_ok() {
    now=$(date +%s)
    n=0; last=0
    [ ! -r "$RECOVER_STATE" ] || read -r n last < "$RECOVER_STATE"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    delay=0
    if [ "$n" -gt 0 ]; then
        delay=$RECOVER_BASE_S; k=1
        while [ "$k" -lt "$n" ] && [ "$delay" -lt "$RECOVER_MAX_S" ]; do
            delay=$((delay * 2)); k=$((k + 1))
        done
        [ "$delay" -le "$RECOVER_MAX_S" ] || delay=$RECOVER_MAX_S
    fi
    [ $((now - last)) -ge "$delay" ] || return 1
    printf '%s %s\n' $((n + 1)) "$now" > "$RECOVER_STATE"
}

recover_settle() {
    [ -r "$RECOVER_STATE" ] || return 0
    read -r n last < "$RECOVER_STATE"
    case "$last" in ''|*[!0-9]*) rm -f "$RECOVER_STATE"; return 0 ;; esac
    [ $(($(date +%s) - last)) -lt "$RECOVER_RESET_S" ] || rm -f "$RECOVER_STATE"
}

# ВОССТАНОВЛЕНИЕ ДВИЖКА. Только если движок запущен штатно и штатно не
# остановлен (ENGINE_WANT) и MODE не off. Целые правила не трогаются: упавший
# контроллер поднимается один (датапат принимает новое подключение и сам
# снял пробы прежнего — ctlsrv.c, d2k_ctlsrv_peer_closed), упавший датапат —
# вместе с контроллером (тот вышел по обрыву связи). Цепочки D2K, ручные
# исключения в них, исключения DNS и каталог остаются как были; очередь с
# --queue-bypass всё это время пропускала трафик без обхода. Неполные правила
# или режим TCP_WATCH — прежний полный перезапуск движка.
recover() {
    [ -f "$ENGINE_WANT" ] || return 0
    [ "$MODE" != "off" ] || return 0
    dp=нет; ct=нет
    running "$DP_PID" && dp=да
    running "$CT_PID" && ct=да
    if [ "$dp" = да ] && [ "$ct" = да ]; then
        recover_settle
        shadow_reconcile
        return 0
    fi
    recover_backoff_ok || return 0
    engine_evidence "missing:dp=$dp,ct=$ct"
    if [ ! -f "$RUN/tcp-watch-active" ] && [ ! -f "$RUN/preflight-active" ] && watch_contract_matches && fw_installed; then
        if [ "$dp" = нет ]; then
            svc_log "датапат не работает (контроллер работает: $ct) — восстанавливаю датапат и контроллер; правила, исключения и каталог не трогаю"
            stop_pidfile "$SH_PID"
            stop_pidfile "$CT_PID"
            rst_rules_down dead
            rm -f "$SOCK"
            spawn_datapath || { svc_log "датапат не поднялся (код $?) — следующая попытка после паузы"; return 1; }
        else
            svc_log "контроллер не работает при живом датапате — восстанавливаю только контроллер; правила, исключения и каталог не трогаю"
            rst_rules_down dead
        fi
        spawn_controller || { svc_log "контроллер не поднялся (код $?) — следующая попытка после паузы"; return 1; }
        shadow_reconcile
        svc_log "движок восстановлен: датапат pid $(cat "$DP_PID"), контроллер pid $(cat "$CT_PID")"
        return 0
    fi
    svc_log "движок неполон (датапат: $dp, контроллер: $ct, правила неполны или TCP_WATCH) — восстанавливаю полным перезапуском движка"
    start_engine
}

start_panel() {
    # Панель — отдельный процесс и не принадлежит жизненному циклу datapath:
    # команды engine-stop/engine-start оставляют её доступной для управления.
    if [ -x "$PANELBIN" ]; then
        prepare_runtime
        start_log_maintenance
        set -- --health-file "$RUNTIME_DIR/d2kpanel.health"
        spawn_daemon -S -b -m -p "$PN_PID" -x "$PANELBIN" -- serve \
            --config "$CONF" --live "$LIVE" --assets "$PANEL_ASSETS" \
            --listen "$PANEL_LISTEN" --state-dir "$STATE_DIR" --mode "$MODE" \
            --queue "$QUEUE_NUM" --service /opt/etc/init.d/S99d2k \
            --engine-pid "$DP_PID" --controller-pid "$CT_PID" \
            "$@" --log "$LOG/panel.log" \
            || { say "панель не запустилась — обход это не затрагивает"; return 1; }
    fi
}

start() {
    start_engine || return $?
    telegram_start || say "Telegram tunnel не поднят; D2K продолжает работу независимо"
    start_panel
    if [ -x "$DNS_SCHEDULER" ] && ! running "$DNS_SCHED_PID"; then
        spawn_daemon -S -b -m -p "$DNS_SCHED_PID" -x "$DNS_SCHEDULER" -- run \
            || say "планировщик Instagram DNS не запустился — повторы вручную"
    fi
    if [ -x "$UPDATER" ] && ! running "$UPD_PID"; then
        spawn_daemon -S -b -m -p "$UPD_PID" -x "$UPDATER" -- run \
            || say "ночная проверка обновлений не запустилась — обновление кнопкой в панели"
    fi
}

stop_pidfile() {
    p=$1
    # Гасится только проверенный номер (running сверяет, чей он), а не
    # «номер из файла»: тот мог достаться чужому процессу.
    if running "$p"; then
        sp=$(cat "$p" 2>/dev/null)
        if [ "$p" = "$DP_PID" ] || [ "$p" = "$CT_PID" ]; then
            svc_log "engine-signal=TERM action=$ENGINE_ACTION service_pid=$$ target_pid=$sp" >/dev/null || :
        fi
        kill "$sp" 2>/dev/null
        # d2kd: up to 2.5s post-NAT drain, one 2s filter-removal ACK and
        # a 2s late-worker stop. Ten seconds leaves bounded cleanup headroom;
        # other services retain their existing three-second grace.
        stop_ticks_max=30
        [ "$p" != "$DP_PID" ] || stop_ticks_max=100
        # Shadow may be inside one bounded arm (plan ACK + TLS + receipt).
        # Allow that arm to retire its own probe and save the result.
        [ "$p" != "${SH_PID:-}" ] || stop_ticks_max=300
        i=0
        while running "$p" && [ $i -lt "$stop_ticks_max" ]; do
            wait_tenth
            i=$((i + D2K_WAIT_TICKS))
        done
        if running "$p"; then
            if [ "$p" = "$DP_PID" ] || [ "$p" = "$CT_PID" ]; then
                svc_log "engine-signal=KILL action=$ENGINE_ACTION service_pid=$$ target_pid=$sp" >/dev/null || :
            fi
            kill -9 "$sp" 2>/dev/null
        fi
    fi
    rm -f "$p" "$p.start"
}

write_telegram_status() {
    mkdir -p "$(dirname "$TG_STATUS")" || return 1
    tmp=$TG_STATUS.new.$$
    printf '%s\n' "$1" > "$tmp" || return 1
    chmod 0644 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$TG_STATUS"
}

telegram_start() {
    [ "${TG_ENABLED:-0}" = 1 ] || { write_telegram_status stopped; return 0; }
    [ -x "$TGBIN" ] || { say "Telegram включён, но нет $TGBIN"; write_telegram_status error; return 1; }
    "$TGBIN" --check-config "$CONF" >/dev/null 2>&1 || {
        say "Telegram включён, но адрес релея или способ регистрации не настроены корректно"
        write_telegram_status not_configured
        return 1
    }
    mkdir -p "$RUN" "$LOG" "$(dirname "$TG_STATUS")" || return 1
    prepare_runtime
    start_log_maintenance
    if running "$TG_PID"; then
        if [ -x "$TG_FIREWALL" ]; then "$TG_FIREWALL" heal || true; fi
        return 0
    fi
    stop_pidfile "$TG_PID" || return 1
    set -- --health-file "$RUNTIME_DIR/d2ktg.health"
    spawn_daemon -S -b -m -p "$TG_PID" -x "$TGBIN" -- \
        --config "$CONF" "$@" --log "$LOG/telegram.log" || { write_telegram_status error; return 1; }
    i=0
    while [ $i -lt 20 ]; do
        running "$TG_PID" && break
        wait_tenth
        i=$((i + D2K_WAIT_TICKS))
    done
    if ! running "$TG_PID"; then
        say "d2ktg завершился при запуске — см. $LOG/telegram.log"
        write_telegram_status error
        return 1
    fi
    if [ -x "$TG_FIREWALL" ]; then
        "$TG_FIREWALL" start || { stop_pidfile "$TG_PID"; write_telegram_status error; return 1; }
    else
        stop_pidfile "$TG_PID" || return 1; write_telegram_status error; say "нет правил Telegram firewall $TG_FIREWALL"; return 1
    fi
    if [ -x "$TG_WATCHDOG" ] && ! running "$TG_WD_PID"; then
        spawn_daemon -S -b -m -p "$TG_WD_PID" -x "$TG_WATCHDOG" \
            || say "Telegram health watchdog не запустился"
    fi
    say "Telegram TCP tunnel запущен на :$TG_PORT"
}

telegram_stop() {
    stop_pidfile "$TG_WD_PID" || return 1
    stop_pidfile "$TG_PID" || return 1
    if [ -x "$TG_FIREWALL" ]; then "$TG_FIREWALL" stop || true; fi
    write_telegram_status stopped
    say "Telegram tunnel остановлен"
}

telegram_restart() {
    stop_pidfile "$TG_PID" || return 1
    if [ -x "$TG_FIREWALL" ]; then "$TG_FIREWALL" stop || true; fi
    [ "${TG_ENABLED:-0}" = 1 ] || { write_telegram_status stopped; return 0; }
    telegram_start
}

telegram_reapply() {
    [ "${TG_ENABLED:-0}" = 1 ] || return 0
    running "$TG_PID" || return 0
    [ -x "$TG_FIREWALL" ] && "$TG_FIREWALL" heal
}

set_telegram_enabled() {
    value=$1
    [ -f "$CONF" ] || return 1
    tmp=$CONF.new.$$
    (umask 077; awk -v value="$value" '
        /^[[:space:]]*TG_ENABLED=/ { if (!done) print "TG_ENABLED=" value; done=1; next }
        { print }
        END { if (!done) print "TG_ENABLED=" value }
    ' "$CONF" > "$tmp") || { rm -f "$tmp"; return 1; }
    chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$CONF" || { rm -f "$tmp"; return 1; }
}

telegram_enable() {
    set_telegram_enabled 1 || die "не изменить TG_ENABLED"
    TG_ENABLED=1
    telegram_start
}

telegram_disable() {
    set_telegram_enabled 0 || die "не изменить TG_ENABLED"
    TG_ENABLED=0
    telegram_stop
}

engine_stop() {
    # Сторож гасится ДО снятия правил: иначе он может заметить снятые правила
    # и успеть восстановить их, пока служба останавливается.
    stop_pidfile "$HL_PID" || return 1
    stop_pidfile "$SH_PID" || return 1
    # Keep release rules present until no process can emit NF_REPEAT.
    if [ -f "$RUN/tcp-watch-active" ] || [ -f "$RUN/preflight-active" ]; then
        stop_pidfile "$CT_PID" || return 1
        stop_pidfile "$DP_PID" || return 1
    fi
    local stop_fw_rc=0
    fw_down || stop_fw_rc=1
    rm -f "$RUN/tcp-watch-active" "$RUN/preflight-active" "$RUN/preflight-v6-active"
    legacy_http_stop
    fastnat_restore
    flowoffload_restore
    stop_pidfile "$CT_PID" || return 1
    stop_pidfile "$DP_PID" || return 1
    late_chains_down
    rst_rules_down dead
    rm -f "$SOCK"
    if [ "$stop_fw_rc" = 0 ]; then say "движок остановлен"
    else say "движок остановлен, но очистка собственных правил не завершена"; fi
    return "$stop_fw_rc"
}

stop() {
    engine_unwant
    stop_pidfile "$DNS_SCHED_PID" || return 1
    stop_pidfile "$UPD_PID" || return 1
    telegram_stop || return 1
    engine_stop || return 1
    stop_pidfile "$PN_PID" || return 1
    stop_pidfile "$LM_PID" || return 1
    rst_rules_down all
    rm -f "$LIVE"
    say "служба остановлена"
}

status() {
    echo "$NAME"
    running "$DP_PID" && echo "  датапат: работает (pid $(cat "$DP_PID"))" \
                      || echo "  датапат: не работает"
    if [ "${SHADOW:-0}" = 1 ]; then
        running "$SH_PID" && echo "  тень: работает (pid $(cat "$SH_PID"))" || echo "  тень: не работает"
    fi
    running "$CT_PID" && echo "  контроллер: работает (pid $(cat "$CT_PID"))" \
                      || echo "  контроллер: не работает"
    running "$PN_PID" && echo "  панель: работает (pid $(cat "$PN_PID"))" \
                      || echo "  панель: не работает"
    running "$TG_PID" && echo "  Telegram tunnel: работает (pid $(cat "$TG_PID"))" \
                       || echo "  Telegram tunnel: не работает (enabled=${TG_ENABLED:-0})"
    running "$DNS_SCHED_PID" && echo "  Instagram DNS: суточное обновление запланировано (pid $(cat "$DNS_SCHED_PID"))" \
                              || echo "  Instagram DNS: планировщик не работает"
    running "$UPD_PID" && echo "  автообновление: ночная проверка запланирована (pid $(cat "$UPD_PID"))" \
                       || echo "  автообновление: не запланировано"
    running "$HL_PID" && echo "  сторож правил: работает (pid $(cat "$HL_PID"))" \
                      || echo "  сторож правил: не работает"
    fw_installed && echo "  правила: стоят" || echo "  правила: отсутствуют или неполны"
    if [ -s "$USER_RULES" ]; then
        echo "  исключения владельца в цепочках D2K: $(wc -l < "$USER_RULES" | tr -d ' ') (сохраняются при пересборке правил: $USER_RULES)"
    fi
    watch_auto_resolve
    if [ "${LATE_WATCH:-0}" = 1 ] && ! ls "$RUN"/late-watch-off.* >/dev/null 2>&1; then
        echo "  поздняя доставка опыта: включена"
    else
        echo "  поздняя доставка опыта: выключена${LATE_WATCH_WHY:+ ($LATE_WATCH_WHY)} — опыт на продолжении клиента только в окне очереди"
    fi
    if [ -f "$ENGINE_WANT" ]; then
        echo "  автовосстановление: включено — упавший демон поднимет сторож"
    else
        echo "  автовосстановление: выключено — движок штатно остановлен или не запускался"
    fi
    if [ -n "${KEENETIC_POLICY:-}" ]; then
        pm=$(policy_mark "$KEENETIC_POLICY")
        if [ -n "$pm" ]; then echo "  политика: «${KEENETIC_POLICY}» (метка 0x$pm) — остальные устройства идут как без D2K"
        else echo "  политика: «${KEENETIC_POLICY}» НЕ НАЙДЕНА — устройства не обрабатываются"; fi
    fi
    [ ! -f "$FW_V4ONLY" ] || echo "  IPv6: не обслуживается — нет ip6tables mangle, работа только по IPv4"
    if [ "$FW_BACKEND" = iptables ] && command -v d2k_ppe_status >/dev/null 2>&1; then
        d2k_ppe_status
    fi
    bound=$(awk -v q="$QUEUE_NUM" '$1==q{print $2}' \
        /proc/net/netfilter/nfnetlink_queue 2>/dev/null)
    if [ -n "$bound" ] && [ "$bound" != "0" ]; then
        echo "  очередь $QUEUE_NUM: привязана к $bound"
    else
        echo "  очередь $QUEUE_NUM: НЕ привязана"
    fi
    [ -x "$BIN" ] && "$BIN" version 2>/dev/null | sed 's/^/  /'
}

# NDM can replace either or both mangle tables. Rebuild only absent families.
# Install each family's three hooks in one transaction after private chains,
# DNS exclusions and the owner's rules are ready.
fw_recover_mangle() (
    [ "$FW_BACKEND" = iptables ] && running "$CT_PID" && watch_contract_matches || exit 1
    active=0; [ ! -f "$RUN/preflight-active" ] || active=1
    [ "${D2K_PREFLIGHT:-0}" = "$active" ] || exit 1
    fw_config=$(sha256sum < "$CONF") && [ "$fw_config" = "$(cat "$RUN/fw-config.sha256" 2>/dev/null)" ] || exit 1
    D2K_PREFLIGHT_V6=0
    if preflight_ipv6_available; then D2K_PREFLIGHT_V6=1; fi
    if [ -f "$RUN/preflight-v6-active" ]; then [ "$D2K_PREFLIGHT_V6" = 1 ] || exit 1
    else [ "$D2K_PREFLIGHT_V6" = 0 ] || exit 1; fi
    fw_lock_acquire || exit 1
    trap 'fw_lock_release' EXIT
    rules4=$(iptables -t mangle -S) || exit 1
    need4=0
    printf '%s\n' "$rules4" | grep -Eq '^-N D2K_| -j D2K_' || need4=1
    need6=0
    if [ ! -f "$FW_V4ONLY" ]; then
        rules6=$(ip6tables -t mangle -S) || exit 1
        printf '%s\n' "$rules6" | grep -Eq '^-N D2K_| -j D2K_' || need6=1
    fi
    [ "$need4" = 1 ] || [ "$need6" = 1 ] || exit 1
    if [ "$need4" = 1 ]; then command -v iptables-restore >/dev/null 2>&1 || exit 1
    else fw_family_installed iptables || exit 1; fi
    if [ "$need6" = 1 ]; then command -v ip6tables-restore >/dev/null 2>&1 || exit 1
    else [ -f "$FW_V4ONLY" ] || fw_family_installed ip6tables || exit 1; fi
    if [ "$need4" = 1 ]; then
        : > "$RUN/fw-ipv4-rebuilding" || exit 1
        fw_family_up iptables detached || exit 1
    fi
    if [ "$need6" = 1 ]; then
        : > "$FW_V6_REBUILDING" || exit 1
        fw_family_up ip6tables detached || exit 1
    fi
    dns_excl_sync_unlocked fresh || exit 1
    [ "$need4" != 1 ] || user_rules_restore iptables || exit 1
    [ "$need6" != 1 ] || user_rules_restore ip6tables || exit 1
    # The live daemon owns temporary per-tuple rules. It acknowledges each
    # repaired family after replaying those rules; an older binary falls back.
    for family in 4 6; do
        [ "$family" != 4 ] || [ "$need4" = 1 ] || continue
        [ "$family" != 6 ] || [ "$need6" = 1 ] || continue
        repair="$RUNTIME_DIR/d2kd.health.fw$family"
        mkdir "$repair" || exit 1
        retry=0
        while [ -d "$repair" ] && [ "$retry" -lt 5 ]; do
            retry=$((retry+1))
            sleep 1
        done
        [ ! -d "$repair" ] && running "$DP_PID" && running "$CT_PID" || exit 1
    done
    if [ "$need4" = 1 ]; then
        printf '%s\n' '*mangle' "-I POSTROUTING 1 -j $CHAIN_OUT" "-I FORWARD 1 -j $CHAIN_IN" "-I INPUT 1 -j $CHAIN_IN" COMMIT |
            iptables-restore --noflush || exit 1
        iptables -t mangle -I INPUT -p udp --dport 53 ! -s 127.0.0.0/8 \
            -j "$CHAIN_DNS_FAMILY" || exit 1
        iptables -t mangle -I OUTPUT -p udp --sport 53 ! -d 127.0.0.0/8 \
            -j "$CHAIN_DNS_FAMILY" || exit 1
    fi
    if [ "$need6" = 1 ]; then
        printf '%s\n' '*mangle' "-I POSTROUTING 1 -j $CHAIN_OUT" "-I FORWARD 1 -j $CHAIN_IN" "-I INPUT 1 -j $CHAIN_IN" COMMIT |
            ip6tables-restore --noflush || exit 1
        ip6tables -t mangle -I INPUT -p udp --dport 53 ! -s ::1/128 \
            -j "$CHAIN_DNS_FAMILY" || exit 1
        ip6tables -t mangle -I OUTPUT -p udp --sport 53 ! -d ::1/128 \
            -j "$CHAIN_DNS_FAMILY" || exit 1
    fi
    dns_family_sync_unlocked || exit 1
    ppe_up
    fw_installed || exit 1
    rm -f "$RUN/fw-ipv4-rebuilding"
    rm -f "$FW_V6_REBUILDING"
)
# The TCP preflight and raw UDP MASQUERADE rules are IPv4 only. NDM may
# rewrite nat independently of mangle. Keep the two rules in installation
# order and leave rules owned by the router in their existing order.
fw_repair_ipv4_nat() (
    for proto in tcp udp; do
        mark=$MARK; other=$PF_MARK; peer=tcp
        if [ "$proto" = tcp ]; then mark=$PF_MARK; other=$MARK; peer=udp; fi
        set -- -p "$proto" -m mark --mark "$mark" -j MASQUERADE
        if iptables -t nat -C POSTROUTING "$@" 2>/dev/null; then continue
        else rc=$?; fi
        [ "$rc" = 1 ] || exit 1
        listed=$(iptables -t nat -S POSTROUTING) || exit 1
        # Count only -A entries (-S may print the policy first). Detect a
        # rule that reappeared between -C and -S instead of adding a copy.
        pos=$(printf '%s\n' "$listed" | awk -v proto="$proto" -v peer="$peer" \
            -v mark="$(printf '0x%x' "$mark")" -v other="$(printf '0x%x' "$other")" '
            $1=="-A" && $2=="POSTROUTING" {
                n++
                if (NF!=10 || $3!="-p" || $5!="-m" || $6!="mark" || $7!="--mark" ||
                    $9!="-j" || $10!="MASQUERADE") next
                sub(/\/0xffffffff$/, "", $8)
                if ($4==proto && $8==mark) found=1
                if ($4==peer && $8==other && !anchor) anchor=n
            }
            END { if (found) print "present"; else if (anchor) print anchor+(proto=="udp"); else print "append" }')
        case "$pos" in
            present) ;;
            append) iptables -t nat -A POSTROUTING "$@" || exit 1 ;;
            *) iptables -t nat -I POSTROUTING "$pos" "$@" || exit 1 ;;
        esac
        iptables -t nat -C POSTROUTING "$@" || exit 1
    done
    exit 0
)
# Restore partial preflight queue and IPv4 NAT loss with both daemons live.
fw_recover_partial() (
    [ "$FW_BACKEND" = iptables ] && [ "${D2K_PREFLIGHT:-0}" = 1 ] &&
        running "$DP_PID" && running "$CT_PID" && watch_contract_matches || exit 1
    [ -f "$RUN/preflight-active" ] || exit 1
    fw_config=$(sha256sum < "$CONF") && [ "$fw_config" = "$(cat "$RUN/fw-config.sha256" 2>/dev/null)" ] || exit 1
    D2K_PREFLIGHT_V6=0
    if preflight_ipv6_available; then D2K_PREFLIGHT_V6=1; fi
    if [ -f "$RUN/preflight-v6-active" ]; then [ "$D2K_PREFLIGHT_V6" = 1 ] || exit 1
    else [ "$D2K_PREFLIGHT_V6" = 0 ] || exit 1; fi
    fw_lock_acquire || exit 1
    trap 'fw_lock_release' EXIT
    D2K_SKIP_PREFLIGHT_QUEUE_CHECK=1
    fw_family_installed iptables mangle-only || exit 1
    [ -f "$FW_V4ONLY" ] || fw_family_installed ip6tables || exit 1
    D2K_SKIP_PREFLIGHT_QUEUE_CHECK=0
    set -- iptables
    [ "$D2K_PREFLIGHT_V6" != 1 ] || set -- "$@" ip6tables
    for fw_tool in "$@"; do
        for chain in "$CHAIN_OUT" "$CHAIN_IN"; do
            direction=ORIGINAL; [ "$chain" != "$CHAIN_IN" ] || direction=REPLY
            if ! "$fw_tool" -t mangle -C "$chain" -p tcp -m conntrack --ctdir "$direction" \
                -m connmark --mark "$PF_CONN_BIT/$PF_CONN_BIT" -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass 2>/dev/null; then
                rules=$("$fw_tool" -t mangle -S "$chain") || exit 1
                pos=$(printf '%s\n' "$rules" | awk -v chain="$chain" -v queue="$QUEUE_NUM" '
                    $1 == "-A" && $2 == chain {
                        n++
                        if (index($0, "-m conntrack") && index($0, "-j NFQUEUE") &&
                            index($0, "--queue-num " queue) && !index($0, " -m comment ")) {
                            print n; exit
                        }
                    }')
                [ -n "$pos" ] || exit 1
                "$fw_tool" -t mangle -I "$chain" "$pos" -p tcp -m conntrack --ctdir "$direction" \
                    -m connmark --mark "$PF_CONN_BIT/$PF_CONN_BIT" -j NFQUEUE --queue-num "$QUEUE_NUM" --queue-bypass || exit 1
            fi
        done
    done
    # At this point every other required rule has been checked or repaired.
    # If NDM still owns/rebuilds nat, the next hook/watchdog can retry.
    fw_repair_ipv4_nat || exit 2
    if fw_installed; then exit 0; fi
    # NDM may rewrite nat again during the final two-family verification.
    preflight_nat_rule iptables -C && iptables -t nat -C POSTROUTING -p udp \
        -m mark --mark "$MARK" -j MASQUERADE || exit 2
    exit 1
)
# NDM периодически сносит чужие правила. Сторож есть: событийный хук
# /opt/etc/ndm/netfilter.d/001-d2k.sh и периодическая страховка
# d2k-fw-heal.sh — оба зовут ЭТУ команду, а не повторяют её содержимое.
# Руками она тоже годится.
reapply() {
    preflight_validate || return 1
    watch_validate || return 1
    # Мёртвый движок здесь не поднимается: после штатной остановки это было
    # бы воскрешением, а упавший демон поднимает recover по намерению.
    running "$DP_PID" || die "датапат не работает — ставить правила не для кого"
    # The earlier watchdog status was taken outside the service lock.
    if [ "${1:-}" = auto ]; then
        if FW_DIAG=1 fw_installed; then return 0; fi
        if fw_recover_mangle; then
            svc_log "после сброса IPv4/IPv6 mangle правила восстановлены без перезапуска движка"
            return 0
        fi
        if fw_recover_partial; then
            svc_log "правила preflight и NAT восстановлены без перезапуска движка"
            return 0
        elif [ "$?" = 2 ]; then
            svc_log "восстановление IPv4 NAT отложено до следующей проверки, движок работает"
            return 1
        fi
    fi
    if [ "${TCP_WATCH:-0}" = 1 ] || [ -f "$RUN/tcp-watch-active" ] ||
       [ "${D2K_PREFLIGHT:-0}" = 1 ] || [ -f "$RUN/preflight-active" ]; then
        engine_evidence "restart:firewall"
        svc_log "перезапуск движка для восстановления правил"
        engine_stop && start_engine || return $?
        if [ "${1:-}" = auto ]; then svc_log "правила восстановлены сторожем"; fi
        return 0
    fi
    legacy_http_stop
    load_modules
    fw_up || { fw_down; die "не поставить полный набор правил"; }
    if [ "${1:-}" = auto ]; then svc_log "правила восстановлены сторожем"
    else say "правила поставлены заново"; fi
}

# ОЧИСТИТЬ ПОДОБРАННОЕ. Необратимо: это всё, что движок нашёл замером —
# подтверждённые планы, привязки имён к адресам, каталог коробок. Подбор
# после этого начинается с нуля.
#
# Движок обязательно останавливается, и это не перестраховка: каталог ведёт
# контроллер в памяти и пишет его на диск при сохранении, так что удаление
# файла под работающим контроллером вернуло бы каталог обратно через минуту.
# Поднимается он назад только если работал ДО очистки: своей волей служба
# движок не запускает.
#
# Файлы перечислены теми же именами, что и в снимках бандлов развёртывания
# (before.tar): http-plans.txt и https-cache.txt существуют не всегда.
clear_found() {
    was_running=no
    if running "$DP_PID" || running "$CT_PID"; then
        was_running=yes
        engine_stop || die "движок не остановился — подобранное не тронуто"
    fi
    removed=0
    for f in catalog.json http-plans.txt https-cache.txt; do
        if [ -e "$STATE_DIR/$f" ]; then rm -f "$STATE_DIR/$f" && removed=$((removed+1)); fi
    done
    if [ -d "$STATE_DIR/measurements" ]; then
        rm -rf "$STATE_DIR/measurements" && removed=$((removed+1))
    fi
    say "подобранное очищено: снято $removed файлов состояния"
    if [ "$was_running" = yes ]; then
        start_engine || die "подобранное очищено, но движок не поднялся"
    fi
}

case "$1" in
    openwrt-policies) openwrt_policies ;;
    start)   locked; start ;;
    recover) engine_lock 0 || exit 0; recover ;;
    heal) locked; if running "$DP_PID"; then fw_installed || reapply; ppe_ensure; dns_family_sync; fi
          telegram_reapply ;;
    dns-tick) "$DNS_SCHEDULER" tick ;;
    dns-refresh) "$RELEASE/d2k-instagram-dns.sh" refresh ;;
    dns-remove) "$RELEASE/d2k-instagram-dns.sh" remove ;;
    log-tick) "$LOG_MAINTENANCE" tick ;;
    # Для панели. Установка — отдельной сессией: установщик останавливает и
    # эту службу, и того, кто его позвал.
    update-check) "$UPDATER" check ;;
    update-install) start-stop-daemon -S -b -x "$UPDATER" -- install manual ;;
    update-auto-on) "$UPDATER" auto on ;;
    update-auto-off) "$UPDATER" auto off ;;
    tg-heal) telegram_reapply ;;
    tg-stop-rules) "$TG_FIREWALL" stop ;;

    stop)    locked; stop ;;
    restart) locked; stop && start ;;
    engine-start) locked; start_engine ;;
    engine-stop) locked; engine_unwant; engine_stop ;;
    engine-restart)
        [ "$MODE" != "off" ] || die "MODE=off — перезапуск невозможен"
        locked
        svc_log "получена команда engine-restart"
        engine_stop && start_engine
        ;;
    telegram-enable) telegram_enable ;;
    telegram-disable) telegram_disable ;;
    telegram-restart) telegram_restart ;;
    telegram-reapply) telegram_reapply ;;
    status)  status ;;
    stop-report) stop_report ;;
    reapply) locked; reapply "${2:-}" ;;
    clear-found) locked; clear_found ;;
    ppe-ensure) ppe_ensure ;;
    dns-ensure) if running "$DP_PID" && fw_installed; then dns_excl_sync; fi ;;
    dns-family-sync) if running "$DP_PID"; then dns_family_sync; fi ;;
    ppe-remove) d2k_ppe_remove ;;
    ppe-status)
        command -v d2k_ppe_status >/dev/null 2>&1 || die "нет $PPE_LIB"
