#!/bin/sh /etc/rc.common
# D2K-owned OpenWrt boot bridge v1
# Host storage only: this entry must be readable before /opt is mounted.
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

extra_command boot_wait 'Wait for /opt (USB, Entware) and boot D2K'
extra_command detach 'Cancel the boot waiter without stopping D2K'

start_service() {
    procd_open_instance boot
    procd_set_param command /bin/sh /etc/rc.common /etc/init.d/d2k boot_wait
    # No respawn: D2K already owns daemon supervision.
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

boot_wait() {
    # procd's musl preload breaks Entware/glibc; its rc.common lock must not
    # stay held by this waiter or be inherited by the long-lived daemons.
    unset LD_PRELOAD
    # OpenWrt ash supports rc.common's high-numbered fd (not POSIX sh).
    # shellcheck disable=SC3023
    exec 1000>&-
    # procd waits in a separate process, so a late USB/extroot mount does not
    # hold OpenWrt's boot sequence. stop/detach cancels this process.
    while [ ! -x /opt/etc/init.d/S99d2k ] || [ ! -r /opt/d2k/config ]; do
        sleep 1
    done
    export PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
    /opt/etc/init.d/S99d2k start
}

detach() {
    procd_kill d2k 2>/dev/null
}

stop_service() {
    # rc.common calls stop_service BEFORE procd_kill: cancel the waiter first
    # so it cannot start D2K after the stop below. Keep the service object for
    # rc.common's final deletion, avoiding a second delete/ubus "Not found".
    procd_kill d2k boot 2>/dev/null
    [ ! -x /opt/etc/init.d/S99d2k ] || /opt/etc/init.d/S99d2k stop
}

status_service() {
    # The one-shot waiter exits after boot; the actual status belongs to D2K.
    [ -x /opt/etc/init.d/S99d2k ] || return 1
    /opt/etc/init.d/S99d2k status
}
